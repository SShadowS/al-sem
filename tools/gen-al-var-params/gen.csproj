<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>gen-al-var-params</AssemblyName>
    <!-- The AL compiler folder (alc's tools/net10.0/any); override with -p:AlcDir=... -->
    <AlcDir Condition="'$(AlcDir)' == ''">/opt/al-tool/.store/microsoft.dynamics.businesscentral.development.tools/18.0.41.62505/microsoft.dynamics.businesscentral.development.tools/18.0.41.62505/tools/net10.0/any</AlcDir>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="Microsoft.Dynamics.Nav.CodeAnalysis">
      <HintPath>$(AlcDir)/Microsoft.Dynamics.Nav.CodeAnalysis.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>
</Project>
