#!/usr/bin/env bash
# scripts/git-hooks/pre-commit — block a commit that touches detectors, fixtures,
# substrate, or goldens unless every byte-compared golden family still matches.
#
# Enabled repo-wide via `git config core.hooksPath scripts/git-hooks` (see
# CLAUDE.md "Goldens"). Fires ONLY when a staged path can move a golden, so
# ordinary commits are untouched. Bypass in a genuine emergency with
# `git commit --no-verify` (do not make a habit of it — a stale golden shipping
# green is exactly what this prevents).
#
# ⟨task-1 fix wave FIX 5⟩ Gate widened from `src/engine/l5/detectors/` to all of
# `src/engine/l4/` + `src/engine/l5/` — every detector reads substrate from both
# (`cone_derived.rs`, `capability_cone.rs`, `detector_context.rs`,
# `full_summary.rs`, …), and the l3-substrate/C1 arcs kept changing exactly those
# files while goldens stayed green only because someone happened to run
# `check-goldens` by hand.
#
# ⟨task-3 fix wave, review I-3(3)⟩ That was still far too narrow, and task 3 proved
# it: its substrate change (`src/engine/ids.rs`, `src/engine/l2/`, `src/engine/l3/`,
# `src/engine/deps/`) matched NONE of the filter, and neither did any of the four
# golden dirs it actually moved (`r1a`, `r2a`, `r3a3`, `cli-c-policy`) — the old
# golden clause named only 4 of the repo's 27 golden directories. The hook fired
# purely by luck, on two doc-comment-only edits that happened to land under
# `src/engine/l5/`. A substrate-only version of the same commit would have sailed
# through. So the filter became:
#   - ALL of `src/engine/` (the id encoders, L2 projection, L3 workspace, dep
#     ingestion and L4/L5 all feed goldens; drawing a line inside `src/engine/` is
#     what failed twice already), plus
#   - `crates/al-syntax/src/` — the CST→IR lowerer is upstream of every consumer,
#     and CLAUDE.md already says a lowerer change is validated by the differential
#     goldens, plus
#   - every `tests/*goldens*/` directory, `tests/goldens/`,
#     `tests/l4-summary-baseline/`, every `tests/*-vectors/` directory, and the
#     fixture roots.
#
# ⟨final-branch-review-l3.md I-1⟩ Still not enough: the line was drawn one level
# up, at `src/engine/`, and that repeated the SAME "line inside src/ is what failed
# twice already" mistake a third time — `src/bin/alsem.rs`/`aldump.rs`/
# `mint-goldens.rs` and `src/program/` (`resolve/semantic_golden.rs`, `l3_mint.rs`)
# are provably golden-determining and were both unwatched. Every `cli-*`, `gate-*`
# and `*-smoke-goldens` family spawns `CARGO_BIN_EXE_alsem`/`CARGO_BIN_EXE_aldump`
# (`tests/cli/cli_query_differential.rs` — going through `main` is the point: "the
# subcommand, its flags, its format validation, its exit-code plumbing"), and
# `tests/goldens/semantic-edges/` — the family the task-3 fix wave was proud of
# finding — is minted by `src/program/`. So the filter now covers ALL of `src/`,
# not just `src/engine/`: any file that can reach a golden-producing binary or
# library path, engine or not, is in scope.
#
# THE HONEST COST: this now fires `scripts/check-goldens` — nine test targets
# covering all 30 golden directories, not the old five covering 17 — on essentially
# every source commit (`src/`, not just `src/engine/`). Measured on the dev machine
# with a warm `target/` (nothing to recompile): 22s wall, 726 tests. A cold or
# source-invalidated cache pays the debug rebuild on top, which is the real cost
# most of the time (`check-goldens` unsets `CDO_WS`, so the CDO-gated members
# always skip here — `scripts/cdo-gate` runs them). That is the intended trade; a stale golden
# shipping green is strictly worse than a slower commit. If a commit genuinely
# cannot move a golden and you need the seconds back, `--no-verify` is there, but
# you own the consequence.
set -uo pipefail

repo_root="$(git rev-parse --show-toplevel)"

# ── Formatting, first and cheapest ───────────────────────────────────────────
# CI's FIRST step is `cargo fmt --check`; when it fails, CI stops there and
# NOTHING else runs — clippy, gen-syntax, tests, build and perf_bounds are all
# skipped. That state persisted for two days across five merges on 2026-07-31..
# 08-02. The `.claude/` PostToolUse rustfmt hook covers Edit/Write, but a
# scripted (Bash) edit — this repo's documented `scripted-edit` workflow — is
# invisible to it. The commit is the chokepoint every path shares.
#
# ⟨final-review.md I-2, I-3⟩ This step is deliberately NOT fail-fast: a fmt
# failure records `fmt_rc` and the hook keeps going into the golden gate
# below, exiting non-zero at the end if either failed. An early `exit 1` here
# would reproduce, one layer down, the exact defect this hook exists to catch
# — step 1 failing and hiding steps 2-N (see `scripts/ci-steps`'s `all` and
# `scripts/check-goldens`'s `--no-fail-fast`, both of which report every
# failure in one pass for the same reason). Measured cost of running both
# instead of stopping at the first: ~1.7s (`cargo fmt --check`) against
# `check-goldens`'s ~22s warm — negligible next to reporting only one of two
# real problems per commit attempt.
#
# Delegates to `scripts/ci-steps fmt` rather than inlining `cargo fmt --check`
# directly — that script is the one place CI's command strings are allowed to
# live; inlining the string here would make this hook a second, driftable copy.
#
# Read-only (`--check`), so this does not violate the "never `cargo fmt`" law.
#
# ⟨final-rereview.md N-2⟩ `repo_root` resolves inside the COMMITTING worktree,
# while the hook body itself is the MAIN checkout's copy (`core.hooksPath` is
# absolute — see CLAUDE.md Prerequisites). A worktree on a branch that predates
# `scripts/ci-steps` has no such file there, and calling it unconditionally
# would fail with a generic "not found" shell error blamed on `cargo fmt`
# instead of on the real cause. Check for it explicitly first so the diagnosis
# is honest; still fails CLOSED either way (a commit this hook cannot verify is
# not a commit it lets through).
fmt_rc=0
if git diff --cached --name-only | grep -qE '\.rs$'; then
    if [ ! -x "$repo_root/scripts/ci-steps" ]; then
        echo "pre-commit: $repo_root/scripts/ci-steps not found (or not executable) —" >&2
        echo "  this worktree's branch may predate it. Rebase onto a branch that has it," >&2
        echo "  or verify formatting manually: rustfmt <each touched file> (never bare" >&2
        echo "  'cargo fmt' — CLAUDE.md). Blocking the commit either way." >&2
        fmt_rc=1
    elif ! "$repo_root/scripts/ci-steps" fmt; then
        echo "pre-commit: cargo fmt --check FAILED (CI's first step) — fix with:" >&2
        echo "  rustfmt <each touched file>     # never bare 'cargo fmt' (CLAUDE.md)" >&2
        fmt_rc=1
    fi
fi

# Paths whose change can move a golden family.
golden_paths='^(src/|crates/al-syntax/src/|tests/r0-corpus/|tests/fixtures/|tests/[a-z0-9._-]*goldens/|tests/l4-summary-baseline/|tests/[a-z0-9._-]*-vectors/)'

if ! git diff --cached --name-only | grep -qE "$golden_paths"; then
    exit "$fmt_rc"
fi

# Coverage first, and it is cheap (a directory listing). A golden family that no
# target runs is invisible to the verification below — the gate passes while never
# looking at it, which is exactly how 15-of-27 coverage survived two arcs.
if ! "$repo_root/scripts/check-goldens" --verify-coverage; then
    echo "pre-commit: golden COVERAGE check failed (see above) — fix scripts/check-goldens" >&2
    exit 1
fi

# ⟨2026-10-04, test tiers⟩ Skip the re-run when the tree being committed is
# EXACTLY a tree that `scripts/ci-steps test` (run by `ci-steps task`/`all`) just
# passed: that run is the whole suite, which already contains every target
# `check-goldens` drives, with `REGEN_TEMP_GOLDENS` unset. The stamp is the
# tracked working tree at that run (see `scripts/tree-stamp`); `git write-tree`
# here is the tree this commit records. Any difference — partial staging, an
# edit after the run, a newly added file — and the goldens run as before. The
# fmt step above and the coverage check never skip.
stamp_file="$(git rev-parse --git-path gate-stamp)"
if [ -f "$stamp_file" ] && [ "$(cat "$stamp_file")" = "$(git write-tree)" ]; then
    echo "pre-commit: this exact tree passed 'scripts/ci-steps test' — goldens already verified"
    exit "$fmt_rc"
fi

echo "pre-commit: engine/fixture/golden change staged — verifying goldens..."
if ! "$repo_root/scripts/check-goldens"; then
    echo "pre-commit: golden verification FAILED. Regenerate + inspect:" >&2
    echo "  scripts/check-goldens --regen   # then review the diff and re-stage" >&2
    exit 1
fi
echo "pre-commit: goldens OK"

exit "$fmt_rc"
