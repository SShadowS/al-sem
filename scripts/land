#!/usr/bin/env bash
# scripts/land — build a landing branch from one or more lane branches, gate it,
# and (only with --push) land it on master through scripts/merge-and-push.
#
# ⟨TLS-59⟩ One command for the chain the orchestrator typed by hand 31 times
# (once it ran on into cdo-gate after ci-steps had failed). Steps, each with a
# one-line verdict; the first failure stops the run:
#   check     takes the CDO slot (scripts/cdo-slot, waiting for it; held to
#             the end, so one landing at a time and no lane builds or tests
#             under it); the worktree is clean (untracked `.agent/` aside) with no
#             merge in progress; local master is not behind origin/master (as of
#             the last fetch: no fetch here, merge-and-push fetches and checks
#             again); every branch exists, is not master, is not yet in master
#             and is given once; with --push, the main checkout is clean. Prints
#             master's sha and the merge order. ⟨TLS-87⟩ Each branch that
#             changes product code (or the CDO subset's own tests) has a
#             pre-submit CDO record for its head tree (`cdo-gate --only
#             harness,l4,output`): a loud warning without one (said again if a
#             step fails), a refusal under LAND_REQUIRE_PRESUBMIT=1.
#   merge     in the gate worktree, on a DETACHED master: each branch in the
#             order given, `merge --no-ff -m "landing: <ID>"`. A conflict in
#             CHANGELOG.md alone is resolved by keeping both sides' added lines
#             (master's first, a blank line between an entry and a heading that
#             meet), but only when every conflict there is additions on both
#             sides; any other conflict aborts and stops. Only when every merge
#             is in does it create `landing/<name>` (`-2`, `-3`, ... when
#             taken), so a refused or interrupted merge leaves nothing behind
#             (the worktree is then on a clean, detached master).
#   ci        `bash scripts/ci-steps all` (stops here on a failure: cdo-gate
#             never runs after a red ci).
#   mem-wait  MemAvailable >= 35 GB (polls 15 s, gives up after 30 min); no
#             other gate can run meanwhile, since land holds the CDO slot.
#   cdo       `bash scripts/cdo-gate <CDO_WS>`; with `--no-speed=<reason>`,
#             `bash scripts/cdo-gate --no-speed <CDO_WS>` (⟨TLS-113⟩ an
#             owner-approved skip of the speed phase only: the reason is
#             required, printed, written at the top of cdo.log and to the
#             verdict, and repeated in the PASS line; given once, one line of
#             text, neither a path nor a branch). The skip is the flag on
#             cdo-gate's own command line, never CDO_GATE_NO_SPEED: an exported
#             variable reaches every step (ENG-159's did, and `ci-steps
#             agentflow` failed under it), so land refuses to start with
#             CDO_GATE_NO_SPEED set at all. Refused, not cleared: clearing would
#             run the speed check the caller asked to skip, silently. land also
#             refuses any declared test hook, and starts its steps without
#             BASH_ENV or ENV.
#   recheck   (after ci and after cdo) the worktree is still on the landing
#             commit the gates ran on, clean, `landing/<name>` still points
#             there, and master has not moved: otherwise the gated tree is not
#             the one merge-and-push would land, and it stops.
#   push      only with --push: `scripts/merge-and-push landing/<name>` from the
#             main checkout (it finds ci's gate-passed record, so it does not run
#             the task gate again). Without --push it prints that command.
# It never force-pushes, and never resets or deletes a branch itself
# (merge-and-push resets master back to where it was when its own task gate
# fails).
#
# Logs: one per step in `${LAND_LOGS:-/work/.al-sem/land}/<UTC time>-<name>-<pid>/`
# (outside the worktree, so the gate records see a clean tree), plus `verdict`
# (one `<step> <exit> <seconds>` line per step). Timings: a start and an end
# line per step in `${FLOW_LOG:-/work/.al-sem/flow-timings.jsonl}` (step
# "land", issue = the ids, e.g. "TLS-58,ENG-30"). A conflict-resolving commit
# runs the repo's pre-commit hook when core.hooksPath enables it, as a
# hand-made one does.
#
# --dry-run runs `check` (without the lock) and predicts each merge with `git
# merge-tree`, the CHANGELOG rule included; it changes no ref and no file (the
# predicted merges are loose objects only) and exits 1 when a real run would
# refuse at the merge. It cannot predict a pre-commit hook's verdict. In a
# batch, a later prediction builds on the earlier one's tree with its CHANGELOG
# resolved, as the real run does.
#
# Environment: LAND_WORKTREE (default /work/alsem-wt/orchestrator-gate), CDO_WS
# (default /work/src/cdo-baseline/Cloud), LAND_LOGS, FLOW_LOG, LAND_MEM_MIN_GB
# (default 35; 0 skips the whole wait, for tests), LAND_MEM_TIMEOUT_S (1800 s
# of awake time: a host suspend does not count, scripts/awake-clock, TLS-105),
# LAND_SLOT_TIMEOUT_S (how long to wait for the CDO slot; default: no limit),
# CDO_SLOT_OWNER (the slot's owner label; default "land") and scripts/cdo-slot's
# own CDO_SLOT_DIR / CDO_SLOT_MEM_MIN_GB.
# Exit: 0 PASS (or a clean dry run); 1 refused or failed; 2 usage.
set -euo pipefail

usage() {
    echo "usage: scripts/land [--push] [--dry-run] [--name <x>] [--worktree <dir>] [--no-speed=<reason>] <branch>..."
    echo "  Merges the branches (in that order) into landing/<name> in the gate worktree,"
    echo "  runs ci-steps all, then cdo-gate; lands it via merge-and-push only with --push."
    echo "  --name     landing name (default: the task ids in the branch names, e.g. tls58+eng30)"
    echo "  --worktree gate worktree (default \$LAND_WORKTREE or /work/alsem-wt/orchestrator-gate)"
    echo "  --dry-run  check and predict the merges; change nothing"
    echo "  --push     land it on master with scripts/merge-and-push after a PASS"
    echo "  --no-speed=<reason>"
    echo "             run cdo-gate --no-speed (an approved skip of its speed phase); the"
    echo "             reason is required (this spelling only) and kept in the logs and verdict"
}
die() {
    echo "land: $*" >&2
    exit 1
}
bad_usage() {
    echo "land: error: $*" >&2
    usage >&2
    exit 2
}

# A git hook exports GIT_DIR and friends, which beat `git -C` (src/git_env.rs).
# shellcheck disable=SC2046
unset $(git rev-parse --local-env-vars)
# ⟨TLS-113⟩ A startup file every child bash would run before its gate script
# (one setting CDO_GATE_NO_SPEED, or exiting 0, would change a verdict after
# every check here; review r1, sol). land's own bash has run it already.
unset BASH_ENV ENV

push=0 dry_run=0 name="" no_speed="" no_speed_given=0
worktree="${LAND_WORKTREE:-/work/alsem-wt/orchestrator-gate}"
branches=()
while (($#)); do
    case "$1" in
        --push) push=1 ;;
        --dry-run) dry_run=1 ;;
        # ⟨TLS-113⟩ One spelling only: with `--no-speed <reason>` a forgotten
        # reason took the first branch for one and landed the rest (review r1, sol).
        --no-speed) bad_usage "--no-speed needs a reason: --no-speed=<reason>" ;;
        --no-speed=*)
            ((!no_speed_given)) || bad_usage "--no-speed given twice"
            no_speed=${1#--no-speed=} no_speed_given=1
            [[ "$no_speed" =~ [^[:space:]] && "$no_speed" != -* ]] \
                || bad_usage "--no-speed=<reason> needs a reason: text, not empty and not an option"
            # Kept on one line in the verdict and the logs: no newline, CR, escape.
            [[ "$no_speed" != *[[:cntrl:]]* ]] || bad_usage "--no-speed=<reason>: the reason has a control character"
            [[ ! -e "$no_speed" ]] || bad_usage "--no-speed=<reason>: '$no_speed' names an existing path, not a reason"
            ;;
        --name)
            (($# >= 2)) || bad_usage "--name needs a value"
            name=$2
            shift
            ;;
        --name=*) name=${1#--name=} ;;
        --worktree)
            (($# >= 2)) || bad_usage "--worktree needs a value"
            worktree=$2
            shift
            ;;
        --worktree=*) worktree=${1#--worktree=} ;;
        -h | --help)
            usage
            exit 0
            ;;
        -*) bad_usage "unknown option: $1" ;;
        *) branches+=("$1") ;;
    esac
    shift
done
((${#branches[@]})) || bad_usage "no branch given"
((push && dry_run)) && bad_usage "--push and --dry-run exclude each other"
# ⟨TLS-113⟩ The skip goes on cdo-gate's command line only (see `cdo` above).
[[ -z "${CDO_GATE_NO_SPEED+set}" ]] \
    || bad_usage "CDO_GATE_NO_SPEED is set: it would reach every step (ci-steps agentflow fails under it); unset it and give --no-speed=<reason>"
# A test hook makes a gate read a stand-in (a perf-bounds binary, a meminfo, a
# clock) and pass on it: none belongs in a real landing (review r1, sol). The
# names are the ones the gate scripts declare (cdo-speed's TEST_HOOKS, the
# `# test-hooks:` lines), read by the same code agentflow strips them with.
hooks=$(python3 -c 'import sys; sys.path.insert(0, sys.argv[1]); from agentflow.supervise import declared_test_hooks; print(*declared_test_hooks())' \
    "$(dirname "$0")") && [[ -n "$hooks" ]] || die "cannot read the gate scripts' declared test hooks"
set_hooks=()
for v in $hooks; do
    [[ -z "${!v+set}" ]] || set_hooks+=("$v")
done
((${#set_hooks[@]} == 0)) || bad_usage "test hooks are set, which no real landing may pass to its gates: ${set_hooks[*]}"
# Nor a build-shape override: CARGO_PROFILE_RELEASE_FAST_DEBUG_ASSERTIONS=true
# compiled perf_bounds' timing tests out, and the step passed (review r2, sol).
# land itself sets none of these, so none is exempt.
overrides=$(compgen -e | grep -E '^(CARGO_PROFILE_|CARGO_BUILD_)|^(RUSTFLAGS|RUSTDOCFLAGS|CARGO_ENCODED_RUSTFLAGS|CARGO_TARGET_DIR)$' || true)
[[ -z "$overrides" ]] || bad_usage "build overrides are set, which no landing may pass to its builds: $(echo $overrides)"
# Nor the engine's own test seams (read in Rust, by the suite ci-steps runs):
# ALSEM_TEST_* and ALSEM_BATCH_CLAIMS. land sets none of them.
seams=$(compgen -e | grep -E '^ALSEM_TEST_|^ALSEM_BATCH_CLAIMS$' || true)
[[ -z "$seams" ]] || bad_usage "engine test seams are set, which no landing may pass to its gates: $(echo $seams)"
cdo_flags=()
if ((no_speed_given)); then
    cdo_flags=(--no-speed)
fi

cdo_ws="${CDO_WS:-/work/src/cdo-baseline/Cloud}"
logs_root="${LAND_LOGS:-/work/.al-sem/land}"
flow_log="${FLOW_LOG:-/work/.al-sem/flow-timings.jsonl}"
mem_min_gb="${LAND_MEM_MIN_GB:-35}"
mem_timeout="${LAND_MEM_TIMEOUT_S:-1800}"
# A non-number would make `((...))` false with only a warning: no wait at all.
# A leading zero would read as octal (`08` is no number, `035` is 29).
[[ "$mem_min_gb" =~ ^(0|[1-9][0-9]{0,5})$ ]] || bad_usage "LAND_MEM_MIN_GB '$mem_min_gb': whole GB, no leading zero"
[[ "$mem_timeout" =~ ^(0|[1-9][0-9]{0,6})$ ]] || bad_usage "LAND_MEM_TIMEOUT_S '$mem_timeout': whole seconds, no leading zero"
# cdo-gate parses its workspace as an argument: `--help` or `--layout` there
# would exit 0 with nothing gated.
if ((!dry_run)); then
    [[ "$cdo_ws" == /* && -d "$cdo_ws" ]] || bad_usage "CDO_WS '$cdo_ws': an absolute path to an existing folder"
    # ⟨TLS-105⟩ The mem-wait's deadline counts awake time (scripts/awake-clock).
    # Loaded only for a run that waits (`--help` and `--dry-run` work without
    # it; review r1, sol), and before any lock: a run that lacks it stops here.
    if ((mem_min_gb > 0)); then
        [[ -r "$(dirname "$0")/awake-clock" ]] \
            || die "$(dirname "$0")/awake-clock is missing: the mem-wait needs it; nothing was done"
        # shellcheck source=awake-clock
        source "$(dirname "$0")/awake-clock"
    fi
fi
command -v jq >/dev/null || die "jq is needed for the timing log"

# Children never get fds 7/8 (the saved stdout/stderr, see merge_failed): a
# background job a child leaves behind, like merge-and-push's speed-check
# warm-up or a detached `git gc`, would keep the caller's terminal open. Nor
# fd 9, should a caller have opened one.
G() { git -C "$worktree" "$@" 7>&- 8>&- 9>&-; }

# union_changelog <base> <master's> <branch's> <out>: CHANGELOG.md's conflicts
# resolved by keeping both sides' lines, master's first, when every conflict
# is additions on both sides (an empty base part); 1 otherwise, with the reason
# on stdout. ⟨TLS-62⟩ The rule lives in scripts/changelog-merge, which git also
# runs as CHANGELOG.md's merge driver: one rule for landings and rebases.
union_changelog() {
    bash "$(dirname "$0")/changelog-merge" "$1" "$2" "$3" "$4"
}

# ---- check ---------------------------------------------------------------
[[ -d "$worktree" ]] || die "no gate worktree at $worktree"
G rev-parse --is-inside-work-tree >/dev/null 2>&1 || die "$worktree is not a git worktree"
if ((no_speed_given)) && G show-ref --verify -q "refs/heads/$no_speed"; then
    bad_usage "--no-speed=<reason>: '$no_speed' names a branch, not a reason"
fi
if ((!dry_run)); then
    exec 7>&1 8>&2
    # ⟨TLS-60⟩ The CDO slot (scripts/cdo-slot), from here to the end: no second
    # land and no lane's gate or CDO run (the cdo-slot-guard hook) can run under
    # this landing's gates; lanes' builds and tests stop only while cdo-speed's
    # timing marks the hold timed (TLS-89). The token lets the cdo-gate it runs share the hold;
    # bound to this process, so even a killed run frees it.
    export CDO_SLOT_TOKEN=${CDO_SLOT_TOKEN:-$(od -An -N8 -tx8 /dev/urandom | tr -d ' ')}
    slot="$(dirname "$0")/cdo-slot"
    slot_args=(acquire "${CDO_SLOT_OWNER:-land}" "landing ${branches[*]}" --wait --bind "$$")
    [[ -z "${LAND_SLOT_TIMEOUT_S:-}" ]] || slot_args+=(--timeout "$LAND_SLOT_TIMEOUT_S")
    rc=0
    # No memory wait here (ci-steps all needs none; the mem-wait step before
    # cdo-gate does it, under the slot, so nothing can take the memory meanwhile).
    CDO_SLOT_MEM_MIN_GB=0 bash "$slot" "${slot_args[@]}" 7>&- 8>&- || rc=$?
    case "$rc" in
        0) trap 'bash "$slot" release >/dev/null 2>&1 || true' EXIT ;;
        # A shared hold (the caller's token, or its session holding by hand)
        # would let two lands run on one worktree at once: land needs the slot
        # to itself (review r1, sol).
        4) die "the CDO slot is already held by this caller; land needs it to itself: release it first (scripts/cdo-slot release)" ;;
        *) die "the CDO slot was not taken (scripts/cdo-slot status)" ;;
    esac
fi
G rev-parse -q --verify MERGE_HEAD >/dev/null && die "a merge is in progress in $worktree"
status=$(G status --porcelain) || die "git status failed in $worktree"
dirty=$(grep -v '^?? \.agent/' <<<"$status" || true)
[[ -z "$dirty" ]] || die "the gate worktree $worktree is not clean:
$dirty"
master=$(G rev-parse -q --verify refs/heads/master) || die "no local master"
if origin=$(G rev-parse -q --verify refs/remotes/origin/master); then
    G merge-base --is-ancestor "$origin" "$master" \
        || die "local master ${master:0:8} is behind (or off) origin/master ${origin:0:8} as of the last fetch: update it first"
    echo "land: master ${master:0:8} (origin/master ${origin:0:8} as of the last fetch)"
else
    echo "land: master ${master:0:8} (no origin/master ref)"
fi
main=$(G worktree list --porcelain | sed -n '1s/^worktree //p')
if ((push)); then
    main_dirty=$(git -C "$main" status --porcelain --untracked-files=no) || die "git status failed in $main"
    [[ -z "$main_dirty" ]] || die "the main checkout $main has uncommitted changes; merge-and-push would refuse after the gates"
fi

ids=() parts=() tips=()
for ((i = 0; i < ${#branches[@]}; i++)); do
    b=${branches[i]}
    [[ "$b" != master ]] || die "master is not a branch to land"
    for ((j = 0; j < i; j++)); do
        [[ "$b" != "${branches[j]}" ]] || die "'$b' given twice"
    done
    # Each branch's commit, read once: the checks below and the merge use this
    # commit, never the branch name again, so a commit added to a branch while
    # land runs is neither checked nor merged (TLS-87 review r1, sol).
    tips[i]=$(G rev-parse -q --verify "refs/heads/$b^{commit}") || die "no local branch '$b'"
    G merge-base --is-ancestor "${tips[i]}" "$master" && die "'$b' is already in master"
    if [[ "$b" =~ (^|/)([A-Za-z]+)-([0-9]+) ]]; then
        ids+=("${BASH_REMATCH[2]^^}-${BASH_REMATCH[3]}")
        parts+=("${BASH_REMATCH[2],,}${BASH_REMATCH[3]}")
    else
        [[ -n "$name" ]] || die "'$b' names no task id (like tls-58): give --name"
        ids+=("$b")
    fi
done
if [[ -z "$name" ]]; then
    name=$(IFS=+; echo "${parts[*]}")
fi
git check-ref-format "refs/heads/landing/$name" || bad_usage "landing/$name is not a valid branch name"
[[ "$name" != */* ]] || bad_usage "--name '$name': no '/'"
landing="landing/$name"
n=2
# Taken when ANY ref resolves to the name (a tag `landing/<name>` would shadow
# the branch for anyone using the bare name; merge-and-push itself reads
# refs/heads/<name>).
taken() { # a ref by that name, or under it (`landing/x/y` blocks `landing/x`)
    G rev-parse -q --verify "$1^{commit}" >/dev/null \
        || [[ -n "$(G for-each-ref --count=1 "refs/heads/$1/" "refs/tags/$1/")" ]]
}
while taken "$landing"; do
    landing="landing/$name-$n"
    n=$((n + 1))
done
echo "land: merge order:"
for ((i = 0; i < ${#branches[@]}; i++)); do
    echo "land:   $((i + 1)). ${branches[i]} (${tips[i]:0:8}, ${ids[i]})"
done
echo "land: landing branch: $landing"
if ((no_speed_given)); then
    echo "land: cdo-gate runs with --no-speed (SPEED AND MEMORY NOT CHECKED): $no_speed"
fi

# ⟨TLS-87⟩ The pre-submit CDO subset, checked rather than remembered: a branch
# whose diff changes product code (or the subset's own tests and goldens) needs
# a passing `cdo-gate --only harness,l4,output` record for its head tree
# (scripts/cdo-gate's record_presubmit); `output`'s rendering goldens are the
# only pre-landing check of explain, query and digest text. A new gate starts advisory (the owner's design principle 4): a missing
# record is a loud warning; LAND_REQUIRE_PRESUBMIT=1 makes it a refusal. It
# runs after the slot is taken: a refusal can wait for the slot first (move it
# up if refusal ever becomes the default).
presubmit_dir="${CDO_PRESUBMIT_DIR:-$(G rev-parse --path-format=absolute --git-common-dir)/cdo-presubmit}"
presubmit_missing=() presubmit_notes=()
# The paths that need no CDO check (review r1, Fable: a rule listing what NEEDS
# one missed Cargo.*, tests/ and parts of the engine): docs, scripts, the
# agents' and CI's folders, top-level Markdown, and tests/ apart from what the
# subset itself runs or reads (its test files, goldens and the shared CDO
# helpers: a re-minted golden is exactly what it checks). Every other path
# (all of src/, crates/, Cargo.*, build.rs) needs harness,l4 and output; a
# subset test path needs its own phases.
presubmit_exempt='^(docs/|scripts/|\.claude/|\.kraken/|\.github/|\.agent/|[^/]+\.md$)'
presubmit_hl_tests='^tests/(program_resolve_harness\.rs|goldens/semantic-edges/|l4_summary_differential\.rs|l4-summary-baseline/|common/)'
presubmit_out_tests='^tests/(cli-output-goldens/|common/|cli/main\.rs$)'
# The cli members `output_cdo` reaches through `crate::<module>` at commit <c>,
# followed transitively (review r1, sol: it imports output_invariants and
# mcp_server, which a fixed list missed): `tests/cli/<module>.rs`, one a line.
cli_closure() { # <commit> <module>...
    local c=$1 m src n
    shift
    local -A seen=()
    local queue=("$@")
    while ((${#queue[@]})); do
        m=${queue[0]}
        queue=("${queue[@]:1}")
        [[ -z "${seen[$m]:-}" ]] || continue
        seen[$m]=1
        src=$(G show "$c:tests/cli/$m.rs" 2>/dev/null) || continue
        echo "tests/cli/$m.rs"
        while read -r n; do
            [[ -n "$n" ]] && queue+=("$n")
        done < <(grep -oE 'crate::[a-z_][a-z0-9_]*' <<<"$src" | sed 's/^crate:://' | sort -u)
    done
}
for ((i = 0; i < ${#branches[@]}; i++)); do
    b=${branches[i]}
    # --no-renames: a file moved out of the engine counts at its old path too.
    # -z: paths as they are, never quoted (a non-ASCII name, a tab or a `"`), so
    # they still match the exempt prefixes (review r1/r2, sol). A newline inside
    # a name becomes \001 first, so each path stays one line (r3).
    paths=$(G diff -z --no-renames --name-only "$master...${tips[i]}" | tr '\n\0' '\001\n') \
        || die "git diff failed for '$b'"
    paths=$(grep -vE "$presubmit_exempt" <<<"$paths" || true)
    # Test data the subset reads (tests/fixtures/events is the harness's) counts
    # as product code (review r2, sol).
    product=$(grep -vE '^tests/' <<<"$paths" || true)
    product+=$(grep -E '^tests/(fixtures|r0-corpus)/' <<<"$paths" || true)
    # output_cdo's helpers as the branch has them AND as master has them: a
    # helper master started importing after the branch left counts too (r2).
    out_tests=$(
        grep -E "$presubmit_out_tests" <<<"$paths" || true
        grep -xF -f <(cli_closure "${tips[i]}" output_cdo; cli_closure "$master" output_cdo) \
            <<<"$paths" || true
    )
    need=()
    if [[ -n "$product" || -n "$out_tests" ]] || grep -qE "$presubmit_hl_tests" <<<"$paths"; then
        need=(program_resolve_harness l4_summary_differential)
    fi
    if [[ -n "$product" || -n "$out_tests" ]]; then
        need+=(output_cdo)
    fi
    ((${#need[@]})) || continue
    tree=$(G rev-parse "${tips[i]}^{tree}")
    lacks=()
    for p in "${need[@]}"; do
        grep -qxF "$p" "$presubmit_dir/$tree" 2>/dev/null || lacks+=("$p")
    done
    if ((${#lacks[@]})); then
        presubmit_missing+=("$b")
        presubmit_notes+=("$b: no pre-submit record for ${lacks[*]}")
        echo "land: WARNING: '$b' has no passing pre-submit CDO record for its head tree ${tree:0:12}: missing ${lacks[*]}" >&2
        echo "land:   in its worktree, committed and clean: scripts/cdo-gate --only $(
            sed 's/program_resolve_harness/harness/; s/l4_summary_differential/l4/; s/output_cdo/output/' \
                <<<"$(IFS=,; echo "${need[*]}")") <CDO_WS>" >&2
    else
        echo "land: '$b' pre-submit CDO record: ${need[*]}"
    fi
done
if ((${#presubmit_missing[@]})) && [[ "${LAND_REQUIRE_PRESUBMIT:-}" == 1 ]]; then
    die "LAND_REQUIRE_PRESUBMIT=1: no pre-submit CDO record for ${presubmit_missing[*]}"
fi
# Test hook: a command run right after the checks (a branch moving now must not
# change what is merged).
[[ -z "${LAND_TEST_AFTER_CHECK:-}" ]] || bash -c "$LAND_TEST_AFTER_CHECK"

# ---- dry run -----------------------------------------------------------
if ((dry_run)); then
    tmp=$(mktemp -d)
    trap 'rm -rf "$tmp"' EXIT
    prev=$master refuse=0
    for ((i = 0; i < ${#branches[@]}; i++)); do
        b=${branches[i]}
        rc=0
        out=$(G merge-tree --write-tree --no-messages "$prev" "${tips[i]}") || rc=$?
        ((rc <= 1)) || die "git merge-tree failed on '$b' (exit $rc)"
        tree=$(head -n 1 <<<"$out")
        # The other lines: `<mode> <blob> <stage>\t<path>`, one per conflicted stage.
        stages=$(tail -n +2 <<<"$out")
        conflicts=$(cut -f 2 <<<"$stages" | sed '/^$/d' | sort -u)
        if [[ -z "$conflicts" ]]; then
            echo "land:   ${ids[i]}: merges clean"
        elif [[ "$conflicts" == CHANGELOG.md ]]; then
            for s in 1 2 3; do
                blob=$(awk -v s="$s" -F '[ \t]' '$3 == s && $4 == "CHANGELOG.md" { print $2 }' <<<"$stages")
                if [[ -z "$blob" ]]; then
                    echo "land:   ${ids[i]}: REFUSE: CHANGELOG.md is missing on one side (stage $s)"
                    refuse=1
                    continue 2
                fi
                G cat-file blob "$blob" >"$tmp/$s"
            done
            if why=$(union_changelog "$tmp/1" "$tmp/2" "$tmp/3" "$tmp/union"); then
                echo "land:   ${ids[i]}: CHANGELOG.md conflicts: would keep both sides' entries"
                # The next prediction builds on the resolved CHANGELOG, as the
                # real run does (a temporary index; loose objects only).
                mode=$(awk -F '[ \t]' '$3 == 2 && $4 == "CHANGELOG.md" { print $1 }' <<<"$stages")
                blob=$(G hash-object -w "$tmp/union")
                GIT_INDEX_FILE="$tmp/index" git -C "$worktree" read-tree "$tree"
                GIT_INDEX_FILE="$tmp/index" git -C "$worktree" update-index --cacheinfo "$mode,$blob,CHANGELOG.md"
                tree=$(GIT_INDEX_FILE="$tmp/index" git -C "$worktree" write-tree)
            else
                echo "land:   ${ids[i]}: REFUSE: $why"
                refuse=1
            fi
        else
            echo "land:   ${ids[i]}: REFUSE: conflicts in" $conflicts
            refuse=1
        fi
        prev=$(G commit-tree "$tree" -p "$prev" -p "${tips[i]}" -m "land dry run")
    done
    echo "land: then: ci-steps all; wait for ${mem_min_gb} GB free; cdo-gate ${cdo_flags[*]}${cdo_flags[*]:+ }$cdo_ws; merge-and-push $landing only with --push"
    if ((refuse)); then
        echo "land: DRY RUN: a real run would refuse"
        exit 1
    fi
    echo "land: DRY RUN: a real run would merge every branch"
    exit 0
fi

# ---- run ---------------------------------------------------------------
run="$logs_root/$(date -u +%Y%m%dT%H%M%SZ)-${landing#landing/}-$$"
mkdir -p "$run" "$(dirname "$flow_log")"
run_id=$(basename "$run")
issue=$(IFS=,; echo "${ids[*]}")
echo "land: logs in $run"
# ⟨TLS-87⟩ The pre-submit check's findings, kept with the run (to measure what
# the advisory gate would have caught before making it a refusal).
((${#presubmit_notes[@]} == 0)) || printf '%s\n' "${presubmit_notes[@]}" >"$run/presubmit"
mark() { # mark <step> start|end [exit]
    jq -nc --arg ts "$(date -u +%FT%TZ)" --arg issue "$issue" --arg run "$run_id" \
        --arg phase "$1" --arg event "$2" --arg rc "${3:-}" \
        '{ts: $ts, issue: $issue, step: "land", run_id: $run, phase: $phase, event: $event}
         + (if $rc == "" then {} else {rc: ($rc | tonumber)} end)' >>"$flow_log"
}
verdict() { # verdict <step> <exit> <start>
    local secs=$((SECONDS - $3))
    mark "$1" end "$2"
    echo "$1 $2 $secs" >>"$run/verdict"
    if (($2 == 0)); then
        echo "land: [$1] ok ($secs s)"
    else
        echo "land: [$1] FAILED, exit $2 ($secs s; log $run/$1.log)"
        # The failing step's own verdict lines, so nobody needs to open its log
        # (e.g. cdo-gate's "speed ... FAIL" summary line). At most the last 8.
        if [[ -f "$run/$1.log" ]]; then
            grep -E 'FAIL|error[:[]' "$run/$1.log" | tail -n 8 | sed 's/^/land:   | /' || true
        fi
        # ⟨TLS-87⟩ Said again where it matters (review r1, Fable): the check's
        # warning is 25 minutes of output back by now.
        local n
        for n in "${presubmit_notes[@]}"; do
            echo "land:   note: $n (scripts/cdo-gate --only would have run it before the landing)"
        done
    fi
}

# merge
start=$SECONDS
mark merge start
merge_failed() { # back to a clean, detached master, then stop
    trap - INT TERM
    # A trap can fire inside a command whose output goes to merge.log: the
    # verdict belongs on the terminal.
    exec 1>&7 2>&8
    G merge --abort >/dev/null 2>&1 || true
    G switch --quiet --force --detach "$master" >/dev/null 2>&1 || true
    verdict merge 1 "$start"
    # Only the last instants (after `git branch`) can leave the branch: say so.
    if G rev-parse -q --verify "refs/heads/$landing" >/dev/null; then
        die "$1; $landing was made (the worktree is back on master)"
    fi
    die "$1; no landing branch was made"
}
trap 'merge_failed "interrupted"' INT TERM
G switch --quiet --detach "$master" >>"$run/merge.log" 2>&1 \
    || merge_failed "cannot check out master in $worktree"
for ((i = 0; i < ${#branches[@]}; i++)); do
    b=${branches[i]} msg="landing: ${ids[i]}"
    before=$(G rev-parse HEAD) || merge_failed "cannot read HEAD"
    if G -c core.commentChar=';' merge --no-ff --no-edit -m "$msg" "${tips[i]}" >>"$run/merge.log" 2>&1; then
        if [[ "$(G rev-parse HEAD)" == "$before" ]]; then
            echo "land:   ${ids[i]}: already in the landing (an earlier branch holds it); no commit"
        else
            echo "land:   ${ids[i]}: merged"
        fi
        continue
    fi
    conflicts=$(G diff --name-only --diff-filter=U) || merge_failed "cannot list the conflicts"
    [[ -n "$conflicts" ]] || merge_failed "merging '$b' failed without a conflict (see $run/merge.log)"
    [[ "$conflicts" == CHANGELOG.md ]] || merge_failed "merging '$b' conflicts in: $(echo $conflicts)"
    for stage in 1 2 3; do
        G show ":$stage:CHANGELOG.md" >"$run/CHANGELOG.$stage" 2>>"$run/merge.log" \
            || merge_failed "CHANGELOG.md is missing on one side of the '$b' merge (stage $stage)"
    done
    why=$(union_changelog "$run/CHANGELOG.1" "$run/CHANGELOG.2" "$run/CHANGELOG.3" "$run/CHANGELOG.union") \
        || merge_failed "merging '$b': $why"
    cp "$run/CHANGELOG.union" "$worktree/CHANGELOG.md" || merge_failed "cannot write CHANGELOG.md"
    G add CHANGELOG.md || merge_failed "cannot stage CHANGELOG.md"
    G -c core.commentChar=';' commit --quiet -m "$msg" >>"$run/merge.log" 2>&1 \
        || merge_failed "committing the '$b' merge failed (see $run/merge.log)"
    echo "land:   ${ids[i]}: merged (CHANGELOG.md: both sides' entries kept)"
done
landed=$(G rev-parse HEAD) || merge_failed "cannot read the merged commit"
# The branch only now, with no hook in between (`switch -c` runs post-checkout
# after it made the branch); the cleanup stays armed until the worktree is on it.
G branch "$landing" "$landed" >>"$run/merge.log" 2>&1 || merge_failed "cannot create $landing"
G symbolic-ref HEAD "refs/heads/$landing" || merge_failed "cannot put the worktree on $landing"
trap - INT TERM
verdict merge 0 "$start"

# recheck <after>: the gated tree is still the one merge-and-push would land.
recheck() {
    local why="" now
    now=$(G rev-parse HEAD 2>/dev/null) || now=""
    if [[ "$now" != "$landed" ]]; then
        why="the gate worktree moved off the landing commit ${landed:0:8} (now ${now:0:8})"
    elif [[ "$(G rev-parse -q --verify "refs/heads/$landing" || true)" != "$landed" ]]; then
        why="$landing no longer points at ${landed:0:8}"
    elif ! now=$(G status --porcelain); then
        why="git status failed in the gate worktree"
    elif [[ -n "$(grep -v '^?? \.agent/' <<<"$now" || true)" ]]; then
        why="the gate worktree is no longer clean"
    elif [[ "$(G rev-parse refs/heads/master)" != "$master" ]]; then
        why="master moved during the gates (${master:0:8} -> $(G rev-parse --short refs/heads/master)): land again on the new master"
    fi
    if [[ -n "$why" ]]; then
        echo "recheck after $1: $why" >>"$run/verdict"
        # ⟨TLS-87⟩ This exit repeats the notice too (review r1, sol).
        local n
        for n in "${presubmit_notes[@]}"; do
            echo "land:   note: $n (scripts/cdo-gate --only would have run it before the landing)"
        done
        die "FAIL after $1: $why; nothing pushed ($landing kept)"
    fi
}

# ci
start=$SECONDS
mark ci start
rc=0
(cd "$worktree" && bash scripts/ci-steps all) >"$run/ci.log" 2>&1 7>&- 8>&- 9>&- || rc=$?
verdict ci "$rc" "$start"
((rc == 0)) || die "FAIL at ci: cdo-gate not run, nothing pushed ($landing kept)"
recheck ci

# mem-wait
start=$SECONDS
mark mem-wait start
rc=0
if ((mem_min_gb > 0)); then
    # ⟨TLS-105⟩ LAND_MEM_TIMEOUT_S of AWAKE time (scripts/awake-clock): a laptop
    # that slept through the wait gave up at once on resume. Each sleep is said
    # (on the terminal and in mem-wait.log); no nap passes the deadline as of
    # the clock reading just before it. ⟨TLS-129⟩ So land gives up late by the
    # loop's own work after that reading: awk, a slow clock read, and
    # awake-clock's failed-read reuse and wall fall back.
    awake_start
    said=0
    while :; do
        avail_kb=$(awk '/^MemAvailable:/ { print $2 }' /proc/meminfo)
        # No other gate can run: land holds the CDO slot, and cdo-gate takes it
        # (a gate queued behind this landing is no reason to wait: it waits for
        # us, review r1, sol).
        if ((avail_kb >= mem_min_gb * 1048576)); then
            echo "MemAvailable $((avail_kb >> 20)) GB" >>"$run/mem-wait.log"
            break
        fi
        awake_read
        [[ -z "$awake_msg" ]] || echo "land: mem-wait: $awake_msg" | tee -a "$run/mem-wait.log"
        left_us=$((mem_timeout * 1000000 - awake_us))
        if ((left_us <= 0)); then
            echo "gave up after $awake_us us of awake time: MemAvailable $((avail_kb >> 20)) GB (need $mem_min_gb)" >>"$run/mem-wait.log"
            rc=1
            break
        fi
        if ((!said)); then
            echo "land: mem-wait: MemAvailable $((avail_kb >> 20)) GB, waiting for $mem_min_gb GB (at most $mem_timeout s of awake time)"
            said=1
        fi
        awake_nap $((left_us < 15000000 ? left_us : 15000000))
    done
fi
verdict mem-wait "$rc" "$start"
((rc == 0)) || die "FAIL at mem-wait: cdo-gate not run, nothing pushed ($landing kept)"

# cdo
start=$SECONDS
mark cdo start
rc=0
no_speed_note=""
if ((no_speed_given)); then
    no_speed_note=" (cdo-gate --no-speed: $no_speed)"
    echo "land: cdo-gate --no-speed: $no_speed" >"$run/cdo.log"
fi
(cd "$worktree" && bash scripts/cdo-gate "${cdo_flags[@]}" "$cdo_ws") >>"$run/cdo.log" 2>&1 7>&- 8>&- 9>&- || rc=$?
verdict cdo "$rc" "$start"
((no_speed_given == 0)) || echo "cdo no-speed: $no_speed" >>"$run/verdict"
((rc == 0)) || die "FAIL at cdo: nothing pushed ($landing kept)"
recheck cdo

if ((!push)); then
    echo "land: PASS$no_speed_note: $landing is gated; to land it: cd $main && scripts/merge-and-push $landing"
    exit 0
fi

# push
start=$SECONDS
mark push start
rc=0
# MERGE_EXPECT_MASTER: merge-and-push refuses if master moved after the last
# recheck (it would merge into a tree no gate saw).
(cd "$main" && MERGE_EXPECT_MASTER="$master" MERGE_EXPECT_SOURCE="$landed" scripts/merge-and-push "$landing") \
    >"$run/push.log" 2>&1 7>&- 8>&- 9>&- || rc=$?
verdict push "$rc" "$start"
((rc == 0)) || die "FAIL at push: see $run/push.log"
echo "land: PASS$no_speed_note: $landing landed on master"
