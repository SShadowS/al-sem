#!/usr/bin/env bash
# scripts/land — build a landing branch from one or more lane branches, gate it,
# and (only with --push) land it on master through scripts/merge-and-push.
#
# ⟨TLS-59⟩ One command for the chain the orchestrator typed by hand 31 times
# (once it ran on into cdo-gate after ci-steps had failed). Steps, each with a
# one-line verdict; the first failure stops the run:
#   check     one land run per gate worktree at a time (a lock, held to the
#             end); the worktree is clean (untracked `.agent/` aside) with no
#             merge in progress; local master is not behind origin/master (as of
#             the last fetch: no fetch here, merge-and-push fetches and checks
#             again); every branch exists, is not master, is not yet in master
#             and is given once; with --push, the main checkout is clean. Prints
#             master's sha and the merge order.
#   merge     in the gate worktree, on a DETACHED master: each branch in the
#             order given, `merge --no-ff -m "landing: <ID>"`. A conflict in
#             CHANGELOG.md alone is resolved by keeping both sides' added lines
#             (master's first, a blank line between an entry and a heading that
#             meet), but only when every conflict there is additions on both
#             sides; any other conflict aborts and stops. Only when every merge
#             is in does it create `landing/<name>` (`-2`, `-3`, ... when
#             taken), so a refused or interrupted merge leaves nothing behind
#             (the worktree is then on a clean, detached master).
#   ci        `bash scripts/ci-steps all` (stops here on a failure: cdo-gate
#             never runs after a red ci).
#   mem-wait  MemAvailable >= 35 GB and no other cdo-gate running (polls 15 s,
#             gives up after 30 min). "Running" is a `bash [<dir>/]scripts/cdo-gate`
#             command line in this container; `bash -x ...` or a gate started
#             from inside scripts/ is not seen.
#   cdo       `bash scripts/cdo-gate <CDO_WS>`.
#   recheck   (after ci and after cdo) the worktree is still on the landing
#             commit the gates ran on, clean, `landing/<name>` still points
#             there, and master has not moved: otherwise the gated tree is not
#             the one merge-and-push would land, and it stops.
#   push      only with --push: `scripts/merge-and-push landing/<name>` from the
#             main checkout (it finds ci's gate-passed record, so it does not run
#             the task gate again). Without --push it prints that command.
# It never force-pushes, and never resets or deletes a branch itself
# (merge-and-push resets master back to where it was when its own task gate
# fails).
#
# Logs: one per step in `${LAND_LOGS:-/work/.al-sem/land}/<UTC time>-<name>-<pid>/`
# (outside the worktree, so the gate records see a clean tree), plus `verdict`
# (one `<step> <exit> <seconds>` line per step). Timings: a start and an end
# line per step in `${FLOW_LOG:-/work/.al-sem/flow-timings.jsonl}` (step
# "land", issue = the ids, e.g. "TLS-58,ENG-30"). A conflict-resolving commit
# runs the repo's pre-commit hook when core.hooksPath enables it, as a
# hand-made one does.
#
# --dry-run runs `check` (without the lock) and predicts each merge with `git
# merge-tree`, the CHANGELOG rule included; it changes no ref and no file (the
# predicted merges are loose objects only) and exits 1 when a real run would
# refuse at the merge. It cannot predict a pre-commit hook's verdict. In a
# batch, a later prediction builds on the earlier one's tree with its CHANGELOG
# resolved, as the real run does.
#
# Environment: LAND_WORKTREE (default /work/alsem-wt/orchestrator-gate), CDO_WS
# (default /work/src/cdo-baseline/Cloud), LAND_LOGS, FLOW_LOG, LAND_MEM_MIN_GB
# (default 35; 0 skips the whole wait, for tests), LAND_MEM_TIMEOUT_S (1800).
# Exit: 0 PASS (or a clean dry run); 1 refused or failed; 2 usage.
set -euo pipefail

usage() {
    echo "usage: scripts/land [--push] [--dry-run] [--name <x>] [--worktree <dir>] <branch>..."
    echo "  Merges the branches (in that order) into landing/<name> in the gate worktree,"
    echo "  runs ci-steps all, then cdo-gate; lands it via merge-and-push only with --push."
    echo "  --name     landing name (default: the task ids in the branch names, e.g. tls58+eng30)"
    echo "  --worktree gate worktree (default \$LAND_WORKTREE or /work/alsem-wt/orchestrator-gate)"
    echo "  --dry-run  check and predict the merges; change nothing"
    echo "  --push     land it on master with scripts/merge-and-push after a PASS"
}
die() {
    echo "land: $*" >&2
    exit 1
}
bad_usage() {
    echo "land: error: $*" >&2
    usage >&2
    exit 2
}

# A git hook exports GIT_DIR and friends, which beat `git -C` (src/git_env.rs).
# shellcheck disable=SC2046
unset $(git rev-parse --local-env-vars)

push=0 dry_run=0 name=""
worktree="${LAND_WORKTREE:-/work/alsem-wt/orchestrator-gate}"
branches=()
while (($#)); do
    case "$1" in
        --push) push=1 ;;
        --dry-run) dry_run=1 ;;
        --name)
            (($# >= 2)) || bad_usage "--name needs a value"
            name=$2
            shift
            ;;
        --name=*) name=${1#--name=} ;;
        --worktree)
            (($# >= 2)) || bad_usage "--worktree needs a value"
            worktree=$2
            shift
            ;;
        --worktree=*) worktree=${1#--worktree=} ;;
        -h | --help)
            usage
            exit 0
            ;;
        -*) bad_usage "unknown option: $1" ;;
        *) branches+=("$1") ;;
    esac
    shift
done
((${#branches[@]})) || bad_usage "no branch given"
((push && dry_run)) && bad_usage "--push and --dry-run exclude each other"

cdo_ws="${CDO_WS:-/work/src/cdo-baseline/Cloud}"
logs_root="${LAND_LOGS:-/work/.al-sem/land}"
flow_log="${FLOW_LOG:-/work/.al-sem/flow-timings.jsonl}"
mem_min_gb="${LAND_MEM_MIN_GB:-35}"
mem_timeout="${LAND_MEM_TIMEOUT_S:-1800}"
# A non-number would make `((...))` false with only a warning: no wait at all.
# A leading zero would read as octal (`08` is no number, `035` is 29).
[[ "$mem_min_gb" =~ ^(0|[1-9][0-9]{0,5})$ ]] || bad_usage "LAND_MEM_MIN_GB '$mem_min_gb': whole GB, no leading zero"
[[ "$mem_timeout" =~ ^(0|[1-9][0-9]{0,6})$ ]] || bad_usage "LAND_MEM_TIMEOUT_S '$mem_timeout': whole seconds, no leading zero"
# cdo-gate parses its workspace as an argument: `--help` or `--layout` there
# would exit 0 with nothing gated.
if ((!dry_run)); then
    [[ "$cdo_ws" == /* && -d "$cdo_ws" ]] || bad_usage "CDO_WS '$cdo_ws': an absolute path to an existing folder"
fi
command -v jq >/dev/null || die "jq is needed for the timing log"
command -v flock >/dev/null || die "flock is needed for the worktree lock"

# Children never get fd 9 (the lock: a background job a child leaves behind,
# like merge-and-push's speed-check warm-up or a detached `git gc`, would hold
# it after this run) nor 7/8 (the saved stdout/stderr, see merge_failed).
G() { git -C "$worktree" "$@" 7>&- 8>&- 9>&-; }

# union_changelog <base> <master's> <branch's> <out>: CHANGELOG.md's conflicts
# resolved by keeping both sides' lines, master's first, when every conflict
# is additions on both sides (an empty base part); 1 otherwise, with the reason
# on stdout. The lines outside the conflicts are merge-file's own three-way
# merge of the same three versions.
union_changelog() {
    local rc=0
    git merge-file --diff3 -p -L master -L base -L branch "$2" "$1" "$3" >"$4.diff3" 2>/dev/null || rc=$?
    # Its exit is the conflict count; 255 is an error (binary content, ...).
    if ((rc > 127)); then
        echo "git merge-file cannot merge CHANGELOG.md (exit $rc)"
        return 1
    fi
    # Two entries added at the same place meet as "- last line" + "### Heading":
    # a blank line goes between (CHANGELOG.md has one before every heading).
    if ! awk '
        state == 0 && $0 == "<<<<<<< master" { state = 1; no = 0; nt = 0; next }
        state == 0 { print; next }
        state == 1 && $0 == "||||||| base" { state = 2; next }
        state == 1 { o[++no] = $0; next }
        state == 2 && $0 == "=======" { state = 3; next }
        state == 2 { bad = 1; exit }
        state == 3 && $0 == ">>>>>>> branch" {
            for (i = 1; i <= no; i++) print o[i]
            if (no > 0 && o[no] != "" && nt > 0 && t[1] ~ /^#/) print ""
            for (i = 1; i <= nt; i++) print t[i]
            state = 0
            next
        }
        state == 3 { t[++nt] = $0; next }
        END { if (bad || state != 0) exit 1 }' "$4.diff3" >"$4"; then
        echo "a CHANGELOG.md conflict changes a line both sides had (not only additions): resolve it by hand"
        return 1
    fi
    # A marker the awk did not recognise (CRLF line ends, other labels) must not
    # be committed.
    if grep -qE '^(<<<<<<<|\|\|\|\|\|\|\||>>>>>>>)( |$)' "$4"; then
        echo "CHANGELOG.md still holds a conflict marker after the merge: resolve it by hand"
        return 1
    fi
}

# ---- check ---------------------------------------------------------------
[[ -d "$worktree" ]] || die "no gate worktree at $worktree"
G rev-parse --is-inside-work-tree >/dev/null 2>&1 || die "$worktree is not a git worktree"
if ((!dry_run)); then
    # Two runs on one worktree would swap the tree under each other's gates.
    lock="$(G rev-parse --absolute-git-dir)/land.lock"
    exec 7>&1 8>&2 9>"$lock"
    flock -n 9 || die "another scripts/land run holds $worktree ($lock)"
fi
G rev-parse -q --verify MERGE_HEAD >/dev/null && die "a merge is in progress in $worktree"
status=$(G status --porcelain) || die "git status failed in $worktree"
dirty=$(grep -v '^?? \.agent/' <<<"$status" || true)
[[ -z "$dirty" ]] || die "the gate worktree $worktree is not clean:
$dirty"
master=$(G rev-parse -q --verify refs/heads/master) || die "no local master"
if origin=$(G rev-parse -q --verify refs/remotes/origin/master); then
    G merge-base --is-ancestor "$origin" "$master" \
        || die "local master ${master:0:8} is behind (or off) origin/master ${origin:0:8} as of the last fetch: update it first"
    echo "land: master ${master:0:8} (origin/master ${origin:0:8} as of the last fetch)"
else
    echo "land: master ${master:0:8} (no origin/master ref)"
fi
main=$(G worktree list --porcelain | sed -n '1s/^worktree //p')
if ((push)); then
    main_dirty=$(git -C "$main" status --porcelain --untracked-files=no) || die "git status failed in $main"
    [[ -z "$main_dirty" ]] || die "the main checkout $main has uncommitted changes; merge-and-push would refuse after the gates"
fi

ids=() parts=()
for ((i = 0; i < ${#branches[@]}; i++)); do
    b=${branches[i]}
    [[ "$b" != master ]] || die "master is not a branch to land"
    for ((j = 0; j < i; j++)); do
        [[ "$b" != "${branches[j]}" ]] || die "'$b' given twice"
    done
    G rev-parse -q --verify "refs/heads/$b" >/dev/null || die "no local branch '$b'"
    G merge-base --is-ancestor "refs/heads/$b" "$master" && die "'$b' is already in master"
    if [[ "$b" =~ (^|/)([A-Za-z]+)-([0-9]+) ]]; then
        ids+=("${BASH_REMATCH[2]^^}-${BASH_REMATCH[3]}")
        parts+=("${BASH_REMATCH[2],,}${BASH_REMATCH[3]}")
    else
        [[ -n "$name" ]] || die "'$b' names no task id (like tls-58): give --name"
        ids+=("$b")
    fi
done
if [[ -z "$name" ]]; then
    name=$(IFS=+; echo "${parts[*]}")
fi
git check-ref-format "refs/heads/landing/$name" || bad_usage "landing/$name is not a valid branch name"
[[ "$name" != */* ]] || bad_usage "--name '$name': no '/'"
landing="landing/$name"
n=2
# Taken when ANY ref resolves to the name: merge-and-push merges it unqualified,
# and a tag `landing/<name>` would win over the branch.
while G rev-parse -q --verify "$landing^{commit}" >/dev/null; do
    landing="landing/$name-$n"
    n=$((n + 1))
done
echo "land: merge order:"
for ((i = 0; i < ${#branches[@]}; i++)); do
    echo "land:   $((i + 1)). ${branches[i]} ($(G rev-parse --short "refs/heads/${branches[i]}"), ${ids[i]})"
done
echo "land: landing branch: $landing"

# ---- dry run -----------------------------------------------------------
if ((dry_run)); then
    tmp=$(mktemp -d)
    trap 'rm -rf "$tmp"' EXIT
    prev=$master refuse=0
    for ((i = 0; i < ${#branches[@]}; i++)); do
        b=${branches[i]}
        rc=0
        out=$(G merge-tree --write-tree --no-messages "$prev" "refs/heads/$b") || rc=$?
        ((rc <= 1)) || die "git merge-tree failed on '$b' (exit $rc)"
        tree=$(head -n 1 <<<"$out")
        # The other lines: `<mode> <blob> <stage>\t<path>`, one per conflicted stage.
        stages=$(tail -n +2 <<<"$out")
        conflicts=$(cut -f 2 <<<"$stages" | sed '/^$/d' | sort -u)
        if [[ -z "$conflicts" ]]; then
            echo "land:   ${ids[i]}: merges clean"
        elif [[ "$conflicts" == CHANGELOG.md ]]; then
            for s in 1 2 3; do
                blob=$(awk -v s="$s" -F '[ \t]' '$3 == s && $4 == "CHANGELOG.md" { print $2 }' <<<"$stages")
                if [[ -z "$blob" ]]; then
                    echo "land:   ${ids[i]}: REFUSE: CHANGELOG.md is missing on one side (stage $s)"
                    refuse=1
                    continue 2
                fi
                G cat-file blob "$blob" >"$tmp/$s"
            done
            if why=$(union_changelog "$tmp/1" "$tmp/2" "$tmp/3" "$tmp/union"); then
                echo "land:   ${ids[i]}: CHANGELOG.md conflicts: would keep both sides' entries"
                # The next prediction builds on the resolved CHANGELOG, as the
                # real run does (a temporary index; loose objects only).
                mode=$(awk -F '[ \t]' '$3 == 2 && $4 == "CHANGELOG.md" { print $1 }' <<<"$stages")
                blob=$(G hash-object -w "$tmp/union")
                GIT_INDEX_FILE="$tmp/index" git -C "$worktree" read-tree "$tree"
                GIT_INDEX_FILE="$tmp/index" git -C "$worktree" update-index --cacheinfo "$mode,$blob,CHANGELOG.md"
                tree=$(GIT_INDEX_FILE="$tmp/index" git -C "$worktree" write-tree)
            else
                echo "land:   ${ids[i]}: REFUSE: $why"
                refuse=1
            fi
        else
            echo "land:   ${ids[i]}: REFUSE: conflicts in" $conflicts
            refuse=1
        fi
        prev=$(G commit-tree "$tree" -p "$prev" -p "refs/heads/$b" -m "land dry run")
    done
    echo "land: then: ci-steps all; wait for ${mem_min_gb} GB free; cdo-gate $cdo_ws; merge-and-push $landing only with --push"
    if ((refuse)); then
        echo "land: DRY RUN: a real run would refuse"
        exit 1
    fi
    echo "land: DRY RUN: a real run would merge every branch"
    exit 0
fi

# ---- run ---------------------------------------------------------------
run="$logs_root/$(date -u +%Y%m%dT%H%M%SZ)-${landing#landing/}-$$"
mkdir -p "$run" "$(dirname "$flow_log")"
run_id=$(basename "$run")
issue=$(IFS=,; echo "${ids[*]}")
echo "land: logs in $run"
mark() { # mark <step> start|end [exit]
    jq -nc --arg ts "$(date -u +%FT%TZ)" --arg issue "$issue" --arg run "$run_id" \
        --arg phase "$1" --arg event "$2" --arg rc "${3:-}" \
        '{ts: $ts, issue: $issue, step: "land", run_id: $run, phase: $phase, event: $event}
         + (if $rc == "" then {} else {rc: ($rc | tonumber)} end)' >>"$flow_log"
}
verdict() { # verdict <step> <exit> <start>
    local secs=$((SECONDS - $3))
    mark "$1" end "$2"
    echo "$1 $2 $secs" >>"$run/verdict"
    if (($2 == 0)); then
        echo "land: [$1] ok ($secs s)"
    else
        echo "land: [$1] FAILED, exit $2 ($secs s; log $run/$1.log)"
    fi
}

# merge
start=$SECONDS
mark merge start
merge_failed() { # back to a clean, detached master, then stop
    trap - INT TERM
    # A trap can fire inside a command whose output goes to merge.log: the
    # verdict belongs on the terminal.
    exec 1>&7 2>&8
    G merge --abort >/dev/null 2>&1 || true
    G switch --quiet --force --detach "$master" >/dev/null 2>&1 || true
    verdict merge 1 "$start"
    die "$1; no landing branch was made"
}
trap 'merge_failed "interrupted"' INT TERM
G switch --quiet --detach "$master" >>"$run/merge.log" 2>&1 \
    || merge_failed "cannot check out master in $worktree"
for ((i = 0; i < ${#branches[@]}; i++)); do
    b=${branches[i]} msg="landing: ${ids[i]}"
    before=$(G rev-parse HEAD) || merge_failed "cannot read HEAD"
    if G -c core.commentChar=';' merge --no-ff --no-edit -m "$msg" "refs/heads/$b" >>"$run/merge.log" 2>&1; then
        if [[ "$(G rev-parse HEAD)" == "$before" ]]; then
            echo "land:   ${ids[i]}: already in the landing (an earlier branch holds it); no commit"
        else
            echo "land:   ${ids[i]}: merged"
        fi
        continue
    fi
    conflicts=$(G diff --name-only --diff-filter=U) || merge_failed "cannot list the conflicts"
    [[ -n "$conflicts" ]] || merge_failed "merging '$b' failed without a conflict (see $run/merge.log)"
    [[ "$conflicts" == CHANGELOG.md ]] || merge_failed "merging '$b' conflicts in: $(echo $conflicts)"
    for stage in 1 2 3; do
        G show ":$stage:CHANGELOG.md" >"$run/CHANGELOG.$stage" 2>>"$run/merge.log" \
            || merge_failed "CHANGELOG.md is missing on one side of the '$b' merge (stage $stage)"
    done
    why=$(union_changelog "$run/CHANGELOG.1" "$run/CHANGELOG.2" "$run/CHANGELOG.3" "$run/CHANGELOG.union") \
        || merge_failed "merging '$b': $why"
    cp "$run/CHANGELOG.union" "$worktree/CHANGELOG.md" || merge_failed "cannot write CHANGELOG.md"
    G add CHANGELOG.md || merge_failed "cannot stage CHANGELOG.md"
    G -c core.commentChar=';' commit --quiet -m "$msg" >>"$run/merge.log" 2>&1 \
        || merge_failed "committing the '$b' merge failed (see $run/merge.log)"
    echo "land:   ${ids[i]}: merged (CHANGELOG.md: both sides' entries kept)"
done
trap - INT TERM
landed=$(G rev-parse HEAD)
# The branch only now, with no hook in between (`switch -c` runs post-checkout
# after it made the branch): a refusal above leaves no branch.
G branch "$landing" "$landed" >>"$run/merge.log" 2>&1 \
    || { verdict merge 1 "$start"; die "cannot create $landing; the worktree is on the merged commit ${landed:0:8}"; }
G symbolic-ref HEAD "refs/heads/$landing"
verdict merge 0 "$start"

# recheck <after>: the gated tree is still the one merge-and-push would land.
recheck() {
    local why="" now
    now=$(G rev-parse HEAD 2>/dev/null) || now=""
    if [[ "$now" != "$landed" ]]; then
        why="the gate worktree moved off the landing commit ${landed:0:8} (now ${now:0:8})"
    elif [[ "$(G rev-parse -q --verify "refs/heads/$landing" || true)" != "$landed" ]]; then
        why="$landing no longer points at ${landed:0:8}"
    elif ! now=$(G status --porcelain); then
        why="git status failed in the gate worktree"
    elif [[ -n "$(grep -v '^?? \.agent/' <<<"$now" || true)" ]]; then
        why="the gate worktree is no longer clean"
    elif [[ "$(G rev-parse refs/heads/master)" != "$master" ]]; then
        why="master moved during the gates (${master:0:8} -> $(G rev-parse --short refs/heads/master)): land again on the new master"
    fi
    if [[ -n "$why" ]]; then
        echo "recheck after $1: $why" >>"$run/verdict"
        die "FAIL after $1: $why; nothing pushed ($landing kept)"
    fi
}

# ci
start=$SECONDS
mark ci start
rc=0
(cd "$worktree" && bash scripts/ci-steps all) >"$run/ci.log" 2>&1 7>&- 8>&- 9>&- || rc=$?
verdict ci "$rc" "$start"
((rc == 0)) || die "FAIL at ci: cdo-gate not run, nothing pushed ($landing kept)"
recheck ci

# mem-wait
start=$SECONDS
mark mem-wait start
rc=0
if ((mem_min_gb > 0)); then
    deadline=$((SECONDS + mem_timeout))
    while :; do
        avail_kb=$(awk '/^MemAvailable:/ { print $2 }' /proc/meminfo)
        # A running gate is `bash <path>/cdo-gate ...` (its shebang), not any
        # command line that merely mentions it.
        other=$(pgrep -f '^(/usr)?(/bin/)?bash [^ ]*scripts/cdo-gate( |$)' || true)
        if ((avail_kb >= mem_min_gb * 1048576)) && [[ -z "$other" ]]; then
            echo "MemAvailable $((avail_kb >> 20)) GB, no other cdo-gate" >"$run/mem-wait.log"
            break
        fi
        if ((SECONDS >= deadline)); then
            echo "gave up: MemAvailable $((avail_kb >> 20)) GB (need $mem_min_gb), other cdo-gate: ${other:-none}" >"$run/mem-wait.log"
            rc=1
            break
        fi
        sleep 15
    done
fi
verdict mem-wait "$rc" "$start"
((rc == 0)) || die "FAIL at mem-wait: cdo-gate not run, nothing pushed ($landing kept)"

# cdo
start=$SECONDS
mark cdo start
rc=0
(cd "$worktree" && bash scripts/cdo-gate "$cdo_ws") >"$run/cdo.log" 2>&1 7>&- 8>&- 9>&- || rc=$?
verdict cdo "$rc" "$start"
((rc == 0)) || die "FAIL at cdo: nothing pushed ($landing kept)"
recheck cdo

if ((!push)); then
    echo "land: PASS: $landing is gated; to land it: cd $main && scripts/merge-and-push $landing"
    exit 0
fi

# push
start=$SECONDS
mark push start
rc=0
# MERGE_EXPECT_MASTER: merge-and-push refuses if master moved after the last
# recheck (it would merge into a tree no gate saw).
(cd "$main" && MERGE_EXPECT_MASTER="$master" scripts/merge-and-push "$landing") \
    >"$run/push.log" 2>&1 7>&- 8>&- 9>&- || rc=$?
verdict push "$rc" "$start"
((rc == 0)) || die "FAIL at push: see $run/push.log"
echo "land: PASS: $landing landed on master"
