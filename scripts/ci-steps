#!/usr/bin/env bash
# scripts/ci-steps — the EXACT commands CI runs, in one place.
#
# `.github/workflows/ci.yml` calls this script rather than inlining command
# strings, so a local run and a CI run cannot drift. Before this existed they
# had: CLAUDE.md and every local session used
# `cargo clippy --all-targets --all-features` while CI used
# `--release --all-targets --all-features -- -D warnings`, and the gap was
# found only after CI had been red for two days.
#
# ⟨final-review.md I-4⟩ "The exact commands" is true of argv, not of the
# environment: every step except `fmt` needs `TREE_SITTER_AL_PATH` — CI
# supplies it via a per-step `env:` block (`ci.yml:44,57,62,67,72`); locally
# it defaults to the `tree-sitter-al/` clone at the repo root, same as
# `al-syntax`'s `build.rs` and `xtask gen-syntax`. That clone is gitignored, so
# a git worktree has none (CLAUDE.md Prerequisites) and the default resolves to
# nothing there.
# `require_grammar` below checks the effective path before compiling anything,
# so the failure is this script's own message, not a `cc` build error over a
# missing `parser.c`.
#
# Usage: scripts/ci-steps <step>
#   fmt | clippy | clippy-dev | gen-syntax | test | build | perf-bounds | agentflow
#   task   — the per-task gate: fmt, clippy-dev, gen-syntax, test
#   task-affected — `task` with only the tests the changed paths can reach (inner loop)
#   all    — what CI runs, plus `agentflow` (CI cannot); with scripts/cdo-gate it is the branch gate
set -uo pipefail

# ⟨2026-11-05⟩ Drop a git hook's repository variables (`GIT_DIR`,
# `GIT_INDEX_FILE`, ...) before anything runs: with them, a test's
# `git -C <tmp> commit` writes into the committer's repository. This script's
# own git calls (`--show-toplevel`, `diff`, `merge-base`, `tree-stamp`) then
# find the repository by the ordinary search from the current folder, which is
# the checkout's top when a hook or a person starts it there.
# shellcheck disable=SC2046
unset $(git rev-parse --local-env-vars 2>/dev/null)

step="${1:-}"

# Effective grammar dir: TREE_SITTER_AL_PATH if set (CI always sets it; a
# worktree session usually points it at the main checkout's copy), else the
# repo-root clone default — mirrors `build.rs`'s own fallback exactly.
grammar_dir() {
    if [ -n "${TREE_SITTER_AL_PATH:-}" ]; then
        printf '%s' "$TREE_SITTER_AL_PATH"
    else
        printf '%s' "$(git rev-parse --show-toplevel)/tree-sitter-al"
    fi
}

# Steps that compile against the grammar call this first so a missing
# checkout fails with a pointer to the fix instead of a cryptic `cc` error.
require_grammar() {
    local dir
    dir="$(grammar_dir)"
    if [ ! -f "$dir/src/node-types.json" ]; then
        echo "ci-steps: no tree-sitter-al grammar checkout at $dir/src/node-types.json" >&2
        echo "  Set TREE_SITTER_AL_PATH to an already-checked-out tree-sitter-al/ (e.g. the" >&2
        echo "  main checkout's), or clone it at the repo root:" >&2
        echo "  git clone https://github.com/SShadowS/tree-sitter-al. See CLAUDE.md Prerequisites." >&2
        return 1
    fi
}

# No silent fallback to `cargo test`: local and CI must run the same runner.
require_nextest() {
    cargo nextest --version >/dev/null 2>&1 && return 0
    echo "ci-steps: cargo-nextest is required (cargo install cargo-nextest --locked)" >&2
    return 1
}

# A zero RLIMIT_RTTIME makes the kernel SIGKILL test processes at random; the
# script says why (2026-10-27).
require_rttime() { "$(dirname "$0")/require-rttime"; }

# `-p al-sem -p al-sem-benches`: the root package and the benches, which moved to
# their own package on 2026-10-20 (`benches/Cargo.toml`). Without the second `-p`
# a root-package run would no longer format or lint the bench sources.
LINT_PKGS=(-p al-sem -p al-sem-benches)

run_fmt() { cargo fmt --check "${LINT_PKGS[@]}"; }

# ⟨2026-11-15⟩ The orchestrator executor's own tests (scripts/agentflow/tests, pytest).
# No gate ran them before, and two sat red on master unseen (TLS-71). They run
# in `all` only: ~1.5-2 min, too slow for every task. CI does not run them (its
# runner has no pytest), so `all` is their one gate.
require_pytest() {
    python3 -m pytest --version >/dev/null 2>&1 && return 0
    echo "ci-steps: python3 with pytest is required for the agentflow suite (python3 -m pip install pytest)" >&2
    return 1
}

run_agentflow() {
    require_pytest || return 1
    (cd "$(git rev-parse --show-toplevel)/scripts" && python3 -m pytest -q -p no:cacheprovider agentflow/tests)
}

run_clippy() { require_grammar || return 1; cargo clippy "${LINT_PKGS[@]}" --release --all-targets --all-features -- -D warnings; }

# The task-gate lint: the SAME lints and `-D warnings` as `run_clippy`, but in
# the dev profile. The release profile disables incremental compilation, so every
# `clippy --release` re-checks the whole crate from scratch; the dev profile
# reuses its previous work (21 s warm vs minutes).
#
# Debug assertions are switched OFF so this sees the same `cfg` CI's release lint
# sees. With them on, code that only a `#[cfg(debug_assertions)]` test uses looks
# used here and "never used" in CI: that exact lint broke CI on 2026-10-04 right
# after a green task gate. `all` — the branch gate and what CI runs — still keeps
# the exact release bar.
run_clippy_dev() {
    require_grammar || return 1
    CARGO_PROFILE_DEV_DEBUG_ASSERTIONS=false cargo clippy "${LINT_PKGS[@]}" --all-targets --all-features -- -D warnings
}

# NOTE: cannot run from a git worktree with no grammar checkout — the grammar
# clone is gitignored, so a worktree has none and `tree-sitter-al/src/node-types.json` is
# absent. Run it in the main checkout, or point TREE_SITTER_AL_PATH at an
# already-checked-out grammar (e.g. the main checkout's) — see CLAUDE.md
# Prerequisites.
run_gen_syntax() {
    cargo run -p xtask -- gen-syntax || return 1
    git diff --exit-code -- crates/al-syntax/src/raw/generated
}

# The whole suite, ONCE, with the CDO workspace switched off. The CDO-gated tests
# skip when `CDO_WS` is unset; with it set they run against the real workspace
# in DEBUG mode, which cost ~6 minutes per run (`abi_ingestion_integrity_cdo_gate`
# alone took 243 s) and doubled again in `check-goldens`. `scripts/cdo-gate` is the
# one runner for them (optimized build, `ENFORCE_CDO_WS=1`), so unsetting here
# loses no coverage. `REGEN_TEMP_GOLDENS` is unset too: a regen run passes
# trivially, and this run's green result is recorded as a stamp (below) that lets
# the pre-commit hook skip re-running the golden targets on the identical tree.
#
# The stamp is taken BEFORE the run and written only if the run is green AND the
# tree did not change while it ran, so it always names a tree that was tested.
#
# nextest, then the doc-tests (nextest does not run them). Measured 2026-10-18,
# warm tree, 3430 tests on both runners: 46-50 s against 81-104 s for `cargo test`.
run_test() {
    require_grammar || return 1
    require_nextest || return 1
    require_rttime || return 1
    local stamp_before stamp_after stamp_file
    stamp_before="$("$(dirname "$0")/tree-stamp")" || return 1
    env -u CDO_WS -u ENFORCE_CDO_WS -u REGEN_TEMP_GOLDENS cargo nextest run --workspace || return 1
    # ⟨TLS-11⟩ A warning only: a long test with no nextest priority (the run's JUnit report).
    "$(dirname "$0")/nextest-priority-check" || true
    env -u CDO_WS -u ENFORCE_CDO_WS -u REGEN_TEMP_GOLDENS cargo test --workspace --doc || return 1
    stamp_after="$("$(dirname "$0")/tree-stamp")" || return 0
    if [[ "$stamp_before" == "$stamp_after" ]]; then
        stamp_file="$("$(dirname "$0")/tree-stamp" --path)"
        printf '%s\n' "$stamp_before" > "$stamp_file"
    fi
}

# ⟨2026-10-20⟩ The per-TASK inner loop: the nextest filterset the changed paths can
# reach, from a coarse, explicit map. The al-sem lib tests always run. Any path the
# map does not know (tests/common, a fixture or golden dir, Cargo.*, scripts, src/
# outside the mapped modules, ...) selects the WHOLE suite, the safe direction.
# Prose (docs/, *.md) selects nothing. Changed = against the merge base with
# origin/master, plus staged, unstaged and untracked files.
# This is NOT a gate: the whole suite still runs in `task` (before the final panel)
# and `all` (before the merge), and only those write the gate stamp.
affected_filter() {
    local f expr="" all=0
    add() { case "|$expr|" in *"|$1|"*) ;; *) expr="${expr:+$expr|}$1" ;; esac; }
    while IFS= read -r f; do
        [ -z "$f" ] && continue
        case "$f" in
            docs/*|*.md) ;;
            crates/al-syntax/*) add 'binary(l2_ir)'; add 'binary(gap)'; add 'package(al-syntax)'; add 'binary(differential)' ;;
            src/program/resolve/*|src/program/build*|src/snapshot/*)
                add 'binary(program_resolve_harness)'; add 'binary(differential)'; add 'binary(lsp)'; add 'binary(r3)'; add 'binary(r4)' ;;
            src/engine/l4/*|src/engine/l5/*)
                add 'binary(r4)'; add 'binary(r3)'; add 'binary(cli)'; add 'binary(l4_summary_differential)' ;;
            src/bin/*|src/engine/gate/*) add 'binary(cli)' ;;
            src/lsp/*|src/server.rs|src/watcher.rs) add 'binary(lsp)' ;;
            tests/cli/*|tests/gap/*|tests/l2_ir/*|tests/lsp/*|tests/r25_abi/*|tests/r3/*|tests/r4/*|tests/temp_state/*)
                f="${f#tests/}"; add "binary(${f%%/*})" ;;
            tests/differential.rs|tests/l4_summary_differential.rs|tests/program_resolve_harness.rs|tests/perf_bounds.rs)
                f="${f#tests/}"; add "binary(${f%.rs})" ;;
            benches/*) ;;
            *) all=1 ;;
        esac
    done
    if [ "$all" = 1 ]; then echo "ALL"; else echo "$expr"; fi
}

run_task_affected() {
    require_grammar || return 1
    require_nextest || return 1
    require_rttime || return 1
    local base filter
    base="$(git merge-base HEAD origin/master 2>/dev/null)" || base="HEAD"
    filter="$( { git diff --name-only "$base"; git diff --name-only --cached; git ls-files --others --exclude-standard; } | sort -u | affected_filter)"
    if [ "$filter" = "ALL" ]; then
        echo "ci-steps: task-affected: a change outside the map -> the whole suite"
        env -u CDO_WS -u ENFORCE_CDO_WS -u REGEN_TEMP_GOLDENS cargo nextest run --workspace
        return
    fi
    # ⟨2026-11-10, crate split Phase 1⟩ Build only what the filter runs. With `--workspace`,
    # `-E` chose which tests RAN but every test binary was still BUILT. The targets below
    # are exactly the filter's: the al-sem lib tests, `--test X` per `binary(X)`, and the
    # al-syntax package for `package(al-syntax)`; `-E` still filters within them.
    local targets=(-p al-sem --lib) part
    for part in $(grep -oE '(binary|package)\([a-z0-9_-]+\)' <<<"$filter"); do
        case "$part" in
            binary\(*) part="${part#binary(}"; targets+=(--test "${part%)}") ;;
            'package(al-syntax)') targets+=(-p al-syntax) ;;
            *) echo "ci-steps: task-affected: no build target for '$part' -> the whole suite"
               env -u CDO_WS -u ENFORCE_CDO_WS -u REGEN_TEMP_GOLDENS cargo nextest run --workspace
               return ;;
        esac
    done
    filter="package(al-sem) & kind(lib)${filter:+ | $filter}"
    echo "ci-steps: task-affected: $filter"
    echo "ci-steps: task-affected: builds ${targets[*]}"
    env -u CDO_WS -u ENFORCE_CDO_WS -u REGEN_TEMP_GOLDENS cargo nextest run "${targets[@]}" -E "$filter"
}

# ⟨2026-11-12, TLS-09⟩ The gate's optimized build is `release-fast` (thin LTO, 4 codegen
# units), not `--release` (fat LTO, one codegen unit): 200 s against 636 s on server1,
# where `--release` was the landing gate's critical path by ~6.5 min. It still unwinds
# and has no debug assertions, so `perf_bounds`' checks compile in and the pair shares
# artifacts. The SHIPPED profile (`release-ship`, fat LTO, abort) is built on every code
# push to master by `.github/workflows/build-and-deploy.yml` (Windows, Linux, macOS),
# so a fat-LTO-only failure shows there, after the merge and before any tag.
# Note: docs/superpowers/notes/2026-11-12-gate-release-build.md.
GATE_PROFILE=release-fast

# ⟨ENG-110⟩ Every binary that installs the IR cache (alsem, aldump, al-call-hierarchy)
# must be a self-contained producer with the IR image marker (scripts/check-ir-image),
# on Linux, where the cache is on.
run_build() {
    require_grammar || return 1
    cargo build --profile "$GATE_PROFILE" || return 1
    if [[ "$(uname -s)" == Linux ]]; then
        local top b rc=0
        top="${CARGO_TARGET_DIR:-$(git rev-parse --show-toplevel)/target}"
        for b in alsem aldump al-call-hierarchy; do
            "$(dirname "$0")/check-ir-image" "$top/$GATE_PROFILE/$b" || rc=1
        done
        return "$rc"
    fi
}

# ⟨TLS-108⟩ `perf_bounds` asserts wall-time bounds, so a build beside it fails a
# correct tree (2026-11-20: two landings failed here while a lane built two
# release-fast trees; host CPU pressure ~57 %). Like cdo-speed (TLS-89), it builds
# first, untimed, then marks the CDO slot's hold TIMED for the run of the test
# binary: cdo-slot waits for the builds already running (and refuses, exit 6, when
# they do not end), and the guard refuses new ones. Inside a hold (land's or
# cdo-gate's token, `cdo-slot run`, a hand hold) it shares it; outside any it takes
# the slot itself, waiting its turn. Bound to this process: the mark ends with it.
# The verdict is the test's; a suspend or CPU stall during the run is labelled
# (SUSPENDED, UNDER LOAD), never hidden and never excused (the same bounds judge).
# Where no slot can be held (GitHub CI runs this step on a hosted runner, which has
# no `/work`; the Windows machine has no `flock`), it runs with no hold and says
# so: the slot exists to keep a shared host's other lanes away, and those hosts
# have none (review r1, Fable and sol: holding it there failed or hung CI).
# Test hook: CI_STEPS_PERF_BOUNDS_BIN, a binary run instead of the built test
# (no build); CI_STEPS_CPU_PRESSURE_FILE, a file read instead of the cgroup's
# cpu.pressure; CDO_HOST_SUSPENDED_FILE as scripts/host-suspended reads it.
# test-hooks: CI_STEPS_PERF_BOUNDS_BIN CI_STEPS_CPU_PRESSURE_FILE
PERF_BOUNDS_LOADED_SHARE=15

# ⟨TLS-113⟩ The timing tests (`mod release_checks`) exist only without debug
# assertions: an inherited CARGO_PROFILE_RELEASE_FAST_DEBUG_ASSERTIONS=true (or
# any build-shape override) compiled every one out, and the step passed on the
# two tests left (review r2, sol). The binary must list exactly as many
# `release_checks::` tests as the source declares (`#[test]` lines after `mod
# release_checks`), and none of its tests may be ignored; the run has no filter.
perf_bounds_incomplete() { # <binary>; prints why, or nothing when complete
    local src want listed ignored
    src="$(git rev-parse --show-toplevel)/tests/perf_bounds.rs"
    want="$(awk '/^mod release_checks/ { m = 1 } m && /^[[:space:]]*#\[test\]$/ { n++ } END { print n + 0 }' "$src")"
    listed="$("$1" --list --format terse)" || { echo "the binary's --list failed"; return; }
    ignored="$("$1" --list --format terse --ignored)" || { echo "the binary's --list --ignored failed"; return; }
    listed="$(grep -c '^release_checks::.*: test$' <<<"$listed" || true)"
    ignored="$(grep -c ': test$' <<<"$ignored" || true)"
    if ((want == 0)); then
        echo "tests/perf_bounds.rs declares no timing test"
    elif ((listed != want)); then
        echo "the binary has ${listed} of the ${want} timing tests (release_checks): built with debug assertions, or another build override?"
    elif ((ignored != 0)); then
        echo "${ignored} of its tests are ignored"
    fi
}

# "<stall total, µs> <source>": this cgroup's CPU stall (`some total=`), else the
# host's; nothing when neither is readable. The source is named in the label.
cpu_stall_us() {
    local f src
    for f in "${CI_STEPS_CPU_PRESSURE_FILE:-}" /sys/fs/cgroup/cpu.pressure /proc/pressure/cpu; do
        [ -n "$f" ] && [ -r "$f" ] || continue
        case "$f" in
            /proc/pressure/cpu) src="the host's" ;;
            *) src="this cgroup's" ;;
        esac
        printf '%s %s\n' "$(sed -n 's/^some .*total=\([0-9]*\).*/\1/p' "$f" | head -n 1)" "$src"
        return 0
    done
}

# Why no slot can be held here, or nothing when one can.
perf_bounds_no_slot() {
    if [ "${GITHUB_ACTIONS:-}" = true ]; then
        echo "a GitHub Actions runner"
    elif ! command -v flock >/dev/null 2>&1; then
        echo "no flock on this host"
    elif ! mkdir -p "${CDO_SLOT_DIR:-/work/.al-sem/cdo-slot}" 2>/dev/null; then
        echo "no slot folder (${CDO_SLOT_DIR:-/work/.al-sem/cdo-slot})"
    fi
}

run_perf_bounds() {
    local bin="${CI_STEPS_PERF_BOUNDS_BIN:-}"
    if [ -z "$bin" ]; then
        require_grammar || return 1
        require_rttime || return 1
        bin="$(cargo test --profile "$GATE_PROFILE" --test perf_bounds --no-run \
            --message-format=json-render-diagnostics \
            | jq -r 'select(.profile.test == true and .target.name == "perf_bounds") | .executable' \
            | tail -n 1)" || return 1
        if [ ! -x "$bin" ]; then
            echo "ci-steps: perf-bounds: the test binary was not built" >&2
            return 1
        fi
    fi
    local incomplete
    incomplete="$(perf_bounds_incomplete "$bin")"
    if [ -n "$incomplete" ]; then
        echo "ci-steps: perf-bounds: the timing tests would not run: ${incomplete}" >&2
        return 1
    fi
    local rc=0 no_slot label=""
    no_slot="$(perf_bounds_no_slot)"
    if [ -n "$no_slot" ]; then
        label+=" (no CDO slot held: ${no_slot})"
    else
        # No memory floor: the step needs none, and a floor made it wait for the
        # slot with no end on a small machine (review r1, Fable; land passes 0 too).
        CDO_SLOT_MEM_MIN_GB=0 bash "$(dirname "$0")/cdo-slot" acquire \
            "${CDO_SLOT_OWNER:-perf-bounds}" "perf-bounds timing" \
            --wait --bind "$$" --timed || rc=$?
        case "$rc" in
            0 | 4) ;;
            6)
                echo "ci-steps: perf-bounds: the timed hold was refused (scripts/cdo-slot --timed exit 6: builds still ran, or the hold ended): timed nothing" >&2
                return 1
                ;;
            *)
                echo "ci-steps: perf-bounds: the timed CDO slot hold was not taken (cdo-slot exit $rc)" >&2
                return 1
                ;;
        esac
    fi
    local susp0 susp1 stall0 stall1 src t0 t1 prc=0
    # Each read cut after 5 s, KILL 1 s later (TLS-105 review r3): never a stall.
    susp0="$(timeout -k 1 5 "$(dirname "$0")/host-suspended" 2>/dev/null)" || susp0=""
    read -r stall0 src < <(cpu_stall_us)
    t0=${EPOCHREALTIME//[!0-9]/}
    # From the repository's top, as `cargo test` runs a test binary.
    (cd "$(git rev-parse --show-toplevel)" && "$bin") || prc=$?
    t1=${EPOCHREALTIME//[!0-9]/}
    read -r stall1 _ < <(cpu_stall_us)
    susp1="$(timeout -k 1 5 "$(dirname "$0")/host-suspended" 2>/dev/null)" || susp1=""
    local wall_us=$((t1 - t0)) slept_s=0 awake_us
    if [[ "$susp0" =~ ^[0-9]+$ && "$susp1" =~ ^[0-9]+$ ]]; then
        slept_s=$((susp1 - susp0))
    fi
    # The share is of awake time: a suspend stalls nothing and must not dilute it.
    awake_us=$((wall_us - slept_s * 1000000))
    if [[ ! "${stall0:-}" =~ ^[0-9]+$ || ! "${stall1:-}" =~ ^[0-9]+$ ]]; then
        label+=" (CPU pressure not readable: load not checked)"
    elif ((awake_us <= 0)); then
        # Whole seconds of suspend can cover a short run (review r2, Fable).
        label+=" (load not checked: the host slept through the run)"
    else
        local stalled=$((stall1 - stall0))
        # Compared before rounding: 15.99 % is above 15 % (review r1, sol).
        if ((stalled * 100 > PERF_BOUNDS_LOADED_SHARE * awake_us)); then
            label+=" UNDER LOAD: ${src} CPU stall share was $((stalled * 100 / awake_us)) % (above ${PERF_BOUNDS_LOADED_SHARE} %)"
        else
            label+=" (${src} CPU stall share $((stalled * 100 / awake_us)) %)"
        fi
    fi
    if ((slept_s >= 1)); then
        label+=" SUSPENDED: the host slept ${slept_s} s during the timing"
    elif [[ ! "$susp0" =~ ^[0-9]+$ || ! "$susp1" =~ ^[0-9]+$ ]]; then
        label+=" (suspend not readable)"
    fi
    echo "ci-steps: perf-bounds timing: $((wall_us / 1000)) ms, exit ${prc};${label}"
    return "$prc"
}

# ⟨2026-11-07⟩ A record that a WHOLE `task` or `all` run passed, so
# `scripts/merge-and-push` can skip re-running the task gate when the merge it
# makes has exactly the tree that passed (the owner approved this on 2026-11-07:
# one landing ran the whole suite 4-6 times on identical trees). The record is a
# file named after the tree hash, in the git directory every worktree shares, so
# a gate run in an integration worktree counts when the main checkout lands it.
# It is written only when the work tree was CLEAN before and after the run (no
# tracked change, and no untracked file outside .gitignore): then the run saw
# exactly HEAD's tree and nothing else. A run with an untracked file that the
# commit would leave out records nothing, so a skip can never miss a file.
clean_tree_id() {
    [ -z "$(git status --porcelain --untracked-files=normal)" ] || return 1
    git rev-parse 'HEAD^{tree}'
}

record_gate_pass() { # <step> <tree id taken before the run>
    local after dir
    after="$(clean_tree_id)" || return 0
    [ "$after" = "$2" ] || return 0
    dir="$(git rev-parse --path-format=absolute --git-common-dir)/gate-passed"
    mkdir -p "$dir" && printf '%s %s\n' "$1" "$(date -Iseconds)" > "$dir/$2"
}

case "$step" in
    fmt)         run_fmt ;;
    clippy)      run_clippy ;;
    clippy-dev)  run_clippy_dev ;;
    gen-syntax)  run_gen_syntax ;;
    test)        run_test ;;
    build)       run_build ;;
    perf-bounds) run_perf_bounds ;;
    agentflow)   run_agentflow ;;
    # The per-task gate (CLAUDE.md "Test tiers"): everything that can fail on a
    # normal change, fast. No release builds; dev-profile clippy; the whole test
    # suite once (it includes every golden target, so `check-goldens` is not a
    # separate step). Run before every commit/task.
    task-affected-tests) run_task_affected ;;
    # The per-task inner loop (`/issue` step 8): `task` with only the tests the
    # change can reach. The whole suite still runs in `task` and `all`.
    task-affected)
        rc=0
        for s in fmt clippy-dev gen-syntax task-affected-tests; do
            echo "=== ci-steps: $s ==="
            if ! "$0" "$s"; then
                echo "ci-steps: FAILED at '$s'" >&2
                rc=1
            fi
        done
        exit "$rc"
        ;;
    task)
        rc=0
        tree_before="$(clean_tree_id)" || tree_before=""
        for s in fmt clippy-dev gen-syntax test; do
            echo "=== ci-steps: $s ==="
            if ! "$0" "$s"; then
                echo "ci-steps: FAILED at '$s'" >&2
                rc=1
            fi
        done
        if [[ "$rc" -eq 0 && -n "$tree_before" ]]; then record_gate_pass task "$tree_before"; fi
        exit "$rc"
        ;;
    # What CI runs, plus `agentflow` (see `run_agentflow`). Part of the branch gate (with `scripts/cdo-gate`),
    # run once before a merge, not on every task.
    #
    # ⟨2026-10-20⟩ `build` (optimized: `$GATE_PROFILE`, see `run_build`) runs in the
    # background WHILE `test` (dev, all cores) runs; `perf-bounds` then runs alone,
    # after both, so its timings see an idle machine. The release pair uses its own
    # target dir (`<target>/gate-release`): two cargo builds in one target dir would
    # wait on each other's lock. Every step still runs and still decides `rc`; the
    # build's output is printed after the test output, under its own header.
    all)
        rc=0
        tree_before="$(clean_tree_id)" || tree_before=""
        for s in fmt clippy gen-syntax agentflow; do
            echo "=== ci-steps: $s ==="
            if ! "$0" "$s"; then
                echo "ci-steps: FAILED at '$s'" >&2
                rc=1
            fi
        done
        gate_release="${CARGO_TARGET_DIR:-$(git rev-parse --show-toplevel)/target}/gate-release"
        build_log="$(mktemp)"
        CARGO_TARGET_DIR="$gate_release" "$0" build > "$build_log" 2>&1 &
        build_pid=$!
        echo "=== ci-steps: test (release build running alongside) ==="
        if ! "$0" test; then
            echo "ci-steps: FAILED at 'test'" >&2
            rc=1
        fi
        build_rc=0
        wait "$build_pid" || build_rc=$?
        echo "=== ci-steps: build ==="
        cat "$build_log"
        rm -f "$build_log"
        if [[ "$build_rc" -ne 0 ]]; then
            echo "ci-steps: FAILED at 'build'" >&2
            rc=1
        fi
        echo "=== ci-steps: perf-bounds ==="
        if ! CARGO_TARGET_DIR="$gate_release" "$0" perf-bounds; then
            echo "ci-steps: FAILED at 'perf-bounds'" >&2
            rc=1
        fi
        if [[ "$rc" -eq 0 && -n "$tree_before" ]]; then record_gate_pass all "$tree_before"; fi
        exit "$rc"
        ;;
    *)
        echo "usage: scripts/ci-steps <fmt|clippy|clippy-dev|gen-syntax|test|build|perf-bounds|agentflow|task|task-affected|all>" >&2
        exit 2
        ;;
esac
