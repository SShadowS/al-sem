#!/usr/bin/env bash
# scripts/ci-steps — the EXACT commands CI runs, in one place.
#
# `.github/workflows/ci.yml` calls this script rather than inlining command
# strings, so a local run and a CI run cannot drift. Before this existed they
# had: CLAUDE.md and every local session used
# `cargo clippy --all-targets --all-features` while CI used
# `--release --all-targets --all-features -- -D warnings`, and the gap was
# found only after CI had been red for two days.
#
# ⟨final-review.md I-4⟩ "The exact commands" is true of argv, not of the
# environment: every step except `fmt` needs `TREE_SITTER_AL_PATH` — CI
# supplies it via a per-step `env:` block (`ci.yml:44,57,62,67,72`); locally
# it defaults to the `tree-sitter-al/` clone at the repo root, same as
# `al-syntax`'s `build.rs` and `xtask gen-syntax`. That clone is gitignored, so
# a git worktree has none (CLAUDE.md Prerequisites) and the default resolves to
# nothing there.
# `require_grammar` below checks the effective path before compiling anything,
# so the failure is this script's own message, not a `cc` build error over a
# missing `parser.c`.
#
# Usage: scripts/ci-steps <step>
#   fmt | clippy | clippy-dev | gen-syntax | test | build | perf-bounds
#   task   — the per-task gate: fmt, clippy-dev, gen-syntax, test
#   task-affected — `task` with only the tests the changed paths can reach (inner loop)
#   all    — exactly what CI runs; with scripts/cdo-gate it is the branch gate
set -uo pipefail

step="${1:-}"

# Effective grammar dir: TREE_SITTER_AL_PATH if set (CI always sets it; a
# worktree session usually points it at the main checkout's copy), else the
# repo-root clone default — mirrors `build.rs`'s own fallback exactly.
grammar_dir() {
    if [ -n "${TREE_SITTER_AL_PATH:-}" ]; then
        printf '%s' "$TREE_SITTER_AL_PATH"
    else
        printf '%s' "$(git rev-parse --show-toplevel)/tree-sitter-al"
    fi
}

# Steps that compile against the grammar call this first so a missing
# checkout fails with a pointer to the fix instead of a cryptic `cc` error.
require_grammar() {
    local dir
    dir="$(grammar_dir)"
    if [ ! -f "$dir/src/node-types.json" ]; then
        echo "ci-steps: no tree-sitter-al grammar checkout at $dir/src/node-types.json" >&2
        echo "  Set TREE_SITTER_AL_PATH to an already-checked-out tree-sitter-al/ (e.g. the" >&2
        echo "  main checkout's), or clone it at the repo root:" >&2
        echo "  git clone https://github.com/SShadowS/tree-sitter-al. See CLAUDE.md Prerequisites." >&2
        return 1
    fi
}

# No silent fallback to `cargo test`: local and CI must run the same runner.
require_nextest() {
    cargo nextest --version >/dev/null 2>&1 && return 0
    echo "ci-steps: cargo-nextest is required (cargo install cargo-nextest --locked)" >&2
    return 1
}

# `-p al-sem -p al-sem-benches`: the root package and the benches, which moved to
# their own package on 2026-10-20 (`benches/Cargo.toml`). Without the second `-p`
# a root-package run would no longer format or lint the bench sources.
LINT_PKGS=(-p al-sem -p al-sem-benches)

run_fmt() { cargo fmt --check "${LINT_PKGS[@]}"; }

run_clippy() { require_grammar || return 1; cargo clippy "${LINT_PKGS[@]}" --release --all-targets --all-features -- -D warnings; }

# The task-gate lint: the SAME lints and `-D warnings` as `run_clippy`, but in
# the dev profile. The release profile disables incremental compilation, so every
# `clippy --release` re-checks the whole crate from scratch; the dev profile
# reuses its previous work (21 s warm vs minutes).
#
# Debug assertions are switched OFF so this sees the same `cfg` CI's release lint
# sees. With them on, code that only a `#[cfg(debug_assertions)]` test uses looks
# used here and "never used" in CI: that exact lint broke CI on 2026-10-04 right
# after a green task gate. `all` — the branch gate and what CI runs — still keeps
# the exact release bar.
run_clippy_dev() {
    require_grammar || return 1
    CARGO_PROFILE_DEV_DEBUG_ASSERTIONS=false cargo clippy "${LINT_PKGS[@]}" --all-targets --all-features -- -D warnings
}

# NOTE: cannot run from a git worktree with no grammar checkout — the grammar
# clone is gitignored, so a worktree has none and `tree-sitter-al/src/node-types.json` is
# absent. Run it in the main checkout, or point TREE_SITTER_AL_PATH at an
# already-checked-out grammar (e.g. the main checkout's) — see CLAUDE.md
# Prerequisites.
run_gen_syntax() {
    cargo run -p xtask -- gen-syntax || return 1
    git diff --exit-code crates/al-syntax/src/raw/generated
}

# The whole suite, ONCE, with the CDO workspace switched off. The CDO-gated tests
# skip when `CDO_WS` is unset; with it set they run against the real workspace
# in DEBUG mode, which cost ~6 minutes per run (`abi_ingestion_integrity_cdo_gate`
# alone took 243 s) and doubled again in `check-goldens`. `scripts/cdo-gate` is the
# one runner for them (optimized build, `ENFORCE_CDO_WS=1`), so unsetting here
# loses no coverage. `REGEN_TEMP_GOLDENS` is unset too: a regen run passes
# trivially, and this run's green result is recorded as a stamp (below) that lets
# the pre-commit hook skip re-running the golden targets on the identical tree.
#
# The stamp is taken BEFORE the run and written only if the run is green AND the
# tree did not change while it ran, so it always names a tree that was tested.
#
# nextest, then the doc-tests (nextest does not run them). Measured 2026-10-18,
# warm tree, 3430 tests on both runners: 46-50 s against 81-104 s for `cargo test`.
run_test() {
    require_grammar || return 1
    require_nextest || return 1
    local stamp_before stamp_after stamp_file
    stamp_before="$("$(dirname "$0")/tree-stamp")" || return 1
    env -u CDO_WS -u ENFORCE_CDO_WS -u REGEN_TEMP_GOLDENS cargo nextest run --workspace || return 1
    env -u CDO_WS -u ENFORCE_CDO_WS -u REGEN_TEMP_GOLDENS cargo test --workspace --doc || return 1
    stamp_after="$("$(dirname "$0")/tree-stamp")" || return 0
    if [[ "$stamp_before" == "$stamp_after" ]]; then
        stamp_file="$("$(dirname "$0")/tree-stamp" --path)"
        printf '%s\n' "$stamp_before" > "$stamp_file"
    fi
}

# ⟨2026-10-20⟩ The per-TASK inner loop: the nextest filterset the changed paths can
# reach, from a coarse, explicit map. The al-sem lib tests always run. Any path the
# map does not know (tests/common, a fixture or golden dir, Cargo.*, scripts, src/
# outside the mapped modules, ...) selects the WHOLE suite, the safe direction.
# Prose (docs/, *.md) selects nothing. Changed = against the merge base with
# origin/master, plus staged, unstaged and untracked files.
# This is NOT a gate: the whole suite still runs in `task` (before the final panel)
# and `all` (before the merge), and only those write the gate stamp.
affected_filter() {
    local f expr="" all=0
    add() { case "|$expr|" in *"|$1|"*) ;; *) expr="${expr:+$expr|}$1" ;; esac; }
    while IFS= read -r f; do
        [ -z "$f" ] && continue
        case "$f" in
            docs/*|*.md) ;;
            crates/al-syntax/*) add 'binary(l2_ir)'; add 'binary(gap)'; add 'package(al-syntax)'; add 'binary(differential)' ;;
            src/program/resolve/*|src/program/build*|src/snapshot/*)
                add 'binary(program_resolve_harness)'; add 'binary(differential)'; add 'binary(lsp)'; add 'binary(r3)'; add 'binary(r4)' ;;
            src/engine/l4/*|src/engine/l5/*)
                add 'binary(r4)'; add 'binary(r3)'; add 'binary(cli)'; add 'binary(l4_summary_differential)' ;;
            src/bin/*|src/engine/gate/*) add 'binary(cli)' ;;
            src/lsp/*|src/server.rs|src/watcher.rs) add 'binary(lsp)' ;;
            tests/cli/*|tests/gap/*|tests/l2_ir/*|tests/lsp/*|tests/r25_abi/*|tests/r3/*|tests/r4/*|tests/temp_state/*)
                f="${f#tests/}"; add "binary(${f%%/*})" ;;
            tests/differential.rs|tests/l4_summary_differential.rs|tests/program_resolve_harness.rs|tests/perf_bounds.rs)
                f="${f#tests/}"; add "binary(${f%.rs})" ;;
            benches/*) ;;
            *) all=1 ;;
        esac
    done
    if [ "$all" = 1 ]; then echo "ALL"; else echo "$expr"; fi
}

run_task_affected() {
    require_grammar || return 1
    require_nextest || return 1
    local base filter
    base="$(git merge-base HEAD origin/master 2>/dev/null)" || base="HEAD"
    filter="$( { git diff --name-only "$base"; git diff --name-only --cached; git ls-files --others --exclude-standard; } | sort -u | affected_filter)"
    if [ "$filter" = "ALL" ]; then
        echo "ci-steps: task-affected: a change outside the map -> the whole suite"
        env -u CDO_WS -u ENFORCE_CDO_WS -u REGEN_TEMP_GOLDENS cargo nextest run --workspace
        return
    fi
    filter="package(al-sem) & kind(lib)${filter:+ | $filter}"
    echo "ci-steps: task-affected: $filter"
    env -u CDO_WS -u ENFORCE_CDO_WS -u REGEN_TEMP_GOLDENS cargo nextest run --workspace -E "$filter"
}

run_build() { require_grammar || return 1; cargo build --release; }

run_perf_bounds() { require_grammar || return 1; cargo test --release --test perf_bounds; }

case "$step" in
    fmt)         run_fmt ;;
    clippy)      run_clippy ;;
    clippy-dev)  run_clippy_dev ;;
    gen-syntax)  run_gen_syntax ;;
    test)        run_test ;;
    build)       run_build ;;
    perf-bounds) run_perf_bounds ;;
    # The per-task gate (CLAUDE.md "Test tiers"): everything that can fail on a
    # normal change, fast. No release builds; dev-profile clippy; the whole test
    # suite once (it includes every golden target, so `check-goldens` is not a
    # separate step). Run before every commit/task.
    task-affected-tests) run_task_affected ;;
    # The per-task inner loop (`/issue` step 8): `task` with only the tests the
    # change can reach. The whole suite still runs in `task` and `all`.
    task-affected)
        rc=0
        for s in fmt clippy-dev gen-syntax task-affected-tests; do
            echo "=== ci-steps: $s ==="
            if ! "$0" "$s"; then
                echo "ci-steps: FAILED at '$s'" >&2
                rc=1
            fi
        done
        exit "$rc"
        ;;
    task)
        rc=0
        for s in fmt clippy-dev gen-syntax test; do
            echo "=== ci-steps: $s ==="
            if ! "$0" "$s"; then
                echo "ci-steps: FAILED at '$s'" >&2
                rc=1
            fi
        done
        exit "$rc"
        ;;
    # Exactly what CI runs. Part of the branch gate (with `scripts/cdo-gate`),
    # run once before a merge, not on every task.
    #
    # ⟨2026-10-20⟩ `build` (release, LTO, mostly a single-threaded link) runs in the
    # background WHILE `test` (dev, all cores) runs; `perf-bounds` then runs alone,
    # after both, so its timings see an idle machine. The release pair uses its own
    # target dir (`<target>/gate-release`): two cargo builds in one target dir would
    # wait on each other's lock. Every step still runs and still decides `rc`; the
    # build's output is printed after the test output, under its own header.
    all)
        rc=0
        for s in fmt clippy gen-syntax; do
            echo "=== ci-steps: $s ==="
            if ! "$0" "$s"; then
                echo "ci-steps: FAILED at '$s'" >&2
                rc=1
            fi
        done
        gate_release="${CARGO_TARGET_DIR:-$(git rev-parse --show-toplevel)/target}/gate-release"
        build_log="$(mktemp)"
        CARGO_TARGET_DIR="$gate_release" "$0" build > "$build_log" 2>&1 &
        build_pid=$!
        echo "=== ci-steps: test (release build running alongside) ==="
        if ! "$0" test; then
            echo "ci-steps: FAILED at 'test'" >&2
            rc=1
        fi
        build_rc=0
        wait "$build_pid" || build_rc=$?
        echo "=== ci-steps: build ==="
        cat "$build_log"
        rm -f "$build_log"
        if [[ "$build_rc" -ne 0 ]]; then
            echo "ci-steps: FAILED at 'build'" >&2
            rc=1
        fi
        echo "=== ci-steps: perf-bounds ==="
        if ! CARGO_TARGET_DIR="$gate_release" "$0" perf-bounds; then
            echo "ci-steps: FAILED at 'perf-bounds'" >&2
            rc=1
        fi
        exit "$rc"
        ;;
    *)
        echo "usage: scripts/ci-steps <fmt|clippy|clippy-dev|gen-syntax|test|build|perf-bounds|task|task-affected|all>" >&2
        exit 2
        ;;
esac
