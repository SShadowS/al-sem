#!/usr/bin/env python3
"""scripts/claude-hooks/cdo-slot-guard: a Claude Code PreToolUse hook (Bash tool).

While another live session holds the CDO slot (scripts/cdo-slot), it refuses
this session's builds, tests, gates and CDO runs, naming the holder.

TLS-60. The owner wires it (e.g. .claude/settings.json `hooks.PreToolUse`, matcher
"Bash", command `<repo>/scripts/claude-hooks/cdo-slot-guard`). The command line is
read the way the shell reads it (quotes, heredoc bodies and comments are not
commands); every command in it is checked, after `cd ... &&`, `VAR=x`, shell
keywords (`if`, `!`, `{`, `do` ...) and wrappers (`nice`, `env`, `time`,
`timeout`, `taskset`, `stdbuf`, `xargs`, `nohup`, `setsid`; `bash -c`/`eval`
strings are read as command lines too). Guarded:
  cargo build/test/check/clippy/nextest/run/bench/install/rustc/doc/llvm-cov/miri
    (and the aliases b, t, c, r, d), after cargo's own flags and +toolchain;
  scripts/ci-steps, cdo-gate, check-goldens, cdo-speed, land, merge-and-push,
    intent-cdo-check, cdo-before-after, run by path (scripts/..., ./...) or
    through bash/sh/python, except their information modes (--help, --dry-run,
    --layout, --summary=..., --product-paths, `ci-steps fmt`);
  aldump / alsem, when the command line names the CDO workspace
    (/work/src/cdo-baseline, $CDO_WS or its value).
Allowed: everything else; any command while the slot is free, stale or this
session's. Its limits: it sees Bash calls only (an `alsem_*` MCP call on CDO is
not guarded), and a command it cannot parse is read word by word. A hook that
cannot read its input, or a `cdo-slot status` that fails, allows (and says so on
stderr), so a hook bug never stops every session.
Exit: 0 allow; 2 refuse (the message on stderr goes back to Claude).
"""

import json
import os
import re
import subprocess
import sys

SLOT = os.path.join(os.path.dirname(os.path.abspath(__file__)), "..", "cdo-slot")

CARGO_SUBS = {
    "build", "b", "test", "t", "check", "c", "clippy", "nextest", "run", "r",
    "bench", "install", "rustc", "doc", "d", "llvm-cov", "miri", "fix",
}
# cargo's global flags that take a value (`cargo --config x test`).
CARGO_VALUE_FLAGS = {"--config", "-Z", "-C", "--color"}
SCRIPTS = {
    "ci-steps", "cdo-gate", "check-goldens", "cdo-speed", "land", "merge-and-push",
    "intent-cdo-check", "cdo-before-after",
}
# The information modes each script really has, where it reads them (review
# r3, sol): cdo-gate and land parse every argument; ci-steps reads only its
# first (`ci-steps build --dry-run` builds).
INFO_ANYWHERE = {
    "cdo-gate": {"-h", "--help", "--dry-run", "--layout", "--product-paths"},
    "land": {"-h", "--help", "--dry-run"},
    # argparse's own help: it exits before any build (review r4, sol).
    "cdo-speed": {"-h", "--help"},
}
INFO_FIRST = {"ci-steps": {"fmt"}}
SEPARATORS = {";", ";;", "&&", "||", "|", "|&", "&", "(", ")", "\n"}
KEYWORDS = {
    "if", "then", "else", "elif", "fi", "do", "done", "while", "until", "!", "{", "}",
    "exec", "command", "builtin", "nohup", "setsid", "sudo", "eval",
}
# wrapper -> (flags that take a value, positional arguments before the command)
WRAPPERS = {
    "env": ({"-u", "-C", "-S", "--unset", "--chdir"}, 0),
    "nice": ({"-n", "--adjustment"}, 0),
    "ionice": ({"-c", "-n", "-p", "--class", "--classdata"}, 0),
    "timeout": ({"-k", "-s", "--kill-after", "--signal"}, 1),
    "taskset": ({"-c", "--cpu-list"}, 1),
    "stdbuf": ({"-i", "-o", "-e"}, 0),
    "xargs": ({"-I", "-n", "-P", "-d", "-a", "-E", "-L", "-s"}, 0),
    "time": ({"-o", "-f", "--output", "--format"}, 0),
    "chrt": (set(), 1),
    "watch": ({"-n", "--interval"}, 0),
}
SHELLS = {"bash", "sh", "dash", "zsh"}
PYTHONS = {"python", "python3"}
ASSIGNMENT = re.compile(r"^[A-Za-z_][A-Za-z0-9_]*=")
REDIRECT_OPS = {"<", ">", ">>", "<<<", "&>", "&>>", ">&", "<&", ">|", "<>"}
# Longest first, so `&&` is not read as `&` `&`.
OPERATORS = sorted(SEPARATORS | REDIRECT_OPS, key=len, reverse=True)
WORD_END = " \t\r\n;&|()<>"


def allow(why):
    print(f"cdo-slot-guard: {why} (allowed)", file=sys.stderr)
    sys.exit(0)


# --- A small shell lexer. It keeps what `shlex` loses: whether a character
# was quoted. An operator counts only outside quotes; `$(...)` is matched with
# quotes, escapes, nested substitutions and heredoc bodies inside it skipped.


def skip_quoted(line, i):
    """line[i] is a quote; the index after the quote that closes it."""
    q, j, n = line[i], i + 1, len(line)
    while j < n:
        c = line[j]
        if c == q:
            return j + 1
        if q == '"':
            if c == "\\":
                j += 2
                continue
            if line.startswith("$(", j) and not line.startswith("$((", j):
                j = close_paren(line, j + 1) + 1
                continue
            if c == "`":
                k = line.find("`", j + 1)
                j = n if k < 0 else k + 1
                continue
        j += 1
    return n


def heredoc_delim(line, i):
    """line[i:] starts `<<` (not `<<<`): (delimiter, quoted, strip_tabs, end)."""
    p, n = i + 2, len(line)
    strip = p < n and line[p] == "-"
    p += strip
    while p < n and line[p] in " \t":
        p += 1
    start = p
    while p < n and line[p] not in WORD_END:
        p = skip_quoted(line, p) if line[p] in "'\"" else p + 1
    raw = line[start:p]
    if not raw:
        return None
    quoted = any(ch in raw for ch in "'\"\\")
    return re.sub(r"['\"\\]", "", raw), quoted, strip, p


def skip_body(line, i, delim, strip):
    """Heredoc body lines from i up to the delimiter line: (index after, body)."""
    body, n = [], len(line)
    while i < n:
        end = line.find("\n", i)
        end = n if end < 0 else end
        row = line[i:end]
        i = end + 1
        if (row.lstrip("\t") if strip else row) == delim:
            break
        body.append(row)
    return i, "\n".join(body)


def close_paren(line, k):
    """line[k] == '('; the index of the ')' closing it, or len(line)."""
    depth, j, n, pending = 1, k + 1, len(line), []
    while j < n:
        c = line[j]
        if c == "\\":
            j += 2
            continue
        if c in "'\"":
            j = skip_quoted(line, j)
            continue
        if line.startswith("<<", j) and not line.startswith("<<<", j):
            d = heredoc_delim(line, j)
            if d:
                pending.append(d)
                j = d[3]
                continue
        if c == "\n" and pending:
            j += 1
            for delim, _, strip, _ in pending:
                j, _ = skip_body(line, j, delim, strip)
            pending = []
            continue
        if c == "(":
            depth += 1
        elif c == ")":
            depth -= 1
            if depth == 0:
                return j
        j += 1
    return n


def substitutions(text, quoting=True):
    """The `$(...)` and `` `...` `` texts in `text` (double-quoted or heredoc
    text: single quotes are literal there; with `quoting`, backslash escapes)."""
    found, j, n = [], 0, len(text)
    while j < n:
        if quoting and text[j] == "\\":
            j += 2
            continue
        if text.startswith("$(", j) and not text.startswith("$((", j):
            k = close_paren(text, j + 1)
            found.append(text[j + 2 : k])
            j = k + 1
            continue
        if text[j] == "`":
            k = text.find("`", j + 1)
            k = n if k < 0 else k
            found.append(text[j + 1 : k])
            j = k + 1
            continue
        j += 1
    return found


def lex(line):
    """The shell's reading of a command line: tokens ("word", text without its
    quotes) or ("op", operator outside quotes), and the command substitutions
    it runs. Comments, heredoc bodies and backslash-newlines are gone; an
    unquoted heredoc's body still yields its substitutions."""
    toks, subs, pending = [], [], []
    word, in_word = [], False
    i, n = 0, len(line)

    def end_word():
        nonlocal word, in_word
        if in_word:
            toks.append(("word", "".join(word)))
        word, in_word = [], False

    while i < n:
        c = line[i]
        if c == "\\":
            if line.startswith("\\\n", i):
                i += 2
                continue
            word.append(line[i + 1 : i + 2])
            in_word = True
            i += 2
            continue
        if c == "'":
            j = line.find("'", i + 1)
            j = n if j < 0 else j
            word.append(line[i + 1 : j])
            in_word = True
            i = j + 1
            continue
        if c == '"':
            j = skip_quoted(line, i)
            inner = line[i + 1 : j - 1] if line[j - 1 : j] == '"' and j > i + 1 else line[i + 1 : j]
            subs.extend(substitutions(inner))
            word.append(re.sub(r'\\([$`"\\])', r"\1", inner))
            in_word = True
            i = j
            continue
        if line.startswith("$(", i) and not line.startswith("$((", i):
            j = close_paren(line, i + 1)
            subs.append(line[i + 2 : j])
            word.append(line[i : j + 1])
            in_word = True
            i = j + 1
            continue
        if c == "`":
            j = line.find("`", i + 1)
            j = n if j < 0 else j
            subs.append(line[i + 1 : j])
            word.append(line[i : j + 1])
            in_word = True
            i = j + 1
            continue
        if c in " \t\r":
            end_word()
            i += 1
            continue
        if c == "#" and not in_word:
            while i < n and line[i] != "\n":
                i += 1
            continue
        if line.startswith("<<", i) and not line.startswith("<<<", i):
            d = heredoc_delim(line, i)
            if d:
                end_word()
                pending.append(d)
                toks.append(("op", "<<"))
                toks.append(("word", d[0]))
                i = d[3]
                continue
        op = next((o for o in OPERATORS if line.startswith(o, i)), None)
        if op:
            if op in REDIRECT_OPS and in_word and "".join(word).isdigit():
                word, in_word = [], False  # the fd number of `2>&1`
            end_word()
            toks.append(("op", op))
            i += len(op)
            if op == "\n" and pending:
                for delim, quoted, strip, _ in pending:
                    i, body = skip_body(line, i, delim, strip)
                    if not quoted:
                        subs.extend(substitutions(body))
                pending = []
            continue
        word.append(c)
        in_word = True
        i += 1
    end_word()
    return toks, subs


def segments(toks):
    """The commands of a token list: word lists, split at separators, without
    redirections and their targets."""
    seg, i = [], 0
    while i < len(toks):
        kind, t = toks[i]
        if kind == "op":
            if t in REDIRECT_OPS or t == "<<":
                if i + 1 < len(toks) and toks[i + 1][0] == "word":
                    i += 1
            elif seg:
                yield seg
                seg = []
        else:
            seg.append(t)
        i += 1
    if seg:
        yield seg


def names_cdo(line):
    if "/work/src/cdo-baseline" in line or "$CDO_WS" in line or "${CDO_WS" in line:
        return True
    ws = os.environ.get("CDO_WS", "")
    return bool(ws) and ws in line


def guarded_segment(words, line):
    """True when this command is one the slot guards."""
    i = 0
    while i < len(words):
        w = words[i]
        base = os.path.basename(w)
        if base == "rustup" and words[i + 1 : i + 2] == ["run"]:
            i += 3  # rustup run <toolchain> <command>
            continue
        if ASSIGNMENT.match(w) or w in KEYWORDS or w == "cd":
            if w == "cd":
                return False  # `cd x` runs nothing (its && neighbour is its own segment)
            if w == "eval":
                return any(guarded_line(x) for x in [" ".join(words[i + 1:])])
            i += 1
            continue
        if base in WRAPPERS:
            value_flags, positional = WRAPPERS[base]
            i += 1
            seen_list = False
            while i < len(words) and words[i].startswith("-") and words[i] != "-":
                flag = words[i].split("=", 1)[0]
                if flag in ("-c", "--cpu-list") and base == "taskset":
                    seen_list = True
                # `env -S 'cmd args'`: the value is a command line.
                if base == "env" and flag in ("-S", "--split-string"):
                    value = words[i].split("=", 1)[1] if "=" in words[i] else (
                        words[i + 1] if i + 1 < len(words) else ""
                    )
                    return bool(guarded_line(value))
                if flag in value_flags and "=" not in words[i] and not re.fullmatch(r"-[a-zA-Z]\S+", words[i]):
                    i += 1
                i += 1
            if base == "taskset" and seen_list:
                positional = 0
            i += positional
            if base == "watch":  # watch runs its arguments as a command line
                return bool(guarded_line(" ".join(words[i:])))
            continue
        if base in SHELLS:
            # Options first: a cluster may hold `c` (the command string is the
            # first operand after the options) and `o`/`O`, which take an
            # operand each (`bash -euo pipefail -c 'cargo test'`, review r3).
            i += 1
            want_c = False
            while i < len(words) and words[i][:1] in "-+" and words[i] not in ("-", "--"):
                w = words[i]
                i += 1
                if w in ("--rcfile", "--init-file"):
                    i += 1
                    continue
                if w.startswith("--"):
                    continue
                want_c = want_c or "c" in w[1:]
                i += sum(1 for ch in w[1:] if ch in "oO")
            if i < len(words) and words[i] == "--":
                i += 1
            if want_c:
                return i < len(words) and bool(guarded_line(words[i]))
            if i < len(words):
                return script_guarded(words[i], words[i + 1:])
            return False
        if base in PYTHONS:
            i += 1
            while i < len(words) and words[i].startswith("-"):
                if words[i] in ("-c", "-m"):
                    return False
                i += 1
            return i < len(words) and script_guarded(words[i], words[i + 1:])
        break
    if i >= len(words):
        return False
    w, rest = words[i], words[i + 1:]
    base = os.path.basename(w)
    if base == "cargo":
        j = 0
        while j < len(rest) and (rest[j].startswith("-") or rest[j].startswith("+")):
            if rest[j] in CARGO_VALUE_FLAGS:
                j += 1
            j += 1
        return j < len(rest) and rest[j] in CARGO_SUBS
    if base in ("aldump", "alsem"):
        return names_cdo(line)
    if "/" in w:
        return script_guarded(w, rest)
    return False


def script_guarded(path, args):
    base = os.path.basename(path)
    if base == "agentflow":  # its `run` runs a gate (`-- bash scripts/ci-steps all`)
        return args[:1] == ["run"]
    if base not in SCRIPTS:
        return False
    anywhere = INFO_ANYWHERE.get(base, set())
    if any(a in anywhere for a in args):
        return False
    if base == "cdo-gate" and any(a.startswith("--summary=") for a in args):
        return False
    if args[:1] and args[0] in INFO_FIRST.get(base, set()):
        return False
    return True


def guarded_line(line):
    """The first guarded command of a command line, or None."""
    toks, subs = lex(line)
    for seg in segments(toks):
        if guarded_segment(seg, line):
            return " ".join(seg)
    # A command substitution runs too (`"$(cargo test)"`, `` x=`cargo t` ``,
    # one in an unquoted heredoc body), but not one in single quotes.
    for inner in subs:
        hit = guarded_line(inner)
        if hit:
            return hit
    return None


def main():
    if sys.argv[1:2] in (["-h"], ["--help"]):
        print(__doc__)
        return 0
    try:
        data = json.load(sys.stdin)
    except Exception:
        allow("unreadable input")
    if not isinstance(data, dict) or data.get("tool_name") != "Bash":
        return 0
    line = (data.get("tool_input") or {}).get("command") or ""
    hit = guarded_line(line)
    if not hit:
        return 0
    session = data.get("session_id") or ""
    if not session:
        allow("no session_id in the hook input")
    env = dict(os.environ, CLAUDE_CODE_SESSION_ID=session)
    env.pop("CDO_SLOT_TOKEN", None)
    try:
        p = subprocess.run(
            ["bash", SLOT, "status"], env=env, capture_output=True, text=True, timeout=30
        )
    except Exception as e:
        allow(f"scripts/cdo-slot status did not run: {e}")
    said = p.stdout.strip()
    # This session's own hold, a bound one (its land or cdo-gate) included:
    # only another session's hold stops it.
    own = re.search(r", session (\S+?)(?:,|$)", said)
    if own and own.group(1) == session:
        return 0
    if p.returncode == 1 and said.startswith("held by") and not said.endswith("(yours)"):
        print(f"cdo-slot-guard: the CDO slot is {said}. Not run: {hit}", file=sys.stderr)
        print("Wait until it is free (scripts/cdo-slot status), or ask its holder.", file=sys.stderr)
        return 2
    if p.returncode not in (0, 1, 3):
        allow(f"scripts/cdo-slot status failed: {(p.stderr or said).strip()}")
    return 0


if __name__ == "__main__":
    try:
        sys.exit(main())
    except SystemExit:
        raise
    except Exception as e:  # a hook bug must never stop every session
        print(f"cdo-slot-guard: internal error {e!r} (allowed)", file=sys.stderr)
        sys.exit(0)
