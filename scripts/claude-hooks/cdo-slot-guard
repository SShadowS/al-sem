#!/usr/bin/env python3
"""scripts/claude-hooks/cdo-slot-guard: a Claude Code PreToolUse hook (Bash tool).

While another live session holds the CDO slot (scripts/cdo-slot), it refuses
this session's builds, tests, gates and CDO runs, naming the holder.

TLS-60. The owner wires it (e.g. .claude/settings.json `hooks.PreToolUse`, matcher
"Bash", command `<repo>/scripts/claude-hooks/cdo-slot-guard`). The command line is
read the way the shell reads it (quotes, heredoc bodies and comments are not
commands); every command in it is checked, after `cd ... &&`, `VAR=x`, shell
keywords (`if`, `!`, `{`, `do` ...) and wrappers (`nice`, `env`, `time`,
`timeout`, `taskset`, `stdbuf`, `xargs`, `nohup`, `setsid`; `bash -c`/`eval`
strings are read as command lines too). Guarded:
  cargo build/test/check/clippy/nextest/run/bench/install/rustc/doc/llvm-cov/miri
    (and the aliases b, t, c, r, d), after cargo's own flags and +toolchain;
  scripts/ci-steps, cdo-gate, check-goldens, cdo-speed, land, merge-and-push,
    intent-cdo-check, cdo-before-after, run by path (scripts/..., ./...) or
    through bash/sh/python, except their information modes (--help, --dry-run,
    --layout, --summary=..., --product-paths, `ci-steps fmt`);
  aldump / alsem, when the command line names the CDO workspace
    (/work/src/cdo-baseline, $CDO_WS or its value).
Allowed: everything else; any command while the slot is free, stale or this
session's. Its limits: it sees Bash calls only (an `alsem_*` MCP call on CDO is
not guarded), and a command it cannot parse is read word by word. A hook that
cannot read its input, or a `cdo-slot status` that fails, allows (and says so on
stderr), so a hook bug never stops every session.
Exit: 0 allow; 2 refuse (the message on stderr goes back to Claude).
"""

import json
import os
import re
import shlex
import subprocess
import sys

SLOT = os.path.join(os.path.dirname(os.path.abspath(__file__)), "..", "cdo-slot")

CARGO_SUBS = {
    "build", "b", "test", "t", "check", "c", "clippy", "nextest", "run", "r",
    "bench", "install", "rustc", "doc", "d", "llvm-cov", "miri", "fix",
}
# cargo's global flags that take a value (`cargo --config x test`).
CARGO_VALUE_FLAGS = {"--config", "-Z", "-C", "--color"}
SCRIPTS = {
    "ci-steps", "cdo-gate", "check-goldens", "cdo-speed", "land", "merge-and-push",
    "intent-cdo-check", "cdo-before-after",
}
INFO_FLAGS = {"-h", "--help", "--dry-run", "--layout", "--product-paths"}
SEPARATORS = {";", ";;", "&&", "||", "|", "|&", "&", "(", ")", "\n"}
KEYWORDS = {
    "if", "then", "else", "elif", "fi", "do", "done", "while", "until", "!", "{", "}",
    "exec", "command", "builtin", "nohup", "setsid", "sudo", "eval",
}
# wrapper -> (flags that take a value, positional arguments before the command)
WRAPPERS = {
    "env": ({"-u", "-C", "-S", "--unset", "--chdir"}, 0),
    "nice": ({"-n", "--adjustment"}, 0),
    "ionice": ({"-c", "-n", "-p", "--class", "--classdata"}, 0),
    "timeout": ({"-k", "-s", "--kill-after", "--signal"}, 1),
    "taskset": ({"-c", "--cpu-list"}, 1),
    "stdbuf": ({"-i", "-o", "-e"}, 0),
    "xargs": ({"-I", "-n", "-P", "-d", "-a", "-E", "-L", "-s"}, 0),
    "time": ({"-o", "-f", "--output", "--format"}, 0),
    "chrt": (set(), 1),
    "watch": ({"-n", "--interval"}, 0),
}
SHELLS = {"bash", "sh", "dash", "zsh"}
PYTHONS = {"python", "python3"}
ASSIGNMENT = re.compile(r"^[A-Za-z_][A-Za-z0-9_]*=")
# `<<WORD` / `<<-'WORD'` at the scanner's position (a here-string `<<<` is
# excluded by the scanner).
HEREDOC = re.compile(r"<<-?\s*(['\"]?)([A-Za-z_][A-Za-z0-9_]*)\1")
# A substitution in an unquoted heredoc body (no quoting applies there).
BODY_SUBSTITUTION = re.compile(r"(?<!\\)\$\(([^()]*)\)|(?<!\\)`([^`]*)`")


def allow(why):
    print(f"cdo-slot-guard: {why} (allowed)", file=sys.stderr)
    sys.exit(0)


def scan(line):
    """Read a command line the way the shell does, before tokenizing it.

    Returns (code, substitutions): `code` is the line without comments (a `#`
    that starts a word outside quotes, up to the end of its line), without
    heredoc bodies and without backslash-newlines; `substitutions` is the
    text of every `$(...)` and `` `...` `` the shell would run: outside single
    quotes and unescaped, and in the body of a heredoc whose delimiter is not
    quoted.
    """
    code, subs, pending = [], [], []
    i, n = 0, len(line)
    single = double = False
    while i < n:
        c = line[i]
        if single:
            code.append(c)
            single = c != "'"
            i += 1
            continue
        if c == "\\" and i + 1 < n:
            if line[i + 1] == "\n":  # a continuation joins the lines
                i += 2
                continue
            code.append(line[i : i + 2])
            i += 2
            continue
        if c == "'" and not double:
            single = True
            code.append(c)
            i += 1
            continue
        if c == '"':
            double = not double
            code.append(c)
            i += 1
            continue
        if line.startswith("$(", i) and not line.startswith("$((", i):
            j, depth = i + 2, 1
            while j < n and depth:
                depth += {"(": 1, ")": -1}.get(line[j], 0)
                j += 1
            subs.append(line[i + 2 : j - 1] if depth == 0 else line[i + 2 :])
            code.append(line[i:j])
            i = j
            continue
        if c == "`":
            j = line.find("`", i + 1)
            j = n if j < 0 else j
            subs.append(line[i + 1 : j])
            code.append(line[i : j + 1])
            i = j + 1
            continue
        if double:
            code.append(c)
            i += 1
            continue
        if c == "#" and (not code or code[-1][-1:] in " \t\n;&|()"):
            while i < n and line[i] != "\n":
                i += 1
            continue
        if line.startswith("<<<", i):  # a here-string: no body follows
            code.append("<<<")
            i += 3
            continue
        if line.startswith("<<", i):
            m = HEREDOC.match(line, i)
            if m:
                pending.append((m.group(2), bool(m.group(1))))
                code.append(m.group(0))
                i = m.end()
                continue
        if c == "\n" and pending:
            code.append(c)
            i += 1
            for delim, quoted in pending:
                body = []
                while i < n:
                    end = line.find("\n", i)
                    end = n if end < 0 else end
                    row = line[i:end]
                    i = end + 1
                    if row.strip() == delim:
                        break
                    body.append(row)
                if not quoted:
                    for m in BODY_SUBSTITUTION.finditer("\n".join(body)):
                        subs.append(m.group(1) if m.group(1) is not None else m.group(2))
            pending = []
            continue
        code.append(c)
        i += 1
    return "".join(code), subs


def tokens(line):
    """Shell tokens; separators (newline included) as their own tokens."""
    lex = shlex.shlex(line, posix=True, punctuation_chars=";&|()<>\n")
    lex.whitespace = " \t\r"
    lex.whitespace_split = True
    lex.commenters = ""  # `scan` already dropped the comments
    try:
        return list(lex)
    except ValueError:  # unbalanced quotes: read it word by word
        return re.findall(r"[;&|()\n]+|[^\s;&|()]+", line)


def segments(code):
    seg = []
    toks = tokens(code)
    i = 0
    while i < len(toks):
        t = toks[i]
        if t in SEPARATORS or (t and set(t) <= set(";&|()\n")) or (
            t and set(t) <= set(";&|()\n<>") and ("(" in t or ")" in t)
        ):  # `<(cmd)` / `>(cmd)` run cmd like `(cmd)` does
            if seg:
                yield seg
            seg = []
        elif t and set(t) <= set("<>&"):  # a redirection: skip its target too
            i += 1
        elif re.fullmatch(r"\d+", t) and i + 1 < len(toks) and toks[i + 1] and set(toks[i + 1]) <= set("<>&"):
            pass  # the fd number of `2>&1`
        else:
            seg.append(t)
        i += 1
    if seg:
        yield seg


def names_cdo(line):
    if "/work/src/cdo-baseline" in line or "$CDO_WS" in line or "${CDO_WS" in line:
        return True
    ws = os.environ.get("CDO_WS", "")
    return bool(ws) and ws in line


def guarded_segment(words, line):
    """True when this command is one the slot guards."""
    i = 0
    while i < len(words):
        w = words[i]
        base = os.path.basename(w)
        if base == "rustup" and words[i + 1 : i + 2] == ["run"]:
            i += 3  # rustup run <toolchain> <command>
            continue
        if ASSIGNMENT.match(w) or w in KEYWORDS or w == "cd":
            if w == "cd":
                return False  # `cd x` runs nothing (its && neighbour is its own segment)
            if w == "eval":
                return any(guarded_line(x) for x in [" ".join(words[i + 1:])])
            i += 1
            continue
        if base in WRAPPERS:
            value_flags, positional = WRAPPERS[base]
            i += 1
            seen_list = False
            while i < len(words) and words[i].startswith("-") and words[i] != "-":
                flag = words[i].split("=", 1)[0]
                if flag in ("-c", "--cpu-list") and base == "taskset":
                    seen_list = True
                if flag in value_flags and "=" not in words[i] and not re.fullmatch(r"-[a-zA-Z]\S+", words[i]):
                    i += 1
                i += 1
            if base == "taskset" and seen_list:
                positional = 0
            i += positional
            continue
        if base in SHELLS:
            i += 1
            while i < len(words) and words[i].startswith("-"):
                # -c, or a cluster holding it (-lc, -ec)
                if re.fullmatch(r"-[a-zA-Z]*c[a-zA-Z]*", words[i]):
                    return i + 1 < len(words) and guarded_line(words[i + 1])
                i += 1
            if i < len(words):
                return script_guarded(words[i], words[i + 1:])
            return False
        if base in PYTHONS:
            i += 1
            while i < len(words) and words[i].startswith("-"):
                if words[i] in ("-c", "-m"):
                    return False
                i += 1
            return i < len(words) and script_guarded(words[i], words[i + 1:])
        break
    if i >= len(words):
        return False
    w, rest = words[i], words[i + 1:]
    base = os.path.basename(w)
    if base == "cargo":
        j = 0
        while j < len(rest) and (rest[j].startswith("-") or rest[j].startswith("+")):
            if rest[j] in CARGO_VALUE_FLAGS:
                j += 1
            j += 1
        return j < len(rest) and rest[j] in CARGO_SUBS
    if base in ("aldump", "alsem"):
        return names_cdo(line)
    if "/" in w:
        return script_guarded(w, rest)
    return False


def script_guarded(path, args):
    base = os.path.basename(path)
    if base == "agentflow":  # its `run` runs a gate (`-- bash scripts/ci-steps all`)
        return args[:1] == ["run"]
    if base not in SCRIPTS:
        return False
    if any(a in INFO_FLAGS or a.startswith("--summary=") for a in args):
        return False
    if base == "ci-steps" and args[:1] == ["fmt"]:
        return False
    return True


def guarded_line(line):
    """The first guarded command of a command line, or None."""
    code, subs = scan(line)
    for seg in segments(code):
        if guarded_segment(seg, code):
            return " ".join(seg)
    # A command substitution runs too (`"$(cargo test)"`, `` x=`cargo t` ``,
    # one in an unquoted heredoc body), but not one in single quotes.
    for inner in subs:
        hit = guarded_line(inner)
        if hit:
            return hit
    return None


def main():
    if sys.argv[1:2] in (["-h"], ["--help"]):
        print(__doc__)
        return 0
    try:
        data = json.load(sys.stdin)
    except Exception:
        allow("unreadable input")
    if not isinstance(data, dict) or data.get("tool_name") != "Bash":
        return 0
    line = (data.get("tool_input") or {}).get("command") or ""
    hit = guarded_line(line)
    if not hit:
        return 0
    session = data.get("session_id") or ""
    if not session:
        allow("no session_id in the hook input")
    env = dict(os.environ, CLAUDE_CODE_SESSION_ID=session)
    env.pop("CDO_SLOT_TOKEN", None)
    try:
        p = subprocess.run(
            ["bash", SLOT, "status"], env=env, capture_output=True, text=True, timeout=30
        )
    except Exception as e:
        allow(f"scripts/cdo-slot status did not run: {e}")
    said = p.stdout.strip()
    # This session's own hold, a bound one (its land or cdo-gate) included:
    # only another session's hold stops it.
    own = re.search(r", session (\S+?)(?:,|$)", said)
    if own and own.group(1) == session:
        return 0
    if p.returncode == 1 and said.startswith("held by") and not said.endswith("(yours)"):
        print(f"cdo-slot-guard: the CDO slot is {said}. Not run: {hit}", file=sys.stderr)
        print("Wait until it is free (scripts/cdo-slot status), or ask its holder.", file=sys.stderr)
        return 2
    if p.returncode not in (0, 1, 3):
        allow(f"scripts/cdo-slot status failed: {(p.stderr or said).strip()}")
    return 0


if __name__ == "__main__":
    try:
        sys.exit(main())
    except SystemExit:
        raise
    except Exception as e:  # a hook bug must never stop every session
        print(f"cdo-slot-guard: internal error {e!r} (allowed)", file=sys.stderr)
        sys.exit(0)
