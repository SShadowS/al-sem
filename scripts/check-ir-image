#!/usr/bin/env bash
# check-ir-image <binary>: ENG-110's checks on a built engine binary (Linux ELF).
#
# The IR cache keys on the running image's bytes, which holds only while nothing outside the
# image changes how a text parses or decodes (spec "The key"). Exit 0 when:
#   1. `readelf -d` lists exactly the NEEDED set {libc.so.6, libgcc_s.so.1};
#   2. `nm -D --undefined-only` shows no locale or wide-character classification symbol
#      (setlocale, newlocale, uselocale, isw*, tow*, wctype, wctrans);
#   3. the file holds the IR image marker (src/program/ir_cache/key.rs, IR_IMAGE_MARKER).
# Otherwise exit 1, naming each failed check.
set -u

if [ $# -ne 1 ] || [ ! -f "$1" ]; then
    echo "usage: check-ir-image <binary>" >&2
    exit 2
fi
bin=$1
fail=0

needed=$(readelf -d "$bin" 2>/dev/null | sed -n 's/.*(NEEDED).*\[\(.*\)\]$/\1/p' | sort | tr '\n' ' ')
if [ "$needed" != "libc.so.6 libgcc_s.so.1 " ]; then
    echo "check-ir-image: $bin: NEEDED is '${needed% }', want 'libc.so.6 libgcc_s.so.1'"
    fail=1
fi

bad=$(nm -D --undefined-only "$bin" 2>/dev/null | awk '{print $(NF)}' | sed 's/@.*//' \
    | grep -E '^(setlocale|newlocale|uselocale|isw.*|tow.*|wctype|wctrans)$' | tr '\n' ' ')
if [ -n "$bad" ]; then
    echo "check-ir-image: $bin: locale or wide-character symbols: ${bad% }"
    fail=1
fi

if ! grep -qaF 'ALSEM-IR-IMAGE-1' "$bin"; then
    echo "check-ir-image: $bin: no IR image marker"
    fail=1
fi

if [ $fail -eq 0 ]; then
    echo "check-ir-image: $bin: ok"
fi
exit $fail
