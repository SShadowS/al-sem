#!/usr/bin/env bash
# scripts/cdo-gate — Task T0.2: the CDO ratchet's ENFORCE-gated release runner.
#
# Runs the north-star CDO-gated test suite against a real Business Central
# workspace with ENFORCE_CDO_WS=1, so any test that would otherwise silently
# skip when CDO_WS is unset fails loudly instead (see tests/common/cdo.rs).
# CI cannot reach the CDO workspace — this script is meant to be scheduled
# locally (cron / Task Scheduler), not run in CI.
#
# Usage:
#   scripts/cdo-gate [--no-speed] <path-to-cdo-workspace>
#   CDO_WS=/path/to/workspace scripts/cdo-gate
#
# A positional argument takes precedence over the CDO_WS env var when both
# are given. `CDO_GATE_SERIAL=1` runs the phases one after another (for a
# machine short of memory, or to time one phase alone).
#
# ⟨2026-11-09, engine limits wave 1, L14⟩ The first phase is `speed`
# (`scripts/cdo-speed`): the working tree's release-fast `alsem` against the
# merge base's (cached per commit), on a fixed set of resident CDO calls,
# judged on CPU time, wall time and peak memory. It runs alone, before the
# test lanes. `--no-speed` (or CDO_GATE_NO_SPEED=1) skips it and says so
# loudly. It reads /proc, so it is Linux only: on Windows the gate FAILS
# unless given --no-speed. Measured cost on 2026-11-09 (Linux, 22 cores): its timing 178-301 s
# (505 s with every core busy elsewhere), plus the working tree's release-fast
# build (incremental) and, once per master commit, the base build (~245 s,
# beside the test build).
#
# ⟨2026-11-09, engine limits wave 1⟩ How it runs: every test target is built
# ONCE (`cargo test --no-run`), then the phases. ⟨TLS-32, 2026-11-13⟩ The
# layout now: `output_cdo` alone; then the impact phase (`output_cdo_impact`)
# with lane 2 (program_resolve_harness, lsp, l4_summary_differential, then the
# lib's CDO tests, one after another) beside it when the host has the memory,
# else after it; `CDO_GATE_SERIAL=1` runs every phase in a row. See
# `plan_layout`; `--layout` prints the layout this host would take now. (The
# history below describes the older two-lane layout, `output_cdo` beside lane 2,
# which TLS-23 retired for memory.)
# Each phase writes its own log (the folder is printed at the start and the
# end); the summary names each phase's result, wall time and test counts, and
# prints the failures of a failed phase. Any failed phase (or a failed build)
# fails the gate.
#
# Measured 2026-11-09 on Linux (22 cores, 93 GB), `cdo` profile, warm build,
# on a machine other agents were also using (their load alone 10-30, at times
# over 100), so read the numbers as a range:
#   before (phases in a row, whole --lib): 1184 s and 1164 s; peak 39.5 GB
#     program_resolve_harness 41-45 s, lsp 8 s, l4_summary_differential 17-18 s,
#     cli output_cdo 780-808 s, --lib 290-317 s (3,214 tests)
#   after (two lanes): 834-910 s; peak 51-58 GB (the summed RSS of the gate's
#     processes, its cgroup's memory.peak). The length is output_cdo's impact
#     ratchets (768 s and 886 s in the last run); lane 2 ended at 736 s.
# output_cdo was long because its impact ratchets ran their one-shot `alsem
# impact` calls one after another (603 s and 703 s measured alone); they now
# run at once. The lib phase runs the 17 lib tests whose path holds `cdo` (15
# read CDO_WS); the rest read no CDO_WS and run in every task gate
# (`scripts/ci-steps task`/`test`), with the same result.
set -uo pipefail

# ⟨2026-11-09, engine limits wave 1, L14⟩ The speed and memory phase
# (`scripts/cdo-speed`, its doc says how it measures and judges). It is on by
# default; `--no-speed` (or CDO_GATE_NO_SPEED=1) skips it for a machine where
# timing is impossible, and the gate then says so loudly at the start and in
# its summary. Never skip it on a tree about to land without saying why.
speed=1
ws_arg=""
summary_dir=""
speed_skipped=""
product_paths_only=0
layout_only=0

# ⟨TLS-32, orchestrator 2026-11-13⟩ The test phases' layout. `output_cdo` runs
# alone, then the impact phase. Lane 2 (harness, lsp, l4, lib_cdo) runs BESIDE
# the impact phase when the memory allows it, else after it; `CDO_GATE_SERIAL=1`
# runs every phase one after another, as before. The summary names the layout.
#
# The gate's own memory (its process tree's RSS, `memory.timeline`'s third
# column; 12 gates, 2026-11-12/13): the impact phase at most 16,076 MiB.
# lib_cdo's tests alone (TLS-32's census, `cdo` profile, one test per process):
# `retained_emission_equals_a_composition_on_cdo` 18,628 MiB, every other one
# at most 4,552. So lib_cdo is at most ~18,700 at 1 thread and ~23,300 at 2;
# the harness, lsp and l4 (≤ ~8,400 own) run before it, one at a time.
#
# Beside the impact phase, the most threads (2, then 1) whose need fits both
# bounds, read once when the section starts (after `output_cdo`, whose memory
# is then freed, and before either part allocates):
#   need = impact's own worst + lib_cdo's own worst at that count + 4 GiB;
#   - the container (`memory.max` minus what cannot be reclaimed now, which
#     counts every agent in it): the owner's 4 GiB headroom rule;
#   - the host (MemAvailable): the gate starts at >= 35 GB, sized for a serial
#     gate, and must not push the host into swap.
# Neither fits: lane 2 after the impact phase. Review r1 (sol and Opus): the
# host alone said `parallel` while the container had ~42.7 GB free.
impact_own_mib=16100
lib_own_mib=(0 18700 23300)
headroom_mib=4096
lib_threads=4
lane2_beside=0
cgroup_dir="${CDO_GATE_CGROUP:-/sys/fs/cgroup}"
host_available_mib() {
    awk '/^MemAvailable:/ { print int($2 / 1024) }' "${CDO_GATE_MEMINFO:-/proc/meminfo}"
}
# The container's free memory now, in MiB; `unlimited` when its `memory.max`
# says `max`; `unknown` when either file cannot be read or parsed. Unknown
# counts as no room (review r2, sol: it must not fail open).
container_free_mib() {
    local max used
    max=$(cat "$cgroup_dir/memory.max" 2>/dev/null)
    if [[ "$max" == max ]]; then
        echo unlimited
        return
    fi
    # What cannot be reclaimed, as the sampler counts it (`unreclaimable_bytes`).
    # Every counted field must be there and be a number; a malformed or partial
    # file is unknown (review r3, sol: awk would read garbage as 0).
    used=$(awk '$1 == "anon" || $1 == "shmem" || $1 == "kernel" || $1 == "slab_reclaimable" {
                    if ($2 !~ /^[0-9]+$/) { bad = 1 }
                    seen[$1] = 1
                    n += ($1 == "slab_reclaimable" ? -$2 : $2)
                }
                END { if (!bad && seen["anon"] && seen["shmem"] && seen["kernel"]) print n }' \
        "$cgroup_dir/memory.stat" 2>/dev/null)
    if [[ "$max" =~ ^[0-9]+$ && "$used" =~ ^-?[0-9]+$ ]]; then
        echo $(((max - used) >> 20))
    else
        echo unknown
    fi
}
# ⟨TLS-36⟩ The CPUs lane 2 is pinned to beside the impact phase, as a
# `taskset -c` list; nothing (no pin) when `CDO_GATE_LANE2_CPUS` is 0, without
# `taskset`, or when the pin would leave the impact phase fewer than 8 CPUs.
# `CDO_GATE_LANE2_CPUS` is unset (the default), a count, or an explicit list
# (`12-19`). Of the CPUs this gate may use (its mask) that are online, by each
# one's maximum clock against the fastest's (sysfs `cpuinfo_max_freq`):
#   - low-power cores (under 70%: the 2.5 GHz cores of a Core Ultra beside its
#     5.1 GHz P-cores) are never used (review r1, Opus: "the last 6" was 4
#     E-cores and both low-power cores, so lane 2's longest test ran on the
#     slowest silicon);
#   - the default takes every efficiency core (70% up to 85%), so the impact
#     phase keeps every performance core (orchestrator 2026-11-13); on a CPU
#     with none, the last 6;
#   - a count takes the last `count` of the CPUs that are not low-power.
# On server1 (Core Ultra 9 185H, 2026-11-13) the default is 12-19.
lane2_cpus() {
    local want=${CDO_GATE_LANE2_CPUS:-eff} sys=${CDO_GATE_SYS_CPU:-/sys/devices/system/cpu}
    command -v taskset >/dev/null || return 0
    # An explicit list is an operator's override: used as given, without the
    # checks below (mask, online, low-power, 8 CPUs left; review r2, sol).
    if [[ "$want" =~ [-,] ]]; then
        echo "$want"
        return
    fi
    if [[ "$want" != eff ]]; then
        # Decimal, never octal (`08`; review r1, sol); anything else: no pin.
        [[ "$want" =~ ^[0-9]+$ ]] && ((10#$want > 0)) || return 0
        want=$((10#$want))
    fi
    local allowed online
    allowed=$(awk '/^Cpus_allowed_list:/ { print $2 }' \
        "${CDO_GATE_PROC_STATUS:-/proc/self/status}" 2>/dev/null)
    online=$(cat "$sys/online" 2>/dev/null)
    [[ -n "$allowed" ]] || return 0
    {
        echo "allowed $allowed"
        echo "online ${online:-$allowed}"
        for f in "$sys"/cpu[0-9]*/cpufreq/cpuinfo_max_freq; do
            [[ -r "$f" ]] && echo "max ${f#"$sys"/cpu} $(cat "$f")"
        done
    } | awk -v want="$want" '
        function expand(list, into,   parts, n, i, r, m, c) {
            n = split(list, parts, ",")
            for (i = 1; i <= n; i++) {
                m = split(parts[i], r, "-")
                for (c = r[1] + 0; c <= (m == 2 ? r[2] : r[1]) + 0; c++) into[c] = 1
            }
        }
        $1 == "allowed" { expand($2, allowed) }
        $1 == "online"  { expand($2, online) }
        $1 == "max"     { split($2, p, "/"); mhz[p[1] + 0] = $3; if ($3 > top) top = $3 }
        END {
            for (c = 0; c <= 4096; c++) {
                if (!(c in allowed) || !(c in online)) continue
                usable++
                if (top > 0 && (c in mhz) && mhz[c] < 0.7 * top) continue
                cpu[k++] = c
                # Efficiency cores: under 85% of the fastest clock, at or over
                # 70% (orchestrator 2026-11-13).
                if (top > 0 && (c in mhz) && mhz[c] < 0.85 * top) eff[e++] = c
            }
            out = ""
            if (want == "eff" && e > 0) {
                if (usable - e < 8) exit
                for (i = 0; i < e; i++) out = out (out == "" ? "" : ",") eff[i]
                print out
                exit
            }
            if (want == "eff") want = 6
            if (k < want || usable - want < 8) exit
            for (i = k - want; i < k; i++) out = out (out == "" ? "" : ",") cpu[i]
            print out
        }'
}
# Decide the layout: sets `layout_line`, `lane2_beside`, `lib_threads` and
# `lane2_pin`.
plan_layout() {
    if [[ "${CDO_GATE_SERIAL:-}" == "1" ]]; then
        layout_line="serial: every phase one after another (CDO_GATE_SERIAL=1)"
        return
    fi
    local avail free t need
    avail=$(host_available_mib)
    free=$(container_free_mib)
    for t in 2 1; do
        need=$((impact_own_mib + lib_own_mib[t] + headroom_mib))
        if [[ "$avail" =~ ^[0-9]+$ ]] && ((avail >= need)) &&
            { [[ "$free" == unlimited ]] || { [[ "$free" =~ ^[0-9]+$ ]] && ((free >= need)); }; }; then
            lane2_beside=1
            lib_threads=$t
            local cpus
            cpus=$(lane2_cpus)
            [[ -n "$cpus" ]] && lane2_pin=(taskset -c "$cpus")
            layout_line="parallel: lane 2 beside the impact phase, lib_cdo at $t thread(s), lane 2 on CPUs ${cpus:-any} (need $need MiB; host MemAvailable $avail, container free $free)"
            return
        fi
    done
    need=$((impact_own_mib + lib_own_mib[1] + headroom_mib))
    layout_line="sequential: lane 2 after the impact phase (host MemAvailable ${avail:-unknown}, container free $free; 1 thread beside it needs $need MiB)"
}
usage() {
    echo "usage: scripts/cdo-gate [--no-speed] <path-to-cdo-workspace>   (or: CDO_WS=<path> scripts/cdo-gate)" >&2
    echo "       scripts/cdo-gate --summary=<run folder>   (a past run's summary, from its logs)" >&2
    echo "       scripts/cdo-gate --layout   (the test phases' layout this host would take now)" >&2
}

loud_no_speed() {
    if [[ -n "$speed_skipped" ]]; then
        echo "cdo-gate: speed: skipped, $speed_skipped (nothing in it can change alsem's speed)"
        return
    fi
    echo "cdo-gate: ****************************************************************"
    echo "cdo-gate: **  SPEED AND MEMORY WERE NOT CHECKED (--no-speed).            **"
    echo "cdo-gate: **  A slowdown or a memory rise on CDO passes this gate unseen.  **"
    echo "cdo-gate: ****************************************************************"
}

# ⟨TLS-20, owner 2026-11-11⟩ The changed paths that can reach the `alsem` binary
# (read on stdin, one per line). An allow-list of paths never compiled into it:
# tests (goldens included), docs, scripts other than the speed check itself,
# the nextest config and the CHANGELOG. Everything else, `src/`, `crates/`,
# `Cargo.*`, `build.rs`, `.cargo/`, a new top-level file, counts: the safe
# direction. (`include_str!`/`include_bytes!` in product code read only files
# under `src/` and `crates/`, checked 2026-11-11.)
product_paths() {
    local f
    while IFS= read -r f; do
        [[ -z "$f" ]] && continue
        case "$f" in
            scripts/cdo-speed) echo "$f" ;;
            tests/* | docs/* | scripts/* | .config/nextest.toml | CHANGELOG.md) ;;
            *) echo "$f" ;;
        esac
    done
}

# The paths the working tree changes against the base the speed check times it
# against (`cdo-speed`'s own choice: the merge base with master, or on a clean
# master HEAD's first parent), with untracked files.
changed_paths() {
    local base head
    head=$(git -C "$repo" rev-parse HEAD) || return 1
    base=$(git -C "$repo" merge-base HEAD master) || return 1
    if [[ "$base" == "$head" && -z "$(git -C "$repo" status --porcelain --untracked-files=no)" ]]; then
        base=$(git -C "$repo" rev-parse --verify -q 'HEAD^1') || return 1
    fi
    { git -C "$repo" diff --name-only "$base"; git -C "$repo" ls-files --others --exclude-standard; } | sort -u
}

# The summary: every phase's result from its status file (a missing one is a
# failure), its `test result:` lines, and a failed phase's failures. Reads
# `$logs` and `$speed`; returns the gate's status.
# ⟨TLS-10⟩ A test phase that exits 0 having passed no test FAILS ("no test
# ran"): `cargo test` with a filter that matches nothing (a renamed member or
# module) exits 0 on "0 passed". The speed phase cannot pass on zero either:
# `cdo-speed` fails on any timed call that does not exit 0.
summarize() {
    local phases=(program_resolve_harness lsp l4_summary_differential lib_cdo output_cdo)
    # ⟨TLS-19⟩ A run that split the impact ratchets off says so (an older run's
    # `output_cdo` held them); in a run that did, a missing status fails as any.
    [[ -f "$logs/split-impact" ]] && phases+=(output_cdo_impact)
    [[ "$speed" -eq 1 ]] && phases=(speed "${phases[@]}")
    local status=0 name rc secs word counts passed bad=()
    echo "cdo-gate: summary (wall seconds; logs in $logs)"
    for name in "${phases[@]}"; do
        if [[ -f "$logs/$name.status" ]]; then
            read -r rc secs < "$logs/$name.status"
        else
            rc=missing secs=-
        fi
        counts="$(grep -hE '^ *[0-9]+ test result:' "$logs/$name.log" 2>/dev/null |
            sed -E 's/^ *[0-9]+ test result: //' | paste -sd '|' -)"
        passed="$(grep -hoE 'test result: [A-Za-z]+\. [0-9]+ passed' "$logs/$name.log" 2>/dev/null |
            grep -oE '[0-9]+ passed' | awk '{n += $1} END {print n + 0}')"
        if [[ "$name" == "speed" ]]; then
            counts="$(grep -hE 'cdo-speed: (PASS|FAIL)' "$logs/speed.log" 2>/dev/null |
                sed -E 's/^ *[0-9]+ cdo-speed: //' | paste -sd '|' -)"
        fi
        if [[ "$rc" != "0" ]]; then
            word="FAILED ($rc)"
        elif [[ "$name" != "speed" && "$passed" -eq 0 ]]; then
            word="FAILED (no test ran)"
        else
            word="ok"
        fi
        [[ "$word" == ok ]] || { status=1; bad+=("$name"); }
        printf 'cdo-gate:   %-26s %-20s %6s s  %s\n' "$name" "$word" "$secs" "${counts:-no test result}"
    done
    # ⟨TLS-32⟩ The layout the test phases took.
    [[ -f "$logs/layout" ]] && echo "cdo-gate:   layout: $(cat "$logs/layout")"
    # ⟨TLS-19⟩ The container's peak unreclaimable memory during the test lanes,
    # and the OOM counters the run added (a report, not a verdict).
    if [[ -f "$logs/memory.unreclaimable" ]]; then
        local peak limit gate
        read -r peak limit gate < "$logs/memory.unreclaimable"
        if [[ "$limit" =~ ^[0-9]+$ ]]; then
            echo "cdo-gate:   peak memory (container, unreclaimable) $((peak >> 20)) MiB of $((limit >> 20)) MiB, headroom $(((limit - peak) >> 20)) MiB"
        else
            echo "cdo-gate:   peak memory (container, unreclaimable) $((peak >> 20)) MiB (no limit)"
        fi
        [[ -n "$gate" ]] && echo "cdo-gate:   the gate's own processes then: $gate MiB (RSS sum; the rest is other agents)"
    fi
    if [[ -f "$logs/memory.events.start" && -f "$logs/memory.events.end" ]]; then
        echo "cdo-gate:   memory events this run: $(awk 'NR == FNR { s[$1] = $2; next }
            $1 == "max" || $1 == "oom" || $1 == "oom_kill" { printf "%s%s +%d", sep, $1, $2 - s[$1]; sep = ", " }' \
            "$logs/memory.events.start" "$logs/memory.events.end")"
    fi
    [[ "$speed" -eq 0 ]] && loud_no_speed

    if [[ "$status" -ne 0 ]]; then
        for name in "${bad[@]}"; do
            echo "cdo-gate: ---- $name ($logs/$name.log) ----"
            if grep -qE '^ *[0-9]+ failures:' "$logs/$name.log" 2>/dev/null; then
                sed -En '/^ *[0-9]+ failures:/,$p' "$logs/$name.log"
            else
                tail -n 60 "$logs/$name.log" 2>/dev/null
            fi
        done
        echo "cdo-gate: FAIL"
    elif [[ -n "$speed_skipped" ]]; then
        echo "cdo-gate: PASS (behaviour only: speed skipped, $speed_skipped)"
    elif [[ "$speed" -eq 0 ]]; then
        echo "cdo-gate: PASS (behaviour only: SPEED AND MEMORY NOT CHECKED)"
    else
        echo "cdo-gate: PASS"
    fi
    return "$status"
}

# `--no-speed` in any position; anything else unknown stops the gate (a flag it
# silently ignored would run a different gate than the caller asked for).
for arg in "$@"; do
    case "$arg" in
        --no-speed) speed=0 ;;
        --summary=*) summary_dir="${arg#--summary=}" ;;
        --product-paths) product_paths_only=1 ;;
        --layout) layout_only=1 ;;
        -*)
            echo "cdo-gate: error: unknown option: $arg" >&2
            usage
            exit 2
            ;;
        *)
            if [[ -n "$ws_arg" ]]; then
                echo "cdo-gate: error: more than one workspace given: $ws_arg, $arg" >&2
                usage
                exit 2
            fi
            ws_arg="$arg"
            ;;
    esac
done
[[ "${CDO_GATE_NO_SPEED:-}" == "1" ]] && speed=0

# ⟨TLS-20⟩ `--product-paths`: the rule alone, for its test (paths on stdin).
if [[ "$product_paths_only" == 1 ]]; then
    product_paths
    exit 0
fi

# ⟨TLS-32⟩ `--layout`: the test phases' layout a gate would take on this host
# now (for an operator, and for its test), then exit.
if [[ "$layout_only" == 1 ]]; then
    plan_layout
    echo "$layout_line"
    exit 0
fi

# A past run's summary: the run had a speed phase when it left a status for one.
if [[ -n "$summary_dir" ]]; then
    logs="$summary_dir"
    [[ -f "$logs/speed.status" ]] && speed=1 || speed=0
    [[ -f "$logs/speed-skipped" ]] && speed_skipped=$(cat "$logs/speed-skipped")
    summarize
    exit $?
fi

ws="${ws_arg:-${CDO_WS:-}}"

if [[ -z "$ws" ]]; then
    echo "cdo-gate: error: no workspace given and CDO_WS is unset" >&2
    usage
    exit 2
fi

if [[ ! -e "$ws" ]]; then
    echo "cdo-gate: error: workspace path does not exist: $ws" >&2
    exit 2
fi

export CDO_WS="$ws"
export ENFORCE_CDO_WS=1
# ⟨2026-11-05⟩ The tests must never see a git hook's repository variables
# (`GIT_DIR`, `GIT_INDEX_FILE`, ...): with them, a test's `git -C <tmp> commit`
# writes into the committer's repository. This script runs no git of its own.
# shellcheck disable=SC2046
unset $(git rev-parse --local-env-vars 2>/dev/null)

echo "cdo-gate: CDO_WS=$CDO_WS ENFORCE_CDO_WS=1"

# ⟨2026-10-04, test tiers⟩ The `cdo` profile (no LTO, incremental): this gate
# checks BEHAVIOUR — counts, digests, zero ratchets — and every optimized
# profile runs the same code paths; full LTO only bought a much slower link of
# every test executable. Timing claims still need full `release` (`perf_bounds`,
# benches, the SHA-pinned north-star measure — CLAUDE.md "Build Commands").
profile=(--profile cdo)
# cargo test, not nextest: measured 2026-10-18, nextest took 97-112 s against
# 72-84 s here (peak ~3.2 GB both). nextest runs one process per test, and
# program_resolve_harness rebuilds its shared CDO context (`CDO_SHARED`) in each;
# output_cdo's tests share one MCP server's answers per process the same way.

# A zero RLIMIT_RTTIME makes the kernel SIGKILL test processes at random.
"$(dirname "$0")/require-rttime" || exit 1

repo="$(cd "$(dirname "$0")/.." && pwd)"
logs_root="${CARGO_TARGET_DIR:-$repo/target}/cdo-gate-logs"
mkdir -p "$logs_root" || exit 1
# Runs older than a week go; each run has its own folder (two gates at once
# in one checkout do not mix their logs).
find "$logs_root" -mindepth 1 -maxdepth 1 -type d -mtime +7 -exec rm -rf {} + 2>/dev/null
logs="$logs_root/$(date +%Y%m%d-%H%M%S)-$$"
mkdir -p "$logs" || exit 1

gate_pid=$$
# A Ctrl-C or kill stops the gate's own processes and the gate itself, from the
# first phase on: the speed build (in a process group of its own), the test
# build, the speed timing, the test phases and the background lane, the memory
# sampler. The trap is cleared first so it cannot re-enter, then every
# descendant of this script gets TERM, then the gate exits instead of going on
# to the next phase (review r1, sol and Opus). Installed before any phase, and
# never replaced (review r4, sol). Not `kill 0`: that signals the whole process
# group, which can hold the caller when the gate was not started in a group of
# its own (review r2, sol). `run_phase` waits on each phase in the background,
# so a TERM to the gate's PID alone runs this at once (review r3, sol).
gate_descendants() {
    ps -e -o pid=,ppid= | awk -v root="$gate_pid" '
        { parent[$1] = $2 }
        END {
            for (p in parent) {
                q = parent[p]
                while (q != root && (q in parent) && q != parent[q]) q = parent[q]
                if (q == root) print p
            }
        }'
}
stop_gate() {
    trap - INT TERM
    # Listed first, then signalled: a `| xargs kill` pipeline would list (and
    # kill) its own processes too.
    local pids pass
    # Twice: a process started between the first listing and its signal (cargo
    # starting the next test binary) is caught by the second (review r3, Opus).
    for pass in 1 2; do
        pids=$(gate_descendants)
        # shellcheck disable=SC2086
        [[ -n "$pids" ]] && kill -TERM $pids 2>/dev/null
        [[ "$pass" == 1 ]] && sleep 0.5
    done
    exit 130
}
trap stop_gate INT TERM
echo "cdo-gate: logs in $logs"
# ⟨TLS-19⟩ This run runs the impact ratchets as their own phase (summarize).
: > "$logs/split-impact"

# Each output line prefixed with the gate's clock (seconds since it started),
# so a log shows when each test ended.
stamp() {
    local line
    while IFS= read -r line; do
        printf '%5d %s\n' "$SECONDS" "$line"
    done
}

# A phase: its command's output goes to `<name>.log`, each line stamped;
# `<name>.status` holds the exit status and the wall seconds when it ends.
# The status is the command's own (through `<name>.rc`), never the stamper's.
run_phase() {
    local name="$1"
    shift
    local start=$SECONDS
    echo "cdo-gate: [$name] started"
    echo "$(date +%s) start $name" >> "$logs/phases.times"
    # In the background, then `wait`: bash runs a trap only between commands,
    # and `wait` is one it can interrupt, so a TERM sent to the gate's PID
    # alone stops it at once instead of after the phase (review r3, sol). The
    # command's own status goes through a file (`PIPESTATUS` is the foreground's).
    { "$@" 2>&1; echo $? > "$logs/$name.rc"; } | stamp > "$logs/$name.log" &
    wait $!
    local rc
    rc=$(cat "$logs/$name.rc" 2>/dev/null)
    [[ "$rc" =~ ^[0-9]+$ ]] || rc=1
    echo "$(date +%s) end $name" >> "$logs/phases.times"
    echo "$rc $((SECONDS - start))" > "$logs/$name.status"
    if [[ "$rc" -eq 0 ]]; then
        echo "cdo-gate: [$name] ok ($((SECONDS - start)) s)"
    else
        echo "cdo-gate: [$name] FAILED, exit $rc ($((SECONDS - start)) s)"
    fi
    return "$rc"
}

# ---------------------------------------------------------------------------
# Build every phase's test target once. The phases' own `cargo test` calls
# then only check freshness, so two of them can run at once.
# ---------------------------------------------------------------------------
# ⟨TLS-20⟩ A diff that touches no product code builds the same `alsem` as its
# base: the speed phase would time a binary against itself. An empty diff, or a
# diff that cannot be read, keeps the phase.
if [[ "$speed" -eq 1 ]]; then
    changed=$(changed_paths) || changed=""
    if [[ -n "$changed" && -z "$(product_paths <<<"$changed")" ]]; then
        speed=0
        speed_skipped="diff touches no product code"
        echo "$speed_skipped" > "$logs/speed-skipped"
    fi
fi
if [[ "$speed" -eq 0 ]]; then
    loud_no_speed
else
    # The speed phase's two release-fast binaries (the working tree's, and the
    # base commit's from its cache) are built beside the test build. ⟨TLS-33⟩
    # The working tree's is built in ci-steps' optimized build folder
    # (`<target>/gate-release`): after `ci-steps all` on the same tree it is
    # already there and cargo builds nothing, and it never waits for the test
    # build's lock (in the main target folder it did, then rebuilt al-sem: 255 s
    # on the critical path). The base's has a folder of its own.
    # In a process group of its own (`set -m` for this one job), so stopping it
    # stops cdo-speed and its cargo builds too, not only the subshell: an
    # orphaned base build would hold the cache lock for minutes.
    set -m
    run_phase speed_build "$(dirname "$0")/cdo-speed" "$ws" --build-only \
        --out "$logs/speed" &
    speed_build=$!
    set +m
    stop_speed_build() { kill -- -"$speed_build" 2>/dev/null; }
    # Its own group does not get the terminal's Ctrl-C: `stop_gate` (installed
    # above) reaches it as a descendant.
fi
if ! run_phase build cargo test "${profile[@]}" --no-run \
    --test program_resolve_harness --test lsp --test l4_summary_differential \
    --test cli -p al-sem --lib; then
    tail -n 60 "$logs/build.log"
    echo "cdo-gate: FAIL (the build; full log: $logs/build.log)"
    [[ "$speed" -eq 1 ]] && stop_speed_build
    exit 1
fi

# ---------------------------------------------------------------------------
# The speed phase runs ALONE, before the test lanes: their load (tens of GB,
# every core) would be noise in its timings.
# ---------------------------------------------------------------------------
if [[ "$speed" -eq 1 ]]; then
    if wait "$speed_build"; then
        run_phase speed "$(dirname "$0")/cdo-speed" "$ws" --no-build --out "$logs/speed"
    else
        # No timing without both binaries: the phase fails with the build.
        echo "1 0" > "$logs/speed.status"
        cp "$logs/speed_build.log" "$logs/speed.log"
    fi
fi

# ---------------------------------------------------------------------------
# The phases. tests/common/cdo.rs `on_the_cdo_gate` states the same targets
# and filters: every test that reads CDO_WS (through the shared gate, the only
# way: `cdo_gate_coverage_tests`) must be in one, or the task gate fails.
# Change the two together.
# ---------------------------------------------------------------------------

# ⟨MCP output plan, item T⟩ The output invariants on three CDO routines and
# the CDO ratchets of impact, tests, prove and the round-2 sizes:
# `tests/cli/output_cdo.rs`, the CDO-gated member of the `cli` umbrella. Its
# MCP answers come off ONE `alsem mcp` server per process (one resident
# build), so its tests share a process: plain `cargo test`, filtered to the
# member.
# ⟨TLS-19⟩ Without its two impact ratchets, which are a phase of their own
# (`phase_output_cdo_impact`): the two phases together run every `output_cdo::`
# test (`on_the_cdo_gate` and `cdo_gate_run_set_matches_the_script` state it).
phase_output_cdo() {
    run_phase output_cdo cargo test "${profile[@]}" --test cli output_cdo:: -- --skip output_cdo::cdo_impact
}

# ⟨TLS-19, owner 2026-11-11⟩ `cdo_impact_ratchets` and `cdo_impact_base_ratchets`
# run one-shot `alsem impact` processes (each builds the CDO model; 4-7 min, on
# about 3 cores) and held `output_cdo` open 470-700 s after its other tests
# (TLS-16's note). They are their own phase, run LAST, after every other phase
# (both tests at once: five CDO models, ~14 GB, with no other phase beside them).
# ⟨TLS-23, 2026-11-11⟩ TLS-19 ran them beside the other phases. Three gates on
# the shared kraken host: test phases 874 s and 1,232 s with both tests at once
# (the second with 2,836 MiB headroom, under the owner's 4 GiB rule: lib_cdo's
# test process alone reaches 25-29 GB), then 1,641 s one test at a time (8 GiB
# headroom, slower than the 1,170 s the phases took one after another). A lane
# staged to fit the memory would have saved little more. Serial again; the
# memory sampler stays (note `2026-11-11-cdo-gate-time.md`, "TLS-19/TLS-23").
# ⟨TLS-32, 2026-11-13⟩ It runs after `output_cdo`, with lane 2 beside it when
# the memory allows (`plan_layout`), else alone with lane 2 after it.
phase_output_cdo_impact() {
    run_phase output_cdo_impact cargo test "${profile[@]}" --test cli output_cdo::cdo_impact
}

# ⟨2026-10-20⟩ 4 threads, not 1: measured on CDO, cdo profile, warm, two runs
# each: 35.7-37.5 s at 1 thread against 17.3-18.4 s at 4. The harness shares ONE
# CDO context (`CDO_SHARED`, a `OnceLock`), calls no `set_var`, and writes only
# in regen mode (one golden per test) or into its own tempdir.
# ⟨2026-10-31, memory⟩ `cdo_i264_closed_interface_site_census` once composed a
# whole capability snapshot of the cross-app CDO model (45.8 GB) to read only
# its call-site rows; it calls `compose_callsite_resolutions` (3.1 GB) since.
phase_harness() {
    run_phase program_resolve_harness "${lane2_nice[@]}" "${lane2_pin[@]}" \
        cargo test "${profile[@]}" --test program_resolve_harness -- --test-threads=4
}

phase_lsp() {
    run_phase lsp "${lane2_nice[@]}" "${lane2_pin[@]}" \
        cargo test "${profile[@]}" --test lsp -- program_graph:: snapshot_robustness::
}

# ⟨task-3 fix wave, review I-2⟩ The CDO whole-program L4 frozen digest
# (`tests/l4-summary-baseline/cdo-whole-program-digest.txt`) is a CDO-gated
# ratchet; this script once never listed `--test l4_summary_differential`, so
# the gate could not fail on it. The target's fixture members are cheap and run
# alongside it.
phase_l4() {
    run_phase l4_summary_differential "${lane2_nice[@]}" "${lane2_pin[@]}" \
        cargo test "${profile[@]}" --test l4_summary_differential
}

# ⟨2026-09-14⟩ CDO-gated tests also live in `--lib`, and this script once ran
# only integration targets, so they were on NO runner (two real failures hid
# there: a stale CDO dedup count, and a grammar cache key — the latter not
# CDO-gated at all, which is why the whole lib ran here until 2026-11-09).
# ⟨2026-11-09⟩ Since then the debug task gate (`scripts/ci-steps task`) runs the
# WHOLE lib on every task, so the tests that read no CDO_WS run there with the
# same result; this phase runs only the lib tests whose path holds `cdo`. A CDO
# test outside that filter cannot hide: the shared gate (`crate::cdo::
# cdo_ws_or_enforce`) panics in the task gate for any test the filter misses,
# and `cdo_ws_is_read_only_through_the_gate` refuses a test that reads CDO_WS
# around it. Threads: 4 when it runs alone; 2 or 1 beside the impact phase
# (`plan_layout`, TLS-32). The CDO tests each build their own model; measured
# alone (TLS-32's census, 2026-11-13, cdo profile, one test per process):
# `retained_emission_equals_a_composition_on_cdo` 18,628 MiB and 105 s, every
# other test at most 4,552 MiB, 507 s summed (note `2026-11-13-lib-cdo-census.md`).
#
# ⟨TLS-36⟩ Longest first: libtest starts tests in name order, so the longest
# (`retained_emission`, ~105 s alone) started last and left a tail. The phase
# runs the five longest by name first (`--exact`), then the rest (`--skip` each),
# in every layout. The summary sums both runs' counts. `--skip` matches a
# SUBSTRING while the first run matches exactly, so a long test renamed to a
# longer name (`..._v2`) would run in neither (review r1, sol and Opus): the first
# run must report every long test (passed, failed or ignored), or the phase
# fails and says to update `lib_long_tests`.
lib_long_tests=(
    engine::resident::revision::tests::retained_emission_equals_a_composition_on_cdo
    engine::l5::digest::wave2_index_tests::cdo_crossing_census
    engine::l4::capability_cone::scc_set_tests::derived_only_matches_raw_fold_on_cdo
    engine::l5::digest::no_path_tests::cdo_i369_no_path_rows_and_fact_ids
    engine::l4::pd_solve::tests::parallel_solve_equals_the_serial_walk_on_cdo
)
lib_tests() {
    local skips=() t first rest
    for t in "${lib_long_tests[@]}"; do skips+=(--skip "$t"); done
    # A test the second run's substring `--skip` drops but that is no long test
    # (a sibling `..._v2` added beside one) would run in neither run: refuse it
    # (review r2, sol). From libtest's own listing of the phase's tests.
    # A listing that fails says nothing about orphans: the phase fails (review
    # r3, sol: it would otherwise read as "none").
    local listing orphans
    if ! listing=$(cargo test "${profile[@]}" -p al-sem --lib -- cdo --list 2>&1); then
        echo "cdo-gate: lib_cdo: could not list the phase's tests:"
        echo "$listing" | tail -n 20
        return 1
    fi
    orphans=$(printf '%s\n' "$listing" |
        sed -n 's/: test$//p' | awk -v long="${lib_long_tests[*]}" '
            BEGIN { n = split(long, l, " ") }
            { exact = 0; caught = 0
              for (i = 1; i <= n; i++) { if ($0 == l[i]) exact = 1; else if (index($0, l[i])) caught = 1 }
              if (caught && !exact) print }')
    if [[ -n "$orphans" ]]; then
        echo "cdo-gate: lib_cdo: these tests would run in neither of lib_cdo's runs (a long test's name is part of theirs): $orphans; rename them or update lib_long_tests"
        return 1
    fi
    "${lane2_nice[@]}" "${lane2_pin[@]}" \
        cargo test "${profile[@]}" -p al-sem --lib -- --exact "${lib_long_tests[@]}" \
        --test-threads="$lib_threads" 2>&1 | tee "$logs/lib_cdo.long"
    first=${PIPESTATUS[0]}
    local seen
    seen=$(grep -oE 'test result: [A-Za-z]+\. [0-9]+ passed; [0-9]+ failed; [0-9]+ ignored' \
        "$logs/lib_cdo.long" | awk '{ n += $4 + $6 + $8 } END { print n + 0 }')
    if [[ "$seen" -ne "${#lib_long_tests[@]}" ]]; then
        echo "cdo-gate: lib_cdo: the long-test run found $seen of ${#lib_long_tests[@]} tests by name (exit $first): a renamed long test (update lib_long_tests in scripts/cdo-gate), or the run died before its result line"
        first=1
    fi
    "${lane2_nice[@]}" "${lane2_pin[@]}" \
        cargo test "${profile[@]}" -p al-sem --lib cdo -- "${skips[@]}" \
        --test-threads="$lib_threads"
    rest=$?
    ((first == 0 && rest == 0))
}
phase_lib() {
    run_phase lib_cdo lib_tests
}

lane2() {
    phase_harness
    phase_lsp
    phase_l4
    phase_lib
}

# ⟨2026-11-09⟩ Lane 2 runs at a lower CPU priority (`nice -n 10`): beside it
# runs the gate's longest phase, the impact ratchets' one-shot `alsem impact`
# calls (minutes each, ~3 cores each). Starved at the start (every other test
# busy) they ran longest; lane 2 takes what they leave. (Beside `output_cdo`
# until TLS-23; beside the impact phase since TLS-32. Run after it, the nice
# costs nothing.)
lane2_nice=(nice -n 10)
# ⟨TLS-36⟩ Beside the impact phase, lane 2 is also pinned with `taskset` to the
# CPUs `lane2_cpus` picks (by default every efficiency core; `plan_layout` sets
# it). Its tests' thread pools size themselves from the
# CPUs they may use (rayon, `available_parallelism`), so lane 2 takes at most
# those, and the impact phase keeps the rest. TLS-32's first parallel gate had
# lane 2's tests at 2.3-3.3x their time alone and the impact phase at 472 s
# against ~350: both fought for every core. Empty: no pin.
lane2_pin=()
# ⟨TLS-19⟩ The container's memory while the test lanes run, against its
# `memory.max`, in the summary. Not `memory.current`: it counts page cache,
# which the kernel reclaims before any OOM, so it sat at the limit (49151 of
# 49152 MiB) on a gate that never came near one. What cannot be reclaimed is
# `memory.stat`'s anon + shmem + kernel minus slab_reclaimable; its highest
# value, sampled every 2 s, is the headroom the 4 GiB rule is about. The
# cgroup's own `memory.events` counters (oom, oom_kill, and max: times the
# limit was hit and the kernel had to reclaim) are kept at the start and the
# end, so the summary shows what this run added.
unreclaimable_bytes() {
    awk '$1 == "anon" || $1 == "shmem" || $1 == "kernel" { n += $2 }
         $1 == "slab_reclaimable" { n -= $2 }
         END { print n + 0 }' /sys/fs/cgroup/memory.stat
}
# ⟨TLS-23⟩ The container counts every agent's processes, not only the gate's.
# Each sample also sums the RSS of the gate's own process tree (descendants of
# this script; shared pages count once per process, so it over-counts a little)
# and names its three largest processes, in `memory.timeline` (epoch seconds,
# unreclaimable MiB, gate MiB, top three), beside `phases.times` (phase starts
# and ends). The summary gives the gate's share at the container's peak.
gate_tree_rss() {
    ps -e -o pid=,ppid=,rss=,comm= | awk -v root="$1" '
        { parent[$1] = $2; rss[$1] = $3; name[$1] = $4 }
        END {
            for (p in parent) {
                q = p
                while (q != root && (q in parent) && q != parent[q]) q = parent[q]
                if (q == root) print rss[p], name[p] "/" p
            }
        }' | sort -rn | awk '{ kib += $1 } NR <= 3 { top = top " " $2 ":" int($1 / 1024) }
                             END { print int(kib / 1024) top }'
}
memory_sampler() {
    local cg=/sys/fs/cgroup peak=0 cur gate
    [[ -r "$cg/memory.stat" ]] || return 0
    cp "$cg/memory.events" "$logs/memory.events.start" 2>/dev/null
    while :; do
        cur=$(unreclaimable_bytes) || break
        gate=$(gate_tree_rss "$gate_pid")
        echo "$(date +%s) $((cur >> 20)) $gate" >> "$logs/memory.timeline"
        ((cur > peak)) && peak=$cur && echo "$peak $(cat "$cg/memory.max" 2>/dev/null) ${gate%% *}" > "$logs/memory.unreclaimable"
        sleep 2
    done
}
memory_sampler &
sampler=$!
# ⟨TLS-32⟩ The layout (`plan_layout`), decided when the parallel section would
# start: after `output_cdo`, whose memory is then freed.
if [[ "${CDO_GATE_SERIAL:-}" == "1" ]]; then
    lane2_nice=()
    lane2
    phase_output_cdo
    plan_layout
    echo "$layout_line" > "$logs/layout"
    phase_output_cdo_impact
else
    phase_output_cdo
    plan_layout
    echo "$layout_line" > "$logs/layout"
    if ((lane2_beside)); then
        lane2 &
        lane2_pid=$!
        phase_output_cdo_impact
        wait "$lane2_pid"
    else
        lib_threads=4
        phase_output_cdo_impact
        lane2
    fi
fi
echo "cdo-gate: layout: $(cat "$logs/layout")"
kill "$sampler" 2>/dev/null
cp /sys/fs/cgroup/memory.events "$logs/memory.events.end" 2>/dev/null

summarize
exit $?
