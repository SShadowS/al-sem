#!/usr/bin/env bash
# scripts/cdo-gate — Task T0.2: the CDO ratchet's ENFORCE-gated release runner.
#
# Runs the north-star CDO-gated test suite against a real Business Central
# workspace with ENFORCE_CDO_WS=1, so any test that would otherwise silently
# skip when CDO_WS is unset fails loudly instead (see tests/common/cdo.rs).
# CI cannot reach the CDO workspace — this script is meant to be scheduled
# locally (cron / Task Scheduler), not run in CI.
#
# Usage:
#   scripts/cdo-gate <path-to-cdo-workspace>
#   CDO_WS=/path/to/workspace scripts/cdo-gate
#
# A positional argument takes precedence over the CDO_WS env var when both
# are given.
set -uo pipefail

ws="${1:-${CDO_WS:-}}"

if [[ -z "$ws" ]]; then
    echo "cdo-gate: error: no workspace given and CDO_WS is unset" >&2
    echo "usage: scripts/cdo-gate <path-to-cdo-workspace>   (or: CDO_WS=<path> scripts/cdo-gate)" >&2
    exit 2
fi

if [[ ! -e "$ws" ]]; then
    echo "cdo-gate: error: workspace path does not exist: $ws" >&2
    exit 2
fi

export CDO_WS="$ws"
export ENFORCE_CDO_WS=1

echo "cdo-gate: CDO_WS=$CDO_WS ENFORCE_CDO_WS=1"

# ⟨2026-10-04, test tiers⟩ Built with `release-fast` (thin LTO, 4 codegen units),
# not full-LTO `release`. This gate checks BEHAVIOUR — counts, digests, zero
# ratchets — and both profiles are optimized with debug assertions off, so they
# run the same code paths; full LTO only bought a much slower link of every test
# executable. Timing claims still need full `release` (`perf_bounds`, benches, the
# SHA-pinned north-star measure — CLAUDE.md "Build Commands").
profile=(--profile release-fast)

status=0

echo "cdo-gate: running program_resolve_harness (--test-threads=1)..."
if ! cargo test "${profile[@]}" --test program_resolve_harness -- --test-threads=1; then
    status=1
fi

echo "cdo-gate: running program_graph + snapshot_robustness..."
if ! cargo test "${profile[@]}" --test lsp -- program_graph:: snapshot_robustness::; then
    status=1
fi

# ⟨task-3 fix wave, review I-2⟩ The CDO whole-program L4 frozen digest
# (`tests/l4-summary-baseline/cdo-whole-program-digest.txt`) is a CDO-gated ratchet
# exactly like the two above, but it was on NO runner: this script never listed
# `--test l4_summary_differential`, so the review's prediction that "the next
# cdo-gate run will fail on the frozen baseline" was wrong for a reason worse than
# being wrong — the gate could not fail, because it never ran. It runs here now, so
# ENFORCE_CDO_WS=1 applies to it too (a missing CDO_WS panics instead of skipping).
# The fixture members of the same target are cheap and run alongside it.
echo "cdo-gate: running l4_summary_differential (CDO whole-program frozen digest)..."
if ! cargo test "${profile[@]}" --test l4_summary_differential; then
    status=1
fi

# ⟨2026-09-14⟩ The SAME defect as the l4 digest above, found the same way and
# twice in one day: CDO-gated tests also live in `--lib`, and this script ran
# only integration targets, so they were on NO runner here either.
#
# Two real failures hid behind that gap on 2026-09-14:
#   - `cache_version_grammar_tracks_the_linked_grammar` (src/engine/gate/
#     cache_prune.rs) during the tree-sitter-al v4.4.0 bump — a stale cache key
#     that would have let caches minted under the old grammar be reused under the
#     new one;
#   - `cdo_dedup_names_the_real_dropped_duplicates` (src/snapshot/snapshot.rs)
#     during the CDO baseline pin — a duplicate-GUID count describing the OLD
#     workspace's layout.
# Both arcs ran cdo-gate AND check-goldens, both went green, both merged, and
# both left `master` red for `cargo test` on any machine with CDO_WS set, while
# GitHub CI stayed green because CI has no CDO_WS at all. Neither runner runs
# `--lib`: `check-goldens` drives the nine golden-bearing integration targets,
# and this script drove three more.
#
# The whole lib is run, not a `cdo_`-filtered subset: the grammar cache-key test
# is not CDO-gated at all, and filtering to the tests we already know about is
# how a gate ends up blind to the next one. ENFORCE_CDO_WS=1 applies here too,
# so a CDO-gated lib test cannot silently skip.
echo "cdo-gate: running the library test suite (--lib)..."
if ! cargo test "${profile[@]}" -p al-sem --lib; then
    status=1
fi

if [[ "$status" -eq 0 ]]; then
    echo "cdo-gate: PASS"
else
    echo "cdo-gate: FAIL"
fi

exit "$status"
