#!/usr/bin/env bash
# scripts/check-goldens — run the byte-compared golden test families in one shot.
#
# WHY: a change under tests/r0-corpus/ (fixtures), src/engine/, or a golden dir can
# move MORE golden families than the one you were looking at. In the BCQuality wave,
# editing a fixture and regenerating only `--test r4` left the l2_features.snapshot
# (l2_ir) stale and two commits shipped red. This script runs every golden-bearing
# target together so that never happens again.
#
# ⟨task-3 fix wave, review I-3⟩ The list below used to be five targets and covered
# 15 of the repo's THEN-27 golden directories (30 today, ⟨final-branch-review-l3.md
# M-4⟩ — see the map below for the current, authoritative enumeration). `--test r3`
# (r3a1/r3a2/r3a3/r3a4/r3a5 —
# 483 files, 93 of them id-bearing), `--test r25_abi` (7 files) and
# `--test l4_summary_differential` (18 files) were missing entirely, so the task-3
# id-schema change moved `tests/r3a3-goldens/` behind a green `check-goldens` — the
# exact BCQuality failure this script exists to prevent, one directory over. The
# `--regen` path was missing them too, so the documented canonical loop could not
# even PRODUCE the r3a3 movement that commit had to make; only a bare
# `REGEN_TEMP_GOLDENS=1 cargo test` could. `--test program_resolve_harness` was also
# missing (`tests/goldens/semantic-edges/`, 2 non-CDO byte-compared goldens).
#
# Golden directory -> owning test target map (30 directories; keep in sync with
# CLAUDE.md "Goldens"). Every directory below is a `REGEN_TEMP_GOLDENS`-gated byte
# comparison:
#   tests/r4-goldens/, tests/r4f-goldens/                     -> --test r4
#   tests/ir-l2-goldens/            (the l2_features.snapshot) -> --test l2_ir
#   tests/cli-a-goldens/, cli-b-, cli-c-, cli-c-events-,
#     cli-c-policy-, cli-query-goldens/, gate-goldens/,
#     al2dump-smoke-goldens/, aldump-smoke-goldens/            -> --test cli
#   tests/r0-, r1a-, r2a-, r2b-, r2c-, r2d-goldens/            -> --test differential
#   tests/r3a1-, r3a2-, r3a3-, r3a4-, r3a5-goldens/            -> --test r3
#   tests/r2-5a-goldens/, r2-5b-{cg,cov,eg,rt}-goldens/        -> --test r25_abi
#   tests/l4-summary-baseline/                                 -> --test l4_summary_differential
#   tests/goldens/semantic-edges/                              -> --test program_resolve_harness
#
# ⟨final-branch-review-l3.md M-5⟩ `--test l3` (the l3cg/l3cov/l3eg/l3rt oracle +
# vectors suite) owns NO byte-compared golden directory of its own — despite the
# name, `l3eg_oracles.rs` explicitly documents that it is NOT a golden diff
# against al-sem expected strings; that comparison is `tests/r2c-goldens/*.l3eg.
# golden.json`, read only by `tests/differential.rs` (already listed above). It
# stays in `targets` below because it is still part of the suite this script runs
# `--no-fail-fast` together, not because it owns a golden directory.
#
# ⟨Task 6⟩ `tests/cli-query-goldens/` (the `alsem query` db-effect query family)
# needs no new target — it is a member of the `cli` umbrella, which is already
# listed. It IS the reason `ReverseEffectIndex` cannot go back to having zero
# production callers: every run of this script executes the transpose, both
# up-queries, the ancestor BFS and the facade, through the shipped binary.
#
# A note on `--regen` and `tests/r3a3-goldens/`: r3a3's regen path is
# CONTENT-CHANGE-GATED by design (`tests/r3/r3a3_differential.rs` — it skips any
# golden whose structural `serde_json::Value` already matches, so a rebaseline diff
# is not swamped by pure key-order churn). So `--regen` legitimately writes ZERO
# r3a3 files when nothing moved; it writes exactly the ones that did. Verified by
# construction in the task-3 fix wave: corrupting one r3a3 golden makes plain
# `check-goldens` fail on `--test r3` (it did not even RUN before) and
# `check-goldens --regen` restores it byte-for-byte.
#
# NOT covered here, deliberately: the CDO-gated members of the last two targets
# (`cdo_whole_program_v2_matches_frozen_digest`, and most of
# `program_resolve_harness`). This script unsets `CDO_WS`/`ENFORCE_CDO_WS` so they
# always skip here, whatever the caller's environment: in a debug build they cost
# ~5 minutes per run (measured 2026-10-04: `abi_ingestion_integrity_cdo_gate`
# alone took 243 s), and `scripts/cdo-gate` already runs every one of them in an
# optimized build with `ENFORCE_CDO_WS=1`. Before 2026-10-04 an exported `CDO_WS`
# made them run here too, which is why this script was slow on some machines.
#
# Usage:
#   scripts/check-goldens            # verify (no regen) — exits nonzero on any stale golden
#   scripts/check-goldens --regen    # REGEN_TEMP_GOLDENS=1 first (inspect the diff!), then verify
set -uo pipefail

# ---------------------------------------------------------------------------
# COVERAGE GUARD — `--verify-coverage`
#
# WHY THIS EXISTS: this script silently covered 15 of the then-27 golden
# directories for two whole arcs. Every "goldens clean" claim in that window
# rested on it, and nothing in the repo noticed — it took a whole-branch review,
# and the first two repairs of the gap were ALSO incomplete (they missed
# `src/bin/` and `src/program/`, where the binaries that mint several families
# actually live). The failure mode is not "someone forgets to run the gate", it
# is "the gate runs, passes, and was never looking at the new family".
#
# So: the enumeration below is DECLARED, and `--verify-coverage` fails when a
# golden-bearing directory exists on disk that is not in it. Adding a family now
# forces a conscious edit here — which is the moment to also add its owning
# target to `targets` above. Run by `scripts/git-hooks/pre-commit`.
#
# A directory belongs here if it holds byte-compared regression data: the
# `*goldens*` dirs, `tests/goldens/`, the frozen `l4-summary-baseline/`, and the
# `*-vectors/` oracles (`r0-vectors/encoder-vectors.json` is the encoder's only
# remaining oracle now that the al-sem differential is retired).
declared_dirs=(
    tests/al2dump-smoke-goldens
    tests/aldump-smoke-goldens
    tests/cli-a-goldens
    tests/cli-b-goldens
    tests/cli-c-events-goldens
    tests/cli-c-goldens
    tests/cli-c-policy-goldens
    tests/cli-query-goldens
    tests/gate-goldens
    tests/goldens
    tests/ir-l2-goldens
    tests/l4-summary-baseline
    tests/r0-goldens
    tests/r0-vectors
    tests/r1a-goldens
    tests/r1a-vectors
    tests/r1b-vectors
    tests/r1c-vectors
    tests/r1d-vectors
    tests/r2-5a-goldens
    tests/r2-5a-vectors
    tests/r2-5b-cg-goldens
    tests/r2-5b-cov-goldens
    tests/r2-5b-eg-goldens
    tests/r2-5b-rt-goldens
    tests/r2a-goldens
    tests/r2a-vectors
    tests/r2b-goldens
    tests/r2b-vectors
    tests/r2c-goldens
    tests/r2c-vectors
    tests/r2d-goldens
    tests/r2d-vectors
    tests/r3a1-goldens
    tests/r3a1-vectors
    tests/r3a2-goldens
    tests/r3a2-vectors
    tests/r3a3-goldens
    tests/r3a3-vectors
    tests/r3a4-goldens
    tests/r3a4-vectors
    tests/r3a5-goldens
    tests/r4-goldens
    tests/r4f-goldens
)

if [[ "${1:-}" == "--verify-coverage" ]]; then
    repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
    cd "$repo_root" || exit 1
    on_disk=$(ls -d tests/*goldens*/ tests/goldens/ tests/l4-summary-baseline/                      tests/*-vectors/ 2>/dev/null | sed 's|/$||' | sort -u)
    declared=$(printf '%s
' "${declared_dirs[@]}" | sort -u)
    undeclared=$(comm -23 <(printf '%s
' "$on_disk") <(printf '%s
' "$declared"))
    missing=$(comm -13 <(printf '%s
' "$on_disk") <(printf '%s
' "$declared"))
    rc=0
    if [[ -n "$undeclared" ]]; then
        echo "check-goldens: UNDECLARED golden directories (on disk, not in declared_dirs):" >&2
        printf '  %s
' $undeclared >&2
        echo "  -> add each to declared_dirs in scripts/check-goldens AND make sure its" >&2
        echo "     owning test target is in the 'targets' array, or the gate will pass" >&2
        echo "     while never looking at it. That has already happened twice." >&2
        rc=1
    fi
    if [[ -n "$missing" ]]; then
        echo "check-goldens: declared golden directories that no longer exist:" >&2
        printf '  %s
' $missing >&2
        echo "  -> remove them from declared_dirs (a stale entry hides a real gap)." >&2
        rc=1
    fi
    [[ $rc -eq 0 ]] && echo "check-goldens: coverage OK ($(printf '%s
' "$on_disk" | wc -l) golden dirs declared)"
    exit $rc
fi

targets=(
    --test r4
    --test l2_ir
    --test l3
    --test cli
    --test differential
    --test r3
    --test r25_abi
    --test l4_summary_differential
    --test program_resolve_harness
)

# `--no-fail-fast`: without it cargo aborts the whole run on the FIRST failing test
# binary, so one stale family hides every later target — you fix it, re-run, and
# discover the next one. A golden gate must report every stale family in one pass.
# ⟨task-3 fix wave, review I-3(2)⟩
unset CDO_WS ENFORCE_CDO_WS

if [[ "${1:-}" == "--regen" ]]; then
    echo "check-goldens: regenerating (REGEN_TEMP_GOLDENS=1) — INSPECT the diff before committing"
    REGEN_TEMP_GOLDENS=1 cargo test --no-fail-fast "${targets[@]}" || exit 1
    echo "check-goldens: re-running WITHOUT regen to confirm green"
fi

env -u REGEN_TEMP_GOLDENS cargo test --no-fail-fast "${targets[@]}"
