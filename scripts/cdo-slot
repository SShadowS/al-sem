#!/usr/bin/env bash
# scripts/cdo-slot — the one CDO slot of this tentacle: who may run CDO-heavy or
# timed work (a landing, cdo-gate, a CDO measurement) right now.
#
# ⟨TLS-60⟩ Replaces hold messages: 147 of the orchestrator's 316 messages were
# about holds, and at least 9 times a lane's run had already started when the
# hold arrived. A session (or script) acquires the slot; the PreToolUse hook
# `scripts/claude-hooks/cdo-slot-guard` then refuses gates and CDO runs from
# every OTHER session until it is released, and builds and tests from EVERY
# session while a timing runs (--timed, TLS-89).
#
#   acquire <owner> <reason> [--wait] [--timeout S] [--bind PID] [--timed]
#       Take the slot. It is taken when nobody holds it, no timing runs,
#       MemAvailable >= 35 GB (CDO_SLOT_MEM_MIN_GB), and no earlier waiter that
#       can run now is waiting (see the queue below). Without --wait it refuses at
#       once (exit 1, naming the holder); with --wait it polls every 15 s, prints
#       the holder about every 60 s, and gives up after --timeout seconds of
#       awake time (TLS-105: a host suspend does not count; default: never) or
#       when the bound process ends. Waiters are served in
#       arrival order (TLS-88): a free slot goes to the oldest waiter still alive,
#       and an acquire without --wait refuses while anyone waits. A waiter short
#       of memory steps aside until it has it, keeping its place.
#       The hold is kept by a detached keeper process. It ends when the --bind
#       PID ends (even killed outright), else when the acquiring Claude process
#       (CLAUDE_PID) ends, else at `release`. Outside a Claude session an acquire
#       must be bound (or come from `run`).
#       Exit 0: taken. Exit 4: already yours, nothing to release: the holder's
#       CDO_SLOT_TOKEN is in the environment (a script's hold, shared with what
#       it starts), or this Claude session holds it unbound (by hand).
#       --timed (needs --bind; TLS-89): a timing runs in the hold, taken or
#       shared, while the bound process lives, so no build may. It takes the
#       timing lock first (the guard then refuses new builds and tests), then
#       waits for the build processes already running (cargo, cargo-nextest,
#       rustc, rustdoc: CDO_SLOT_BUILD_NAMES; and scripts/ci-steps, check-goldens
#       between their cargo steps: CDO_SLOT_BUILD_SCRIPTS; and every live
#       build entry point `enter` recorded and not `quiet`, TLS-135) outside the
#       bound process's own line, printing their PIDs every ~60 s, until none is seen
#       for CDO_SLOT_TIMED_GRACE_S (3) s in a row (a command the guard allowed a
#       moment before starts a moment later). A build still seen at
#       CDO_SLOT_TIMED_WAIT_S (1800) s, or the hold gone by then: exit 6, no
#       timing (and the hold released, when this acquire took it); never a
#       silent start beside a build. One timing per slot at a time (TLS-135,
#       replacing TLS-89's shared timings): every timed start is checked and
#       published under one gate (`timing-gate.lock`), and is refused at once
#       (exit 6) while a timing outside its own line runs (its own: one whose
#       process, or whose `run` command, is this process or an ancestor).
#   release
#       Give the slot back: end its keeper. Only its holder may (its session or
#       token). A hold taken by `run` ends with that run, never by `release`.
#   status
#       `free` (exit 0), or `held by ...` (exit 1). While a timing runs it adds a
#       line `timed by <owner> since <time> (<reason>)` (exit 1, even when free).
#       ⟨TLS-104⟩ Either line names the seconds the host spent suspended since
#       (`scripts/host-suspended`; server1 is a laptop that sleeps when moved),
#       2 s or more: an old hold can be a laptop that slept, not a hung holder.
#   probe
#       For the guard: `held=<0|1> own=<0|1> timed=<0|1>` (own: this Claude
#       session's hold, bound or not), then the hold's and the timing's lines.
#   enter [--wait] <name>
#       For a build entry point (scripts/build-entry, TLS-135), the caller (this
#       process's parent). It records the caller first (`entries/<pid>.<start
#       time>`; a timed acquire counts each live one as a build, unless it is
#       quiet), then decides: exit 0 when no timing runs but the caller's own
#       line's (the timing's command or bind PID, with its start time, is the
#       caller or an ancestor); exit 3, the record taken back, when another
#       timing runs; exit 5 when the record cannot be made (never an
#       admission). No run admits its steps: each step decides for itself. With
#       --wait (after exit 3): parked (`parked/`, so a timed acquire does not
#       count the caller), wait for no such timing, saying so about every 60 s,
#       then record and decide again, until exit 0, or exit 6 when
#       CDO_SLOT_ENTRY_WAIT_S (3600) s of awake time have passed since the wait
#       began: one deadline for all its rounds (checked after every round), no
#       sleep past it.
#   quiet <on|off>
#       For a recorded entry (the caller), around a foreground step it waits
#       for (scripts/build-entry `build_step`): while on (`quiet/<pid>.<start
#       time>`) a timed acquire does not count the caller; the step counts by
#       itself. Exit 5 when the state cannot be set or cleared.
#   run <owner> <reason> [--timed] -- <command...>
#       acquire --wait, in this process, run the command. The hold (and the
#       timing) is this process's and its command's: it ends when the last of
#       them ends, killed or not. Inside a holder's run (its token) it shares the
#       hold and just runs.
#
# ⟨TLS-89, the invariant⟩ Only kernel locks decide; files describe. The hold is
# an exclusive flock on `$CDO_SLOT_DIR/lock` (default /work/.al-sem/cdo-slot)
# plus one on `id/hold.<hid>`, a fresh random id per hold. A timing is a SHARED
# flock on `timed.lock` (each timing takes its own) plus one on
# `id/timed.<tid>`. A process that dies drops its locks, so no hold or timing
# outlives every process that has it, and none is ever ended by guessing that a
# process is gone. Every decision is one lock probe (a flock with a 0.1 s wait,
# `probe`), never a read of a file. The status file (owner, reason, start,
# session, bound PID, holder PID, token, hid) is written once, whole, by the
# hold's own holder; a reader trusts it only for the hold whose id lock it then
# probes as held (a file of an older hold names a dead id). A timing's own file
# (`timed/<tid>`) is read the same way. ⟨TLS-127⟩ A holder keeps
# `publish.lock` (shared) from before its hold lock until its status is renamed
# in, so a reader asks that lock whether a hold with no status yet is still
# being written, instead of guessing from the lock file's age (a take slowed past
# 5 s by load or a suspend read as an unknown holder). Five review rounds found race windows
# in the earlier file-and-liveness design (TLS-89 CHANGELOG); a lock probe has
# no window: the kernel answers for that instant.
set -euo pipefail

usage() {
    sed -n '/^#   acquire/,/^#       hold and just runs/p' "$0" | sed 's/^# \{0,1\}//'
    echo "Environment: CDO_SLOT_DIR, CDO_SLOT_MEM_MIN_GB (35), CDO_SLOT_POLL_S (15),"
    echo "CDO_SLOT_TIMED_WAIT_S (1800), CDO_SLOT_TIMED_GRACE_S (3), CDO_SLOT_LOCK_WAIT_S (30), CDO_SLOT_ENTRY_WAIT_S (3600),"
    echo "CDO_SLOT_BUILD_NAMES (cargo cargo-nextest rustc rustdoc), CDO_SLOT_BUILD_SCRIPTS (ci-steps check-goldens)."
}
die() {
    echo "cdo-slot: $*" >&2
    exit 1
}

self=$(realpath "$0")
# One spelling of the folder (a trailing slash or a symlink must not make two
# names for one lock, or a holder search by path miss it).
dir=$(realpath -m "${CDO_SLOT_DIR:-/work/.al-sem/cdo-slot}")
lock="$dir/lock"
ids="$dir/id"
# Not `timed`: TLS-89's first design kept a timing mark in a FILE of that name,
# and one left in the real slot folder stopped every timing (its manual landing).
tdir="$dir/timings"
timed_lock="$dir/timed.lock"
status_file="$dir/status"
publish_lock="$dir/publish.lock"
mem_min="${CDO_SLOT_MEM_MIN_GB:-35}"
poll="${CDO_SLOT_POLL_S:-15}"
timed_wait="${CDO_SLOT_TIMED_WAIT_S:-1800}"
timed_grace="${CDO_SLOT_TIMED_GRACE_S:-3}"
lock_wait="${CDO_SLOT_LOCK_WAIT_S:-30}"
# An acquire's --timeout as a deadline in µs, so a take (in this process or its
# keeper) waits for the publish lock only the awake time left of it at the lock
# attempt: pub_deadline on CLOCK_MONOTONIC (stops in a suspend, never steps; one
# boot, which a keeper shares with its acquire), pub_deadline_wall on the wall
# clock, used only when the monotonic clock cannot be read (review r3, sol).
# Both empty: no --timeout.
pub_deadline="" pub_deadline_wall=""
entry_wait="${CDO_SLOT_ENTRY_WAIT_S:-3600}"
# ⟨TLS-135⟩ Running build entry points (`entries/<pid>`), and those parked in
# `enter --wait` (scripts/build-entry).
entries="$dir/entries"
parked_dir="$dir/parked"
quiet_dir="$dir/quiet"
build_names="${CDO_SLOT_BUILD_NAMES:-cargo cargo-nextest rustc rustdoc}"
build_scripts="${CDO_SLOT_BUILD_SCRIPTS:-ci-steps check-goldens}"
[[ "$mem_min" =~ ^(0|[1-9][0-9]{0,5})$ ]] || die "CDO_SLOT_MEM_MIN_GB '$mem_min': whole GB, no leading zero"
[[ "$poll" =~ ^[1-9][0-9]{0,3}$ ]] || die "CDO_SLOT_POLL_S '$poll': whole seconds"
[[ "$timed_wait" =~ ^(0|[1-9][0-9]{0,6})$ ]] || die "CDO_SLOT_TIMED_WAIT_S '$timed_wait': whole seconds"
[[ "$timed_grace" =~ ^(0|[1-9][0-9]?)$ ]] || die "CDO_SLOT_TIMED_GRACE_S '$timed_grace': whole seconds, at most 99"
[[ "$lock_wait" =~ ^[1-9][0-9]{0,3}$ ]] || die "CDO_SLOT_LOCK_WAIT_S '$lock_wait': whole seconds"
[[ "$entry_wait" =~ ^(0|[1-9][0-9]{0,6})$ ]] || die "CDO_SLOT_ENTRY_WAIT_S '$entry_wait': whole seconds"
[[ "$build_names" =~ ^[A-Za-z0-9._\ -]+$ ]] || die "CDO_SLOT_BUILD_NAMES '$build_names': process names, space-separated"
# A process name (comm) holds at most 15 characters: a longer one never matches.
for n in $build_names; do
    ((${#n} <= 15)) || die "CDO_SLOT_BUILD_NAMES: '$n' is longer than a process name (15 characters)"
done
[[ "$build_scripts" =~ ^[A-Za-z0-9._\ -]+$ ]] || die "CDO_SLOT_BUILD_SCRIPTS '$build_scripts': script names, space-separated"
me_session="${CLAUDE_CODE_SESSION_ID:-}"
me_pid="${CLAUDE_PID:-}"
me_token="${CDO_SLOT_TOKEN:-}"
bind="" bind_start=""
command -v flock >/dev/null || die "flock is needed"

# proc_fields <pid>: its /proc stat fields from the state on (state = $1,
# start time = $20); nothing when it is gone.
proc_fields() { sed 's/.*) //' "/proc/$1/stat" 2>/dev/null || true; }
# alive <pid> [start]: running (a zombie is not) and, with a start time, still
# the same process (not a reused PID). Used only to END things (a keeper's
# watch, a waiter's ticket), never to decide who holds what.
alive() {
    [[ "${1:-}" =~ ^[1-9][0-9]*$ ]] || return 1
    local f
    read -r -a f <<<"$(proc_fields "$1")"
    [[ ${#f[@]} -gt 19 && "${f[0]}" != Z ]] || return 1
    [[ -z "${2:-}" || "${f[19]}" == "$2" ]]
}
proc_start() { local f; read -r -a f <<<"$(proc_fields "$1")"; echo "${f[19]:-}"; }
# live_start <pid>: its start time when it runs (not a zombie), from ONE read
# of its stat (the state and the start time of the same process); nothing and
# 1 when it does not (review r11, sol).
live_start() {
    [[ "${1:-}" =~ ^[1-9][0-9]*$ ]] || return 1
    local f
    read -r -a f <<<"$(proc_fields "$1")"
    [[ ${#f[@]} -gt 19 && "${f[0]}" != Z ]] || return 1
    echo "${f[19]}"
}
new_id() { od -An -N8 -tx8 /dev/urandom | tr -d ' '; }
# glob_quote <text>: <text> with the glob characters escaped, for `find
# -lname` (a pattern; review r11, Fable).
glob_quote() { sed 's/[][*?\\]/\\&/g' <<<"$1"; }
# test_pause <seconds>: the test hooks' window. It writes `paused.<pid>` (the
# test waits for it), then waits until the test makes `$dir/resume`, at most
# <seconds>. A fixed sleep could end before the test's steps in the window did
# under load (TLS-89's gates). [name]: wait for `$dir/<name>` instead, so a test
# can end one of two pauses (TLS-127).
# test-hooks: CDO_SLOT_TEST_KEEPER_FORK CDO_SLOT_TEST_PAUSE_ACQUIRED_S CDO_SLOT_TEST_PAUSE_GO_S
# test-hooks: CDO_SLOT_TEST_PAUSE_GRACE_S CDO_SLOT_TEST_PAUSE_HELD_S CDO_SLOT_TEST_PAUSE_HOLDGO_S
# test-hooks: CDO_SLOT_TEST_PAUSE_PUBLISH_S
# test-hooks: CDO_SLOT_TEST_PAUSE_READ_S CDO_SLOT_TEST_PAUSE_REFUSE_S CDO_SLOT_TEST_PAUSE_S
# test-hooks: CDO_SLOT_TEST_PAUSE_SPAWN_S CDO_SLOT_TEST_PAUSE_TAKE_S CDO_SLOT_TEST_SCAN_ONCE
# test-hooks: CDO_SLOT_TEST_WRITE_PAUSE_S
# test-hooks: CDO_SLOT_TEST_PAUSE_ENTER_S CDO_SLOT_TEST_PAUSE_ENTER_NAME CDO_SLOT_TEST_PAUSE_RETRY_S
# test-hooks: CDO_SLOT_TEST_PAUSE_TIMED_GATE_S CDO_SLOT_TEST_PAUSE_KEEPER_S
# test-hooks: CDO_SLOT_TEST_KEEPER_STOP CDO_SLOT_TEST_SPAWN_STEPS CDO_SLOT_TEST_COMMIT_FAIL
# test-hooks: CDO_SLOT_TEST_PAUSE_COMMIT_S CDO_SLOT_TEST_PAUSE_COMMITTED_S CDO_SLOT_TEST_UNREADABLE_PID
# test-hooks: CDO_SLOT_TEST_REFUSE_HOLDER CDO_SLOT_TEST_FDINFO_UNREADABLE
test_pause() {
    : >"$dir/paused.$$"
    local w go="$dir/${2:-resume}"
    for ((w = 0; w < ${1%.*} * 20 + 20; w++)); do
        [[ -e "$go" ]] && break
        sleep 0.05
    done
    rm -f "$go"
}

# probe <s|x> <lock file>: 0 when some process holds the lock against a probe of
# that kind, 1 when not (or the file does not exist). `s` finds an exclusive
# holder (probes never block each other); `x` finds shared holders too (the
# timing lock). An `s` probe answers at once (-n): only a holder takes these locks
# exclusive, and one taking it as the probe runs is taking it. An `x` probe that
# finds the lock busy looks again with a 0.1 s wait: another `x` probe has it
# for an instant, a timing keeps it. (TLS-89's second landing: a 0.1 s wait on
# every busy probe made the guard test pass its 300 s watchdog under load.)
# Any other flock failure stops with exit 5 (the hook then allows: a broken probe
# is no holder).
probe() {
    [[ -e "$2" ]] || return 1
    local rc=0
    flock -"$1" -n -E 75 "$2" true 2>/dev/null || rc=$?
    if [[ "$1" == x && "$rc" == 75 ]]; then
        rc=0
        flock -x -E 75 -w 0.1 "$2" true 2>/dev/null || rc=$?
    fi
    case "$rc" in
        0) return 1 ;;
        75) return 0 ;;
        *)
            echo "cdo-slot: cannot probe the lock $2 (flock exit $rc)" >&2
            exit 5
            ;;
    esac
}
# holders_of <file>: "PID n (cmdline, state s)" for each process with the file
# open (/proc/locks cannot say: it hides a lock whose flock(1) has exited).
holders_of() {
    local p
    for p in $(find /proc/[0-9]*/fd -lname "$(glob_quote "$1")" 2>/dev/null | cut -d/ -f3 | sort -un); do
        # `2>` before `<`: a process gone since the scan must not print an error.
        printf 'PID %s (%s, state %s) ' "$p" "$(tr '\0' ' ' 2>/dev/null <"/proc/$p/cmdline" | cut -c1-80)" \
            "$(awk '{ print $3 }' "/proc/$p/stat" 2>/dev/null)"
    done
}
# keepers_of <file>: the PIDs of the keepers (`cdo-slot _keep`) that have the
# lock file open: found by the lock itself, never by a PID a file names.
keepers_of() {
    local p
    # Test hook: only this call's first scan finds anything, as when a later
    # scan misses a keeper that is still there (TLS-102's stress run).
    if [[ -n "${CDO_SLOT_TEST_SCAN_ONCE:-}" ]]; then
        [[ ! -e "$dir/scanned.$$" ]] || return 0
        : >"$dir/scanned.$$"
    fi
    for p in $(find /proc/[0-9]*/fd -lname "$(glob_quote "$1")" 2>/dev/null | cut -d/ -f3 | sort -un); do
        # An `if`, not `grep && echo`: a non-keeper listed last (a probe that
        # has the file open for an instant) left the loop's status 1, and
        # `ps=$(keepers_of ...)` under `set -e` then ended `release` with exit
        # 1 (TLS-89's landing, the queue test under load).
        is_keeper_cmd "$p" || continue
        # Only the keeper itself: each `$(...)` it runs forks a subshell with
        # its command line and descriptors for a moment (TLS-102's landing).
        is_keeper_cmd "$(ppid_of "$p")" && continue
        echo "$p"
    done
}
# is_keeper_cmd <pid>: that process runs `cdo-slot _keep`.
is_keeper_cmd() {
    [[ "${1:-}" =~ ^[1-9][0-9]*$ ]] || return 1
    tr '\0' ' ' <"/proc/$1/cmdline" 2>/dev/null | grep -q " _keep "
}

# write_atomic <file> <content>: the whole file at once (write, then rename): a
# reader sees the old file or the new one, never part of it.
write_atomic() {
    local tmp
    tmp="$1.w$$.$(new_id)"
    if [[ -n "${CDO_SLOT_TEST_WRITE_PAUSE_S:-}" ]]; then
        # Test hook: the first third, a pause, then the rest; a reader polling
        # meanwhile must never see the part. One open file throughout, as the
        # plain write: a temporary file removed in the pause fails the rename
        # (TLS-135 review r2, sol), it is not made again.
        local n third wfd
        n=$(wc -l <<<"$2")
        third=$((n / 3))
        exec {wfd}>"$tmp"
        head -n "$third" <<<"$2" >&"$wfd"
        : >"$dir/paused.$$"
        sleep "$CDO_SLOT_TEST_WRITE_PAUSE_S"
        tail -n +"$((third + 1))" <<<"$2" >&"$wfd"
        exec {wfd}>&-
        mv -f "$tmp" "$1"
        return
    fi
    printf '%s\n' "$2" >"$tmp" && mv -f "$tmp" "$1"
}
# load <file>: read it ONCE into snap; `field` reads from that copy.
snap=""
load() { snap=$(cat "$1" 2>/dev/null || true); }
field() { { sed -n "s/^$1=//p" <<<"$snap" || true; } | head -n 1; }

# The locks this process holds, so the sleeps of a keeper do not inherit them
# (a keeper killed outright must not leave a `sleep` child holding its hold).
held_fds=()
nap() {
    local r="" f
    for f in "${held_fds[@]}"; do r+=" $f>&-"; done
    eval "sleep $1$r"
}

# publish_busy: 0 a take holds the publish lock, 1 not, 2 it cannot be probed.
# Best effort (TLS-127 review, sol): a failed probe of this file must not end
# `probe` before its decision line, or the guard lets work run beside a hold.
publish_busy() {
    local rc=0
    [[ -e "$publish_lock" ]] || return 1
    # Only a regular file: opening a FIFO read-only blocks, and a guard's probe
    # that hangs is cut by the guard, which then lets work run (review r2, sol).
    [[ -f "$publish_lock" ]] || return 2
    # `probe x` on our own read-write descriptor: a read-write open never blocks,
    # even on a FIFO swapped in after the check (review r3, sol). Exit 1: free,
    # 0: busy (as `probe`), 5: it cannot be probed.
    (
        exec 9<>"$publish_lock" || exit 5
        r=0
        flock -x -n -E 75 9 || r=$?
        if [[ "$r" == 75 ]]; then
            r=0
            flock -x -E 75 -w 0.1 9 || r=$?
        fi
        case "$r" in
            0) exit 1 ;;
            75) exit 0 ;;
            *) exit 5 ;;
        esac
    ) 2>/dev/null || rc=$?
    ((rc <= 1)) && return "$rc"
    return 2
}

# state: from one probe of the hold lock, one read of the status, one probe of
# the id lock it names. st = free | mine | held; own = this Claude session's
# hold (bound or not, the guard's question); hid, holder_pid, bound: the hold's,
# only when its id lock is held (the status describes it); writing = 1: held, no
# live id in the status, and a take holds the publish lock (still writing). A
# hold released during the read reads free (TLS-127 review r1, Fable).
#   mine: our token, or our Claude session holding unbound (shareable); a hold of
#   our own session bound to a process (a land, a run) is not shareable: it ends
#   with that process, and a second land of the same session waits for it.
state() {
    holder_pid="" bound="" hid="" own=0 writing=0
    if ! probe s "$lock"; then
        st=free
        return
    fi
    st=held
    # Test hook: the window after the hold lock was seen held, in which a test
    # releases the hold. Once per process (an acquire calls `state` again).
    if [[ -n "${CDO_SLOT_TEST_PAUSE_HELD_S:-}" ]]; then
        test_pause "$CDO_SLOT_TEST_PAUSE_HELD_S"
        unset CDO_SLOT_TEST_PAUSE_HELD_S
    fi
    load "$status_file"
    local h session token
    h=$(field hid)
    # A status of an older hold names a dead id: say "held", trust nothing in it.
    if ! { [[ "$h" =~ ^[0-9a-f]{16}$ ]] && probe s "$ids/hold.$h"; }; then
        # Test hook: the window between this read and the publish probe, in
        # which a test lets a take finish (it waits for `resume-read`).
        [[ -z "${CDO_SLOT_TEST_PAUSE_READ_S:-}" ]] || test_pause "$CDO_SLOT_TEST_PAUSE_READ_S" resume-read
        # ⟨TLS-127⟩ A take keeps the publish lock until its status is in. (A
        # stranger's hold can read "still writing" while another reader's
        # exclusive probe of the publish lock is slow: display only.)
        local pb=0
        publish_busy || pb=$?
        if ((pb != 1)); then
            # Busy, or it cannot be probed: only the hold lock says free. The
            # hold may have been released since the first probe while something
            # else has the publish lock (review r2, Fable).
            if probe s "$lock"; then
                ((pb)) || writing=1
            else
                st=free
            fi
            return 0
        fi
        # Free: a take that finished since the read wrote its status before it
        # let go, so one more read sees it.
        load "$status_file"
        h=$(field hid)
        if ! { [[ "$h" =~ ^[0-9a-f]{16}$ ]] && probe s "$ids/hold.$h"; }; then
            # Still no live id: the hold may have been released since the first
            # probe (the slot is free), or a new take may have begun since the
            # publish probe (still writing). Only past both is it unknown.
            if ! probe s "$lock"; then
                st=free
            elif publish_busy; then
                writing=1
            fi
            return 0
        fi
    fi
    hid=$h
    holder_pid=$(field holder_pid)
    session=$(field session)
    token=$(field token)
    # Test hook: a pause between `session` and `bound`, in which a test removes
    # the status file (the read-once rule: read field by field from the file,
    # `bound` would come back "" and a bound hold read as an unbound one).
    [[ -z "${CDO_SLOT_TEST_PAUSE_S:-}" ]] || test_pause "$CDO_SLOT_TEST_PAUSE_S"
    bound=$(field bound)
    [[ -n "$me_session" && "$session" == "$me_session" ]] && own=1
    if [[ -n "$me_token" && "$token" == "$me_token" ]] || { ((own)) && [[ -z "$bound" ]]; }; then
        st=mine
    fi
}
describe() {
    if [[ -z "$hid" ]]; then
        # The holder truncates the lock file as it takes it: its mtime is when.
        local taken
        taken=$(stat -c %Y "$lock" 2>/dev/null || date +%s)
        if ((writing)); then
            echo "held (its holder is still writing its status)"
        else
            echo "held by an unknown holder (no status names it) since $(date -u -d "@$taken" +%FT%TZ): $(holders_of "$lock")"
        fi
        return
    fi
    local since age who
    since=$(field since)
    age=$(($(date +%s) - $(date -d "$since" +%s 2>/dev/null || date +%s)))
    who="session $(field session)"
    [[ -n "$bound" ]] && who+=", for PID $bound"
    echo "held by $(field owner) ($(field reason)) since $since ($((age / 60)) min$(suspended_since), $who"
}

# ⟨TLS-104⟩ `, N s of it with the host suspended)` when the host was suspended
# since the record was written (its `suspended=` reading), else `)`: an old hold
# can be a laptop that slept, not a hung holder (server1 suspends when moved).
# ⟨TLS-105 review r3, sol⟩ Cut after 5 s (KILL 1 s later, for a read that
# ignores TERM): `status` and `probe` print it, and a hung read there stalled
# the guard's probe (which then lets work run) and a waiting acquire.
host_suspended() { timeout -k 1 5 "$(dirname "$0")/host-suspended" 2>/dev/null; }
# mono_us: CLOCK_MONOTONIC in µs (`host-suspended --clocks`, cut the same way),
# or nothing when it cannot be read.
mono_us() {
    local _s _b m=""
    read -r _s _b m <<<"$(timeout -k 1 5 "$(dirname "$0")/host-suspended" --clocks 2>/dev/null)" || true
    if [[ "$m" =~ ^[0-9]+$ ]]; then echo "$m"; fi
}
# ⟨TLS-105⟩ The awake-time deadlines (the timed wait, `go`, acquire's --timeout)
# come from scripts/awake-clock, loaded only for the commands that wait with a
# deadline (review r1, sol): `probe`, `status`, `release` and a keeper must work
# without it, or the guard, whose probe would fail, lets work run beside a
# timing. A command that needs it and lacks it stops before it takes any lock.
load_awake() {
    local lib
    lib="$(dirname "$0")/awake-clock"
    [[ -r "$lib" ]] || die "$lib is missing: a wait with a deadline needs it; nothing was taken"
    # shellcheck source=awake-clock
    source "$lib"
}
# At least 2 s: the readings are whole seconds (one that crossed a second
# boundary moves by 1; review, sol), and a real suspend lasts far longer.
# `$1`: the words after the seconds (default `of it with the host suspended`).
suspended_since() {
    local s0 s1
    s0=$(field suspended)
    s1=$(host_suspended)
    if [[ "$s0" =~ ^[0-9]+$ && "$s1" =~ ^[0-9]+$ ]] && ((s1 - s0 >= 2)); then
        echo ", $((s1 - s0)) s ${1:-of it with the host suspended})"
    else
        echo ")"
    fi
}

# timed_now: a timing runs: some process holds the timing lock, or any
# timing's id lock (review r12, sol: a worker that kept only the id lock's
# descriptor keeps its timing live after every `timed.lock` holder is gone;
# the id locks decide, `timed.lock` only adds a timing still starting).
timed_now() {
    probe x "$timed_lock" && return 0
    local f
    for f in "$ids"/timed.*; do
        [[ -e "$f" ]] || continue
        probe s "$f" && return 0
    done
    return 1
}
# timed_describe: the line of a running timing: the first timing file whose id
# lock is held (one read of each file).
timed_describe() {
    local f
    for f in "$tdir"/*; do
        [[ -f "$f" ]] || continue
        probe s "$ids/timed.${f##*/}" || continue
        load "$f"
        echo "timed by $(field owner) since $(field since) ($(field reason)$(suspended_since "with the host suspended since")"
        return
    done
    echo "timed (its timing is starting)"
}

# take_hold <owner> <reason> <token> <kind>: take the hold in THIS process: the
# publish lock (shared), the hold lock, a fresh id lock, the status, then the
# publish lock goes. 0: taken (hid set); 1: held.
take_hold() {
    mkdir -p "$ids" || die "cannot make the folder $ids (something else has the name?)"
    local lfd hfd pfd
    # Test hook: the window between the acquire's checks and the hold lock.
    [[ -z "${CDO_SLOT_TEST_PAUSE_TAKE_S:-}" ]] || test_pause "$CDO_SLOT_TEST_PAUSE_TAKE_S"
    # ⟨TLS-127⟩ Held from before the hold lock until the status is in: a reader
    # that sees the hold lock taken and no status naming it asks this lock.
    # Only a reader's probe takes it exclusive, for an instant.
    # Only a regular file (or none yet) (review r2, sol). The open is read-write,
    # which never blocks, even on a FIFO swapped in after this check (r3).
    [[ ! -e "$publish_lock" || -f "$publish_lock" ]] \
        || die "the publish lock $publish_lock is not a regular file; refusing (remove it)"
    exec {pfd}<>"$publish_lock" || die "cannot open the publish lock $publish_lock"
    # At most CDO_SLOT_LOCK_WAIT_S, and never past an acquire's --timeout: the
    # awake time left of it now, to the µs, and no wait at all once it is used up.
    local pw=$lock_wait rem="" m
    if [[ -n "$pub_deadline" ]] && m=$(mono_us) && [[ -n "$m" ]]; then
        rem=$((pub_deadline - m))
    elif [[ -n "$pub_deadline_wall" ]]; then
        rem=$((pub_deadline_wall - ${EPOCHREALTIME//[!0-9]/}))
    fi
    if [[ -n "$rem" ]]; then
        ((rem > 0)) || rem=0
        ((rem >= lock_wait * 1000000)) || pw=$((rem / 1000000)).$(printf '%06d' $((rem % 1000000)))
    fi
    local got=0
    if [[ "$pw" == 0.000000 ]]; then
        flock -s -n "$pfd" && got=1
    else
        flock -s -w "$pw" "$pfd" && got=1
    fi
    if ((!got)); then
        # Closed first, or the holder list names this process too.
        exec {pfd}>&-
        die "the publish lock $publish_lock was held for ${pw} s by $(holders_of "$publish_lock"); refusing (a stopped or hung cdo-slot reader: end it)"
    fi
    exec {lfd}>"$lock"
    # Up to 1 s: a probe has the lock for an instant.
    if ! flock -x -w 1 "$lfd"; then
        exec {lfd}>&- {pfd}>&-
        return 1
    fi
    # A timing that began after this acquire's check (its own hold released
    # meanwhile) still keeps every new hold out: checked again under the hold
    # lock (TLS-89 review r7, sol). A timing that starts after this needs a hold
    # it can probe at its end, and the only one is this one.
    if timed_now; then
        exec {lfd}>&- {pfd}>&-
        return 1
    fi
    held_fds+=("$lfd")
    # No other hold lives under the hold lock: every id lock file left is dead.
    find "$ids" -maxdepth 1 -name 'hold.*' -delete 2>/dev/null || true
    hid=$(new_id)
    exec {hfd}>"$ids/hold.$hid"
    flock -x -n "$hfd" || die "cannot lock the new hold id $ids/hold.$hid"
    held_fds+=("$hfd")
    # Test hook: the window in which the hold is taken (`held=1`) but its status
    # is not written yet; a `release` then cannot name it and refuses.
    [[ -z "${CDO_SLOT_TEST_PAUSE_PUBLISH_S:-}" ]] || test_pause "$CDO_SLOT_TEST_PAUSE_PUBLISH_S"
    write_atomic "$status_file" "owner=$1
reason=$2
since=$(date -u +%FT%TZ)
suspended=$(host_suspended)
session=$me_session
claude_pid=$me_pid
bound=$bind
bound_start=$bind_start
holder_pid=$$
holder_kind=$4
token=$3
hid=$hid" || die "cannot write the status $status_file (exiting drops the hold)"
    exec {pfd}>&-
}
# take_timed <owner> <reason> <pid> <keeper|here>: take a timing in THIS
# process: the timing lock (shared), a fresh id lock, then its file (`kept=1`
# for a keeper's, which then inherits the two descriptors: it ends within
# 0.2 s of <pid>). Every process that has the id lock file open (this one and
# what inherits from it) OWNS the timing (timing_scan). 0: taken (tid set); 5: the
# timing lock stayed taken for CDO_SLOT_LOCK_WAIT_S (only a probe takes it
# exclusive, for an instant: a stopped or hung one; why says who).
take_timed() {
    if ! mkdir -p "$ids" "$tdir" 2>/dev/null; then
        why="cannot make the folders $ids and $tdir (something else has one of the names?)"
        return 5
    fi
    local tfd xfd
    exec {tfd}>"$timed_lock"
    if ! flock -s -w "$lock_wait" "$tfd"; then
        exec {tfd}>&-
        why="the timing lock $timed_lock was held for ${lock_wait} s by $(holders_of "$timed_lock"); refusing (a stopped or hung cdo-slot probe: end it)"
        return 5
    fi
    tid=$(new_id)
    exec {xfd}>"$ids/timed.$tid"
    flock -x -n "$xfd" || die "cannot lock the new timing id $ids/timed.$tid"
    held_fds+=("$tfd" "$xfd")
    timed_fds=("$tfd" "$xfd")
    # The lock's key as the kernel prints it (review r12, Fable: on btrfs
    # `stat` gives the subvolume's device and the lock line the filesystem's,
    # so a key built from `stat` never matched there). A taker that cannot see
    # its own lock line could prove nobody's ownership: it stops.
    local lkey="" line
    local -a w
    while IFS= read -r line; do
        [[ "$line" == lock:* ]] || continue
        read -r -a w <<<"$line"
        if [[ "${w[2]:-}" == FLOCK && "${w[4]:-}" == WRITE ]]; then
            lkey=${w[6]:-}
            break
        fi
    done <"/proc/$$/fdinfo/$xfd" || true
    [[ "$lkey" =~ ^[0-9a-f]+:[0-9a-f]+:[0-9]+$ ]] && holds_lock $$ "$lkey" \
        || die "cannot see its own lock on $ids/timed.$tid in /proc/$$/fdinfo/$xfd (exiting drops the timing)"
    write_atomic "$tdir/$tid" "owner=$1
reason=$2
since=$(date -u +%FT%TZ)
suspended=$(host_suspended)
pid=$3
pid_start=${bind_start:-$(proc_start "$3")}
kept=$([[ "${4:-}" == keeper ]] && echo 1 || echo 0)
taker_start=$(proc_start $$)
lock_key=$lkey
commit=$commit_id" || die "cannot write the timing file $tdir/$tid (exiting drops the timing)"
    # Files of timings that ended long ago (their id lock free) go, with their
    # commit marks.
    local snap c
    for f in $(find "$tdir" -maxdepth 1 -type f -mmin +5 2>/dev/null); do
        probe s "$ids/timed.${f##*/}" && continue
        load "$f"
        c=$(field commit)
        [[ ! "$c" =~ ^[0-9a-f]{16}$ ]] || rm -f "$commit_dir/$c"
        rm -f "$f" "$ids/timed.${f##*/}"
    done
}
# ⟨TLS-135 review r11, sol⟩ ONE commit point for a timed start: its hold, its
# timing and their keepers. A timing is PROVISIONAL from its publication
# (take_timed, under the gate) until its taker writes `$commit_dir/<id>`
# ("commit") after the drain and every keeper's go: then it is FINAL. A
# provisional timing keeps every foreign build and start out like a final
# one, but nobody reuses it (exit 4 is only for a final timing: one that
# finished its drain). Its keepers take their go without waiting for the
# commit, then wait for it while their acquire lives; an acquire that dies
# first leaves no commit, and each keeper reads the mark again after it saw
# the death, and ends (abort). No commit mark, or one that cannot be read,
# is never final.
commit_dir="$dir/commit"
commit_id=""
# commit_final <id>: that commit mark says "commit".
commit_final() { [[ "$1" =~ ^[0-9a-f]{16}$ && "$(cat "$commit_dir/$1" 2>/dev/null)" == commit ]]; }
# commit_write <hid> [tid]: make this start's hold <hid> and timing <tid> (when
# timed) final. It commits only what still stands (review r12, sol: a mark
# written after the hold was released or the timing's keeper killed reported
# success for nothing): the hold's and the timing's id locks held and the bound
# process the same, checked before the mark and again after it (a mark written
# into a change is taken back). 0 committed; 1 the mark could not be written;
# 2 what it was to commit changed (`commit_why` says what).
commit_why=""
commit_standing() {
    commit_why=""
    if ! probe s "$ids/hold.$1"; then
        commit_why="its hold ended"
    elif [[ -n "${2:-}" ]] && ! probe s "$ids/timed.$2"; then
        commit_why="its timing ended"
    elif [[ -n "$bind" ]] && ! alive "$bind" "$bind_start"; then
        commit_why="the process to bind (PID $bind) ended or another process has its PID now"
    fi
    [[ -z "$commit_why" ]]
}
commit_write() {
    [[ -z "${CDO_SLOT_TEST_PAUSE_COMMIT_S:-}" ]] || test_pause "$CDO_SLOT_TEST_PAUSE_COMMIT_S"
    commit_standing "$@" || return 2
    [[ -z "${CDO_SLOT_TEST_COMMIT_FAIL:-}" ]] || return 1
    mkdir -p "$commit_dir" 2>/dev/null && write_atomic "$commit_dir/$commit_id" commit 2>/dev/null \
        && commit_final "$commit_id" || return 1
    if ! commit_standing "$@"; then
        rm -f "$commit_dir/$commit_id"
        return 2
    fi
}
# close_timed: close this process's descriptors of its timing (a keeper that
# inherited them keeps the timing on).
timed_fds=()
close_timed() {
    local f
    for f in "${timed_fds[@]}"; do exec {f}>&-; done
    timed_fds=()
}
# drop_timed: end the timing this process holds (a refusal); its hold stays.
# Its record goes only once its lock is seen free (review r11, sol: a scan
# lists timings by their records, so one removed under a held lock hid it).
drop_timed() {
    close_timed
    forget_timed
}
# forget_timed: remove this start's timing record and commit mark, unless its
# id lock is still held.
forget_timed() {
    probe s "$ids/timed.$tid" && return 0
    rm -f "$tdir/$tid"
    [[ -z "$commit_id" ]] || rm -f "$commit_dir/$commit_id"
}

# A keeper (`cdo-slot _keep hold|timed`, started detached by an acquire): takes
# its locks, says so in its ready file ("<pid> <id>", or "fail <why>"), waits
# for `go.<pid>` while its acquire lives (an acquire killed before it says go,
# in a timed wait, leaves nothing behind), then keeps the locks while what it
# watches lives.
keeper() {
    local fd
    # Test hook: the keeper's first moment, before it closes the caller's
    # descriptors (review r8, sol: what it holds then, it must never need).
    [[ -z "${CDO_SLOT_TEST_PAUSE_KEEPER_S:-}" ]] || test_pause "$CDO_SLOT_TEST_PAUSE_KEEPER_S"
    # Keep no descriptor of the caller (a pipe it waits on, a lock of a run).
    # No `2>/dev/null` on the loop: bash keeps the real stderr on a spare fd
    # above 2 for the loop's length, the loop closed that fd too, and stderr was
    # lost for good (TLS-89's manual landing: a keeper's death said nothing).
    # Closing an fd that is not open is silent anyway. An `if`, not `&&`: under
    # `set -e` a false last test would end the keeper.
    # A timing keeper keeps the timing's two descriptors (CS_TIMED_FDS): its
    # acquire took and published the timing under the timing gate, and this
    # keeper only inherits it (review r10, sol: a keeper that published after
    # its acquire died, and the gate with it, could add a second timing).
    for fd in /proc/$$/fd/*; do
        fd=${fd##*/}
        if [[ "$fd" =~ ^[0-9]+$ ]] && ((fd > 2)) && [[ " ${CS_TIMED_FDS:-} " != *" $fd "* ]]; then
            eval "exec $fd>&-"
        fi
    done
    me_session=$CS_SESSION me_pid=$CS_PID bind=$CS_BIND bind_start=$CS_BIND_START
    [[ "${CS_PUB_DEADLINE:-}" =~ ^[1-9][0-9]{0,20}$ ]] && pub_deadline=$CS_PUB_DEADLINE
    [[ "${CS_PUB_DEADLINE_WALL:-}" =~ ^[1-9][0-9]{0,20}$ ]] && pub_deadline_wall=$CS_PUB_DEADLINE_WALL
    local id
    case "$1" in
        hold)
            take_hold "$CS_OWNER" "$CS_REASON" "$CS_TOKEN" keeper || exit 75
            id=$hid
            ;;
        timed)
            # shellcheck disable=SC2206 # one word per descriptor
            held_fds+=($CS_TIMED_FDS)
            id=$CS_TID
            ;;
    esac
    # Test hook: a subshell of this keeper (its command line and environment,
    # none of its locks) held until the test makes `fork-done`, as each `$(...)`
    # it runs is for a moment (TLS-102: a count by command line saw two).
    # Test hook: a keeper stopped with its locks taken and nothing said.
    [[ -z "${CDO_SLOT_TEST_KEEPER_STOP:-}" ]] || kill -STOP $$
    if [[ -n "${CDO_SLOT_TEST_KEEPER_FORK:-}" ]]; then
        (
            for fd in "${held_fds[@]}"; do eval "exec $fd>&-"; done
            while [[ ! -e "$dir/fork-done" ]]; do sleep 0.05; done
        ) &
    fi
    write_atomic "$CS_READY" "$$ $id"
    # The go file is named by this keeper's own id (never a reusable PID), and
    # removing it is the acknowledgement its acquire waits for.
    while [[ ! -e "$dir/go.$id" ]]; do
        alive "$CS_WRITER" "$CS_WRITER_START" || exit 0
        nap 0.2
    done
    rm -f "$dir/go.$id"
    # A timed start's keepers (its hold's and its timing's) then wait for its
    # one commit point while their acquire lives, and read the mark again once
    # they saw it die: no mark, no keeping (the commit model above
    # commit_final).
    if [[ -n "${CS_COMMIT:-}" ]]; then
        while ! commit_final "$CS_COMMIT"; do
            alive "$CS_WRITER" "$CS_WRITER_START" || break
            nap 0.2
        done
        commit_final "$CS_COMMIT" || exit 0
    fi
    if [[ -n "$CS_BIND" ]]; then
        # A timing ends within 0.2 s of its process: the step after a
        # perf-bounds finds it gone (review r10, Fable: at 2 s, a loaded host
        # missed timing_releasing's 3 s poll and parked a whole poll).
        local every=2
        [[ "$1" != timed ]] || every=0.2
        while alive "$CS_BIND" "$CS_BIND_START"; do nap "$every"; done
    elif [[ -n "$CS_PID" ]]; then
        # A Claude PID counts only while it is still the same claude process.
        while alive "$CS_PID" "$CS_PID_START" && grep -q claude "/proc/$CS_PID/comm" "/proc/$CS_PID/cmdline" 2>/dev/null; do
            nap 2
        done
    else
        while :; do nap 3600; done
    fi
    exit 0
}
# spawn_keeper <hold|timed> <owner> <reason> <token>: start one; 0 with kpid and
# kid (its id) set; 1 when it did not take its locks (why set for a timing).
spawn_keeper() {
    local ready="$dir/ready.$$.$(new_id)" n line
    kpid="" kid=""
    # The timing gate is never the keeper's (review r8, sol: one that stopped
    # before its own descriptor loop kept every later timed start out): a
    # timing keeper starts after the gate is closed (timed_start_now). The
    # launching subshell becomes the keeper (exec: same PID).
    (
        CS_TIMED_FDS="${timed_fds[*]}" CS_TID="${tid:-}" CS_COMMIT="$commit_id" \
            CS_OWNER="$2" CS_REASON="$3" CS_TOKEN="$4" CS_BIND="$bind" CS_BIND_START="$bind_start" \
            CS_SESSION="$me_session" CS_PID="$me_pid" CS_PID_START="$(proc_start "${me_pid:-0}")" \
            CS_WRITER="$$" CS_WRITER_START="$(proc_start $$)" CS_READY="$ready" \
            CS_PUB_DEADLINE="$pub_deadline" CS_PUB_DEADLINE_WALL="$pub_deadline_wall" \
            exec setsid bash "$self" _keep "$1" </dev/null >/dev/null 2>"$ready.err"
    ) &
    local child=$!
    # 60 s in 0.05 s steps (test hook: CDO_SLOT_TEST_SPAWN_STEPS, fewer).
    for n in $(seq "${CDO_SLOT_TEST_SPAWN_STEPS:-1200}"); do
        if [[ -s "$ready" ]]; then
            read -r line <"$ready"
            rm -f "$ready" "$ready.err"
            if [[ "$line" == fail* ]]; then
                why=${line#fail }
                return 1
            fi
            kpid=${line%% *} kid=${line#* }
            return 0
        fi
        # Test hook: the window between the ready check and the liveness check.
        [[ -z "${CDO_SLOT_TEST_PAUSE_SPAWN_S:-}" ]] || sleep "$CDO_SLOT_TEST_PAUSE_SPAWN_S"
        if ! alive "$child"; then
            # It may have written its ready file (a "fail <why>" too) and
            # ended just after the check above: read it then (TLS-89's
            # 3x-under-load check lost a refusal's why this way).
            [[ -s "$ready" ]] && continue
            local krc=0
            wait "$child" 2>/dev/null || krc=$?
            # 75: another acquirer took the hold lock first (plain contention).
            # Any other end without a word: say what it printed (a keeper's
            # stderr goes to this file; TLS-89's manual landing got only "not
            # taken").
            ((krc == 75)) \
                || why="its keeper ended (exit $krc) before it took its locks: $(tail -n 3 "$ready.err" 2>/dev/null | tr '\n' ' ')"
            rm -f "$ready" "$ready.err"
            return 1
        fi
        sleep 0.05
    done
    # Ended for certain, and reaped, before anyone goes on: a keeper stopped
    # after it took its locks keeps them, and TERM does not wake a stopped
    # process (review r9, sol); KILL does, and the wait sees it gone.
    kill -KILL "$child" 2>/dev/null || true
    wait "$child" 2>/dev/null || true
    rm -f "$ready" "$ready.err"
    why="its keeper did not start"
    return 1
}
# go <id> <its lock file>: tell the keeper of <id> to go on, and wait until it
# acknowledges (removes the file; only a live keeper does) while it still holds
# that lock. 0: it went on (what it watches decides its life from then on); 1:
# it was gone before it took the go (killed: TLS-89 review r7, sol).
# A keeper that does not take it within CDO_SLOT_LOCK_WAIT_S (stopped): 1 too,
# and a go file that cannot be made is no go (review r8, sol).
# ⟨TLS-105⟩ CDO_SLOT_LOCK_WAIT_S of AWAKE time (scripts/awake-clock): a host
# suspend in it refused a live keeper's go. The clock is started before the go
# file is made (a test that sees the file knows it runs): one clock read (a
# process) per go.
go() {
    awake_start
    : >"$dir/go.$1" || return 1
    local boot0 read_at=""
    awake_boot_cs
    boot0=$awake_boot
    while [[ -e "$dir/go.$1" ]]; do
        if ! probe s "$2"; then
            # It may have taken the go and ended just after the check above.
            [[ -e "$dir/go.$1" ]] || return 0
            rm -f "$dir/go.$1"
            return 1
        fi
        # Time since boot counts awake time and suspends, and never steps back
        # (review r1, sol: `$SECONDS` is wall time, which a clock step moves):
        # awake time never runs ahead of it. So the clocks (a process; this
        # loop polls every 0.05 s) are read only once that deadline passed,
        # then once a second.
        awake_boot_cs
        if ((awake_boot - boot0 >= lock_wait * 100)) && [[ "$read_at" != "$((awake_boot / 100))" ]]; then
            read_at=$((awake_boot / 100))
            awake_read
            [[ -z "$awake_msg" ]] || echo "cdo-slot: go: $awake_msg" >&2
            if ((awake_us >= lock_wait * 1000000)); then
                # The keeper may have taken the go while the clocks were read
                # (review r1, sol and Fable): that is a go. (One that takes it
                # between this check and the removal went on anyway; the caller
                # then ends it, so no hold is left that nobody knows of.)
                [[ -e "$dir/go.$1" ]] || return 0
                rm -f "$dir/go.$1"
                return 1
            fi
        fi
        sleep 0.05
    done
}
# end_keeper <lock file>: end the keeper of exactly that hold or timing (the one
# with its id lock open). 0 when nothing holds that lock any more (none did, or
# its keeper is gone); 1 when something still holds it after 5 rounds.
# TLS-102's stress run left a STOPPED keeper alive: every step trusted a fresh
# /proc scan. Now the keepers found are recorded once (PID and start time),
# waited for and killed by that record, and the lock itself says when it is done.
end_keeper() {
    local round
    for round in 1 2 3 4 5; do
        probe s "$1" || return 0
        end_keepers_once "$1"
    done
    ! probe s "$1"
}
# kept_warn <lock file>: say that a keeper could not be ended, and who holds it.
kept_warn() { echo "cdo-slot: could not end the keeper of $1; still holding it: $(holders_of "$1")" >&2; }
# end_keepers_once <lock file>: TERM the keepers holding it, then KILL any of
# exactly those still alive after 5 s (a stopped one is alive: only KILL ends it).
end_keepers_once() {
    local ps p n live
    local -a found=()
    ps=$(keepers_of "$1")
    for p in $ps; do found+=("$p:$(proc_start "$p")"); done
    ((${#found[@]})) || { sleep 0.2; return 0; }
    # shellcheck disable=SC2086 # one word per PID
    kill $ps 2>/dev/null || true
    for n in $(seq 50); do
        live=0
        for p in "${found[@]}"; do alive "${p%%:*}" "${p#*:}" && live=1; done
        ((live)) || return 0
        sleep 0.1
    done
    for p in "${found[@]}"; do
        if alive "${p%%:*}" "${p#*:}"; then kill -9 "${p%%:*}" 2>/dev/null || true; fi
    done
    return 0
}

ppid_of() { local f; read -r -a f <<<"$(proc_fields "$1")"; echo "${f[1]:-}"; }
# script_builds: "PID name" of each process running a build script
# (CDO_SLOT_BUILD_SCRIPTS: ci-steps, check-goldens), read from its argv: the
# script is argv[0], or the first non-option argument of a shell or python
# argv[0]. Between their cargo steps (ci-steps' agentflow pytest, ~2 min) no
# process has a build name, so the build names alone would let a timing start
# there (review r1, Fable). Exact argv words, never a `-f` pattern.
# script_operand: in `a` (an interpreter's argv), set i to the script operand's
# index after the options, or -1 when there is none (`-c` command string, `python
# -m`). Option operands are skipped (review r1, sol): a shell's `-o`/`-O` (each
# one in a cluster: `-euo pipefail`), --rcfile/--init-file; python's -W/-X.
script_operand() {
    local w py=0 k
    [[ "${a[0]##*/}" == python* ]] && py=1
    i=1
    while ((i < ${#a[@]})); do
        w=${a[i]}
        if [[ "$w" == -- ]]; then
            i=$((i + 1))
            break
        fi
        [[ "$w" == [-+]?* ]] || break
        i=$((i + 1))
        case "$w" in
            --rcfile | --init-file) i=$((i + 1)); continue ;;
            --*) continue ;;
        esac
        if ((py)); then
            # Letter by letter: -W/-X take the rest as their value (`-Xtracemalloc`)
            # or, last in the cluster, the next word (review r2, sol).
            for ((k = 1; k < ${#w}; k++)); do
                case "${w:k:1}" in
                    c | m) i=-1; return ;;
                    W | X)
                        ((k == ${#w} - 1)) && i=$((i + 1))
                        break
                        ;;
                esac
            done
        else
            [[ "${w:1}" == *c* ]] && { i=-1; return; }
            for ((k = 1; k < ${#w}; k++)); do
                [[ "${w:k:1}" == [oO] ]] && i=$((i + 1))
            done
        fi
    done
}
script_builds() {
    local d a i
    for d in /proc/[0-9]*; do
        mapfile -d '' -t a 2>/dev/null <"$d/cmdline" || continue
        ((${#a[@]})) || continue
        i=0
        case "${a[0]##*/}" in
            bash | sh | dash | zsh | python | python3)
                script_operand
                ((i >= 0)) || continue
                ;;
        esac
        ((i < ${#a[@]})) || continue
        case " $build_scripts " in
            *" ${a[i]##*/} "*) echo "${d#/proc/} ${a[i]##*/}" ;;
        esac
    done
}
# foreign_builds <pid>: the running build processes (CDO_SLOT_BUILD_NAMES, matched
# by exact name with `pgrep -x`: a `-f` pattern would match this script's own
# command line; and script_builds) that are alive (not zombies) and are neither
# <pid>, its ancestors nor its descendants (a timed script's own build, or the
# cargo test that runs it), nor an ancestor of a waiter in the queue: a
# `ci-steps` parked in `acquire --wait` builds nothing while it waits, and
# counting it made two timings wait on each other until CDO_SLOT_TIMED_WAIT_S
# (TLS-108, review Fable and sol); and (TLS-135) every live recorded build
# entry (`entries/`, "PID entry") that is not quiet (`quiet/`: it waits for a
# step that counts by itself); "PID name" lines.
foreign_builds() {
    local root=$1 line=" " parked=" " q s p name t
    q=$root
    while [[ "$q" =~ ^[1-9][0-9]*$ ]]; do
        line+="$q "
        q=$(ppid_of "$q")
    done
    # ⟨TLS-135⟩ A build entry point parked in `enter --wait` (its record taken
    # back) builds nothing either: the same rule, from its own ticket.
    for t in "$queue"/* "$parked_dir"/*; do
        [[ -f "$t" ]] || continue
        # The ticket's start time too, as `ahead` checks it: a dead waiter's
        # reused PID (a cargo build, say) must not pass as parked (review r2, sol).
        read -r q s _ <"$t" 2>/dev/null || continue
        [[ -n "$q" && -n "$s" ]] || continue
        if ! alive "$q" "$s"; then
            # A parked ticket of a dead waiter goes (its name is its own:
            # nanoseconds and PID); the queue's are `ahead`'s to drop.
            [[ "$t" != "$parked_dir"/* ]] || rm -f "$t"
            continue
        fi
        while [[ "$q" =~ ^[1-9][0-9]*$ && "$q" != 1 ]]; do
            parked+="$q "
            q=$(ppid_of "$q")
        done
    done
    while read -r p name; do
        [[ -n "$p" ]] || continue
        alive "$p" || continue
        [[ "$line" == *" $p "* ]] && continue
        # Only a build SCRIPT can be parked (a `ci-steps` between its steps); an
        # exact build name (cargo, rustc) always counts (review r2, sol).
        [[ "$parked" == *" $p "* && " $build_scripts " == *" $name "* ]] && continue
        q=$p
        while [[ "$q" =~ ^[1-9][0-9]*$ && "$q" != 1 ]]; do
            [[ "$q" == "$root" ]] && continue 2
            q=$(ppid_of "$q")
        done
        echo "$p $name"
    done < <(
        for name in $build_names; do
            for p in $(pgrep -x -- "$name" || true); do echo "$p $name"; done
        done
        script_builds
        # ⟨TLS-135⟩ Every live recorded build entry point (the entry process
        # itself, never what it started: a leaked child of a finished run holds
        # nothing up), unless it says it is quiet (`quiet on`: it waits for a
        # step it runs in the foreground, which counts by itself). A record
        # names its generation (`<pid>.<start time>`), so removing a dead one
        # never removes a newer record of a reused PID; only such exact names
        # are read or removed, never a record being written (`write_atomic`'s
        # `.w` file beside it: review r2, sol).
        local n
        # Any other file there (a write's `.w` file left by a killed writer)
        # goes only when old (review r2, Fable).
        find "$entries" "$quiet_dir" -maxdepth 1 -type f -mmin +5 \
            ! -regex '.*/[1-9][0-9]*\.[0-9]+' -delete 2>/dev/null || true
        for t in "$entries"/* "$quiet_dir"/*; do
            n=${t##*/}
            [[ -f "$t" && "$n" =~ ^([1-9][0-9]*)\.([0-9]+)$ ]] || continue
            p=${BASH_REMATCH[1]} s=${BASH_REMATCH[2]}
            if ! alive "$p" "$s"; then
                rm -f "$t"
            elif [[ "$t" == "$entries"/* && ! -e "$quiet_dir/$n" ]]; then
                echo "$p entry"
            fi
        done
    )
}
# ⟨TLS-135 review r2, sol⟩ quiet <on|off>: the caller (this process's parent),
# a recorded entry, says it now only waits for a step it runs in the foreground
# (on), or works again (off). A timed acquire does not count a quiet entry; the
# step counts by itself (its own record, its cargo). Quiet is a state the
# caller enters, never one read from the process tree (a backgrounded waiter's
# parent is free to run), and it admits nothing: every step checks for itself.
# `off` that cannot remove the state fails (exit 5): the caller must not work
# on while a timing may skip it.
quiet() {
    local caller=$PPID cstart q
    cstart=$(proc_start "$caller")
    [[ -n "$cstart" ]] || { echo "cdo-slot: quiet: cannot read the caller's start time" >&2; exit 5; }
    q="$quiet_dir/$caller.$cstart"
    case "$1" in
        on)
            mkdir -p "$quiet_dir" 2>/dev/null && write_atomic "$q" "$caller $cstart" 2>/dev/null \
                || { echo "cdo-slot: quiet on: cannot write $q (the caller stays counted)" >&2; exit 5; }
            ;;
        off)
            rm -f "$q" 2>/dev/null && [[ ! -e "$q" ]] \
                || { echo "cdo-slot: quiet off: cannot remove $q" >&2; exit 5; }
            ;;
        *) usage >&2; exit 2 ;;
    esac
}
# ⟨TLS-135⟩ enter_check <name>: one round of `enter` for the caller ($PPID). 0
# admitted (recorded), 3 another timing runs (record taken back), 5 the record
# could not be made. Every step checks its own result: this runs on the left of
# `||`, where errexit is off (review r1, sol).
enter_check() {
    local caller=$PPID cstart rec
    cstart=$(proc_start "$caller")
    if [[ -z "$cstart" ]] || ! mkdir -p "$entries" 2>/dev/null; then
        echo "$1: cannot record this run in $entries (start time '$cstart'); refusing" >&2
        return 5
    fi
    rec="$entries/$caller.$cstart"
    # The record first, then the decision: a timing that took its lock after
    # the decision scans after it too, and finds the record.
    if ! write_atomic "$rec" "$caller $cstart" 2>/dev/null || [[ ! -f "$rec" ]]; then
        echo "$1: cannot write the record $rec; refusing" >&2
        return 5
    fi
    # Test hook: the window between the record and the decision (with
    # CDO_SLOT_TEST_PAUSE_ENTER_NAME, only for an entry of that name).
    if [[ -n "${CDO_SLOT_TEST_PAUSE_ENTER_S:-}" && "${CDO_SLOT_TEST_PAUSE_ENTER_NAME:-$1}" == "$1" ]]; then
        test_pause "$CDO_SLOT_TEST_PAUSE_ENTER_S"
    fi
    # No step is admitted by its run (review r2, sol): a step of a run checks
    # like any start. Its run waits for it quietly (`quiet on`), so a timing
    # that counted the run does not wait for it while the step waits for the
    # timing: the run pauses between steps instead.
    # A timing of its own line is no reason to wait (a step of a timed `run`,
    # an orphan worker of one, a perf-bounds after its acquire: entry_verdict).
    # Owned and foreign never run together: a timing is refused while one it
    # does not own runs (timing_gate), and an owner gets no second one.
    local erc=0
    entry_verdict "$caller" >/dev/null || erc=$?
    case "$erc" in
        0) return 0 ;;
        3)
            rm -f "$rec"
            return 3
            ;;
        *)
            # A scan that failed, or a line it cannot read, admits nothing and
            # leaves no record (review r9 Fable, r11 sol).
            rm -f "$rec"
            echo "$1: cannot tell whether the running CDO timing is this run's own; refusing" >&2
            return 5
            ;;
    esac
}
# entry_verdict <root>: may a build entry <root> start? 0 yes (no timing, or
# only timings of its line: <root> or an ancestor holds the lock, or is the
# exact bound process; provisional or final, its line's builds are its
# owner's choice); 3 a timing outside its line runs (its line printed); 5 the
# scan failed, or the line could not be read (`unknown`).
entry_verdict() {
    local out rel state rest foreign=""
    out=$(timing_scan "$1") || return 5
    while read -r rel state rest; do
        case "$rel" in
            unknown) return 5 ;;
            none) foreign=${foreign:-$rest} ;;
        esac
    done <<<"$out"
    [[ -n "$foreign" ]] || return 0
    echo "$foreign"
    return 3
}
# ⟨TLS-135 review r9-r12⟩ THE MODEL.
# - LIVENESS: a timing is live exactly while its id lock (`id/timed.<tid>`) is
#   held, whatever its PIDs say.
# - HOLDING: a process holds a timing when one of its descriptors carries that
#   flock: its `/proc/<pid>/fdinfo/<fd>` lists the lock (`lock: ... FLOCK
#   ADVISORY WRITE ... <dev>:<inode>`) on the id file's device and inode, as
#   the kernel printed it for the taker's own descriptor (`lock_key` in the
#   record; not from `stat`, whose device differs on btrfs). The
#   taker holds it, and so does everything that inherited the descriptor or a
#   dup of it (a `run`'s command, a worker that command left behind, the
#   keeper): one open file description, one lock. A second, independent open
#   of the same file holds nothing (review r11, sol: a pathname is no proof).
#   The PID the kernel prints on the lock is not compared (it is the taker's).
#   Every reading is a snapshot.
# - The single exception, by binding: the process a keeper's timing (`kept=1`)
#   is bound to (`acquire --bind PID --timed`), which cannot inherit from its
#   own child, counts as holding it, judged by exactly the PID and start time
#   the keeper watches (`pid`, `pid_start`): the timing ends with exactly that
#   process. Nothing else is judged by a PID.
# - REUSE (a timed start told "already timed", exit 4): only by a process that
#   holds the timing itself (or is its exact bound process), and only once the
#   timing is final (commit_final). Not by a process whose ANCESTOR holds it:
#   it can outlive that ancestor and measure with no timing (review r11, sol).
# - ADMISSION (a build entry may start): <root> or an ancestor holds it. A build
#   in a timing's own line is its owner's choice.
# - A process whose descriptors cannot be read is skipped when its user is
#   known to differ from ours (its `Uid:` line: another user's, PID 1), or
#   when it started before the timing's taker (`taker_start`: the process that
#   opened and locked the id file, in boot-clock ticks): a descriptor reaches a
#   process only by a fork from a holder after the open, so an older process
#   could hold it only as the taker. THE CONTRACT here: a timing's descriptor
#   moves only by fork inheritance: never to another user (no setuid program
#   inherits it), never over a socket, never by `pidfd_getfd` (same user too),
#   and no process shares its descriptor table with another (no CLONE_FILES
#   outside threads); only cdo-slot's take_timed locks an id file, once, when
#   it makes it. The stored and the observed start times are the same clock:
#   both are field 22 of `/proc/<pid>/stat` (boot-clock ticks), read by
#   proc_fields. Our own user's processes can be unreadable too (seen on
#   server1: the Claude process and a test runner, from inside a sandbox).
#   Any other unreadable process makes the answer `unknown`, and the caller
#   refuses, unless a readable descriptor already proved it. A process
#   that genuinely inherited a timing's descriptor (a daemon a timed command
#   left running) keeps the timing alive and its line owns it: close timing
#   descriptors where a daemon is launched (the keeper does).
#
# timing_scan [root]: one line per live timing, "<relation> <state> <its line>":
# relation `holds` (<root> holds it), `bound` (<root> is its exact bound
# process), `ancestor` (an ancestor holds it or is bound), `none`, or
# `unknown`; state `final` or `provisional`. The line of <root> (default: this
# process) is read once as a snapshot (PID, start time, parent) and read again
# after: a process that vanished or moved meanwhile makes it read again from
# <root>, at most 3 times (exit 5 then), never stitching two readings
# together. A keeper's timing whose bound process ended is left out, when
# unrelated, once its lock is seen released (timing_releasing). A timing whose
# file is not written yet is not listed: it scans for builds after that, and
# finds the caller's record. A lock probe that fails ends this process (exit 5).
timing_scan() {
    # No short cut on `timed.lock`: each record's id lock decides (scan_once).
    local out rc
    for _ in 1 2 3; do
        rc=0
        out=$(scan_once "${1:-$$}") || rc=$?
        if ((rc == 0)); then
            printf '%s' "$out"
            return 0
        fi
        ((rc == 2)) || return "$rc"
    done
    echo "cdo-slot: the process line of ${1:-$$} kept changing while it was read" >&2
    return 5
}
scan_once() {
    local q e f tid key rel r unk i st pp out=""
    local -a fields line=()
    q=$1
    while [[ "$q" =~ ^[1-9][0-9]*$ ]]; do
        read -r -a fields <<<"$(proc_fields "$q")"
        ((${#fields[@]} > 19)) || return 2
        line+=("$q:${fields[19]}:${fields[1]}")
        q=${fields[1]}
    done
    for f in "$tdir"/*; do
        [[ -f "$f" ]] || continue
        tid=${f##*/}
        probe s "$ids/timed.$tid" || continue
        load "$f"
        # The kernel's key for its lock, as its taker read it (take_timed).
        key=$(field lock_key)
        # A record with no key (written by an older cdo-slot, which other
        # worktrees still run): the kernel's key from /proc/locks, the one
        # FLOCK write lock on the id file's inode (only `stat`'s device is
        # unreliable, on btrfs); none or more than one is unknown.
        [[ "$key" =~ ^[0-9a-f]+:[0-9a-f]+:[0-9]+$ ]] || key=$(locks_key "$ids/timed.$tid") || key=""
        if [[ -z "$key" ]]; then
            out+="unknown provisional its lock key cannot be told: timed by $(field owner) since $(field since) ($(field reason))"$'\n'
            continue
        fi
        rel=none unk=""
        for ((i = 0; i < ${#line[@]}; i++)); do
            IFS=: read -r q st pp <<<"${line[i]}"
            if [[ "$(field kept)" == 1 && "$(field pid)" == "$q" && "$(field pid_start)" == "$st" ]]; then
                r=bound
            else
                r=0
                holds_lock "$q" "$key" || r=$?
                case "$r" in
                    0) r=holds ;;
                    2)
                        # Started before the taker, it cannot have inherited
                        # the descriptor, and it is not the taker (THE
                        # CONTRACT above): it holds nothing.
                        [[ "$(field taker_start)" =~ ^[0-9]+$ && "$st" =~ ^[0-9]+$ ]] \
                            && ((st < $(field taker_start))) && continue
                        unk=${unk:-$q}
                        continue
                        ;;
                    *) continue ;;
                esac
            fi
            ((i == 0)) || r=ancestor
            rel=$r
            break
        done
        if [[ "$rel" == none && -n "$unk" ]]; then rel=unknown; else unk=""; fi
        if [[ "$rel" == none ]] && timing_releasing "$tid"; then
            continue
        fi
        out+="$rel $(commit_final "$(field commit)" && echo final || echo provisional) ${unk:+PID $unk unreadable: }timed by $(field owner) since $(field since) ($(field reason))"$'\n'
    done
    for e in "${line[@]}"; do
        IFS=: read -r q st pp <<<"$e"
        read -r -a fields <<<"$(proc_fields "$q")"
        [[ "${fields[19]:-}" == "$st" && "${fields[1]:-}" == "$pp" ]] || return 2
    done
    printf '%s' "$out"
}
# locks_key <file>: the kernel's key of the FLOCK write lock on <file>, read
# from the fdinfo of a descriptor that has the file open and carries a lock
# (not /proc/locks: it hides a lock whose taker has exited); 1 when none does.
locks_key() {
    local d line ino
    local -a w
    ino=$(stat -c %i "$1" 2>/dev/null) || return 1
    local -a ds
    mapfile -t ds < <(find /proc/[0-9]*/fd -lname "$(glob_quote "$1")" 2>/dev/null)
    for d in "${ds[@]}"; do
        while IFS= read -r line; do
            [[ "$line" == lock:* ]] || continue
            read -r -a w <<<"$line"
            if [[ "${w[2]:-}" == FLOCK && "${w[4]:-}" == WRITE && "${w[6]:-}" == *":$ino" ]]; then
                echo "${w[6]}"
                return 0
            fi
        done 2>/dev/null <"${d/\/fd\///fdinfo/}" || true
    done
    return 1
}
# holds_lock <pid> <key>: 0 a descriptor of <pid> carries the FLOCK write lock
# on <key>'s file; 1 none (or <pid> cannot be read and its user is known to
# differ from ours: THE CONTRACT above); 2 unknown (unreadable, of our user or
# an unknown one, or a descriptor of it could not be read).
holds_lock() {
    local u
    # Test hook: that PID reads as unreadable, of our user.
    [[ "$1" != "${CDO_SLOT_TEST_UNREADABLE_PID:-}" ]] || return 2
    # Not `ls`: one that stats each entry fails on a descriptor closed while it
    # lists them (uutils' does).
    if [[ ! -r "/proc/$1/fdinfo" ]]; then
        u=$(awk '/^Uid:/ { print $2, $3, $4, $5; exit }' "/proc/$1/status" 2>/dev/null)
        [[ -n "$u" && " $u " != *" $EUID "* ]] && return 1
        return 2
    fi
    # Each descriptor read on its own (review r12, sol: one reader over them
    # all could stop at a descriptor closed under it, before a later one that
    # held the lock). A match is kept. A descriptor that could not be read
    # but still exists leaves a "no" incomplete: unknown (2). One closed
    # meanwhile holds nothing.
    local f line opened found incomplete=0
    local -a w
    for f in "/proc/$1/fdinfo/"*; do
        [[ -e "$f" ]] || continue
        opened=0 found=0
        # Test hook: that descriptor number cannot be read (it stays there).
        if [[ "${f##*/}" != "${CDO_SLOT_TEST_FDINFO_UNREADABLE:-}" ]]; then
            {
                opened=1
                # The lock lines follow the fixed head (pos, flags, mnt_id,
                # ino); what comes after (an epoll's or inotify's long list)
                # is not read: reading it all took 4.8 s for the Claude
                # process's 43 descriptors.
                while IFS= read -r line; do
                    case "$line" in
                        lock:*) ;;
                        pos:* | flags:* | mnt_id:* | ino:*) continue ;;
                        *) break ;;
                    esac
                    read -r -a w <<<"$line"
                    if [[ "${w[2]:-}" == FLOCK && "${w[4]:-}" == WRITE && "${w[6]:-}" == "$2" ]]; then
                        found=1
                        break
                    fi
                done
            } 2>/dev/null <"$f" || true
        fi
        ((!found)) || return 0
        ((opened)) || [[ ! -e "$f" ]] || incomplete=1
    done
    ((!incomplete)) || return 2
    return 1
}
# timing_releasing <tid>: the timing file just loaded (`load`) is a keeper's
# whose bound process has ended, and its id lock is seen released within 3 s
# (its keeper checks every 0.2 s: the poll is the margin for a loaded host).
# Released, the timing is over: by the lock, not by a PID (THE MODEL above).
# It is still needed: without it, the step after a perf-bounds (`ci-steps
# all`'s fresh admission) found the keeper's last 0.2 s and parked a whole
# poll (CDO_SLOT_POLL_S). A `run`'s timing is never released this way: its
# command or a worker it left may hold the lock for as long as they live
# (review r9, sol).
timing_releasing() {
    local p s n
    [[ "$(field kept)" == 1 ]] || return 1
    p=$(field pid) s=$(field pid_start)
    [[ "$p" =~ ^[1-9][0-9]*$ && -n "$s" ]] && ! alive "$p" "$s" || return 1
    for n in $(seq 30); do
        probe s "$ids/timed.$1" || return 0
        sleep 0.1
    done
    return 1
}
# enter_wait <name>: after `enter` said 3: parked, wait until entry_verdict
# finds no timing outside the caller's line, then record and decide again
# (enter_check), until admitted or CDO_SLOT_ENTRY_WAIT_S of awake time since
# this wait began (one deadline for every round; no sleep past it). See `enter`.
enter_wait() {
    local name=$1 line last=-60 left_us rc erc
    mkdir -p "$parked_dir" || { echo "$name: cannot make $parked_dir; refusing" >&2; exit 5; }
    trap 'rm -f "${parked_ticket:-}"' EXIT
    awake_start
    while :; do
        parked_ticket="$parked_dir/$(printf '%020d' "$(date +%s%N)").$$"
        write_atomic "$parked_ticket" "$$ $(proc_start $$)" || { echo "$name: cannot park in $parked_dir; refusing" >&2; exit 5; }
        # (A check that fails ends the wait: enter_check decides it, exit 5.)
        while erc=0 && { line=$(entry_verdict "$PPID") || erc=$?; } && ((erc == 3)); do
            if ((SECONDS - last >= 60)); then
                echo "$name: waiting for the CDO timing to end before it builds (up to ${entry_wait} s): $line"
                last=$SECONDS
            fi
            awake_read
            [[ -z "$awake_msg" ]] || echo "$name: $awake_msg"
            left_us=$((entry_wait * 1000000 - awake_us))
            if ((left_us <= 0)); then
                echo "$name: refused: a CDO timing still runs after ${entry_wait} s ($line); started nothing" >&2
                exit 6
            fi
            awake_nap $((left_us < poll * 1000000 ? left_us : poll * 1000000))
        done
        # Unparked before it records: from here it counts as a build again.
        rm -f "$parked_ticket"
        rc=0
        enter_check "$name" || rc=$?
        case "$rc" in
            0) break ;;
            3) ;;
            *) exit "$rc" ;;
        esac
        # Another timing took over before this decision: the same deadline
        # (review r2, sol: with only the inner check, timings that hand over
        # between its probe and the decision kept it waiting for ever).
        awake_read
        if ((awake_us >= entry_wait * 1000000)); then
            echo "$name: refused: CDO timings still ran after ${entry_wait} s; started nothing" >&2
            exit 6
        fi
        # Test hook: the window after a decision that found a timing, before
        # the next wait.
        [[ -z "${CDO_SLOT_TEST_PAUSE_RETRY_S:-}" ]] || test_pause "$CDO_SLOT_TEST_PAUSE_RETRY_S"
    done
    echo "$name: the CDO timing ended after $((awake_us / 1000000)) s; starting"
}

# ⟨TLS-135 review r6-r12⟩ THE RULE for every wait here and in build-entry
# and ci-steps: no lock is held while sleeping on another party that could need
# it. Audit (r12):
# - `timing-gate.lock` (timing_gate): every timed start holds it across one
#   check and one publication of its timing (take_timed, in the acquire or the
#   `run` itself), never across the drain, a keeper's start or the commit.
#   Under it run only the check (request_verdict: lock probes, /proc reads,
#   timing_releasing's wait for a releasing keeper of at most 3 s, which needs
#   no lock; read again at most 3 times when the line moved), take_timed's
#   wait for `timed.lock` (CDO_SLOT_LOCK_WAIT_S; a probe holds it exclusive
#   for an instant) and its host-suspended read (at most 6 s). A start waits
#   for the gate longer than all of these together (gate_wait).
# - Nothing waits for its own timing: a request related to a running timing
#   is answered at once (request_verdict: 4 for a final one it holds, 6 for
#   a provisional one, which may be draining for this very caller's entry).
# - The hold and timing locks: held while their timer waits for builds (the
#   drain), by design. A party that waits on them is not counted by that drain:
#   a gate in `enter --wait` and a queued `acquire --wait` are parked, a run
#   waiting on its step is quiet.
# - One timing per slot at a time: a timing is refused while one it does not
#   own runs, and an owner asking again gets no second one (exit 4), so a
#   process never waits for a timing it owns, and an entry never meets an
#   owned and a foreign timing at once. A step that builds beside another
#   under one timed `run` (a sibling of a nested perf-bounds) is that run's
#   owner's choice: it owns the timing too. No script runs steps side by side
#   under one timing.
# - `acquire --wait`, `enter --wait`, a keeper's watch, `go`: hold no lock the
#   party they wait for needs (tickets only; `go` waits for its own keeper).
# - build_step: the run waits on its child while quiet, then decides afresh.
#
# timing_gate <root>: the one place a timing is checked against the others
# and published (timed_start_now closes the gate right after take_timed): of
# two timed starts that race, in either order, the second sees the first. A
# new timing is refused at once (6), never waits, while a timing unrelated to
# <root> runs (two timings side by side waited on each other at their
# commands' entries, r4 to r8, and each measured the other's load anyway);
# else request_verdict decides (4 already timed, 6, 5). <root> is the process
# the new timing will carry (an `acquire --timed --bind PID`: PID, not the
# launcher; review r9, sol), checked again here (its start time). It sets
# gate_fd. 5: the gate or the check failed.
timing_gate() { # <root>
    local root=$1
    # Longer than whatever runs under the gate (see the audit above).
    local gate_wait=$((lock_wait + 30))
    if ! exec {gate_fd}>"$dir/timing-gate.lock"; then
        echo "cdo-slot: --timed: cannot open $dir/timing-gate.lock" >&2
        return 5
    fi
    if ! flock -x -w "$gate_wait" "$gate_fd"; then
        echo "cdo-slot: --timed: the timing gate ($dir/timing-gate.lock) stayed held ${gate_wait} s by $(holders_of "$dir/timing-gate.lock")" >&2
        return 5
    fi
    local vrc=0
    request_verdict "$root" || vrc=$?
    ((vrc == 0)) || return "$vrc"
    if [[ -n "$unrelated" ]]; then
        echo "cdo-slot: --timed refused: another timing runs in this slot: $unrelated" >&2
        return 6
    fi
    # Test hook: the window between the check and the publication.
    [[ -z "${CDO_SLOT_TEST_PAUSE_TIMED_GATE_S:-}" ]] || test_pause "$CDO_SLOT_TEST_PAUSE_TIMED_GATE_S"
    # The process it times, checked again right before the publication
    # (review r11, sol): the generation read at --bind.
    if ! alive "$root" "$bind_start"; then
        echo "cdo-slot: --timed refused: the process to bind (PID $root) ended or another process has its PID now; nothing taken" >&2
        return 6
    fi
}
# request_verdict <root>: what a timed start for <root> (the process the timing
# will carry) meets, before it queues, at every poll while it waits, and under
# the gate (reviews r11, r12, sol). The bound process first: gone, or another
# process under its PID now (its start time, read once at --bind) -> 6. Then
# each live timing by its relation to <root> (timing_scan):
# - holds or bound, final: "already timed", 4: a duplicate request, nothing
#   taken (the caller runs under the one it holds).
# - holds or bound, provisional: 6 at once, "still starting": waiting could
#   cycle with that timing's drain (it may count this caller's entry).
# - ancestor: 6 at once: related, but not reusable (only its holder or its
#   bound process can reuse it, never a process that would outlive it).
# - unknown: 5.
# - none (unrelated): 0, with `unrelated` set to its line (the gate refuses
#   it; a queued start waits for the slot as before).
unrelated=""
request_verdict() {
    local out rel state rest
    unrelated=""
    if [[ -n "$bind" ]] && ! alive "$bind" "$bind_start"; then
        echo "cdo-slot: --timed refused: the process to bind (PID $bind) ended or another process has its PID now; nothing taken" >&2
        return 6
    fi
    if ! out=$(timing_scan "$1"); then
        echo "cdo-slot: --timed: the timing check failed" >&2
        return 5
    fi
    while read -r rel state rest; do
        case "$rel/$state" in
            holds/final | bound/final)
                # The same process still: its generation pinned (review r12).
                if [[ -n "$bind" ]] && ! alive "$bind" "$bind_start"; then
                    echo "cdo-slot: --timed refused: the process to bind (PID $bind) ended or another process has its PID now; nothing taken" >&2
                    return 6
                fi
                echo "cdo-slot: already timed: PID $1 holds this slot's timing ($rest); a duplicate request, nothing more to do"
                return 4
                ;;
            holds/* | bound/*)
                echo "cdo-slot: --timed refused: PID $1's own timing is still starting (its drain and handoff have not finished: $rest); nothing taken" >&2
                return 6
                ;;
            ancestor/*)
                echo "cdo-slot: --timed refused: an ancestor of PID $1 holds the slot's timing ($rest), which a separate timed start cannot reuse (only its holder or its bound process can); nothing taken" >&2
                return 6
                ;;
            unknown/*)
                echo "cdo-slot: --timed: cannot tell whether PID $1 holds the running timing ($rest): a process in its line cannot be read; refusing" >&2
                return 5
                ;;
            none/*) unrelated=${unrelated:-$rest} ;;
        esac
    done <<<"$out"
    return 0
}

# timed_start <owner> <reason> <pid> <hid> <here|keeper>: a timing in hold <hid>
# while <pid> lives. It passes the timing gate (timing_gate) and takes the
# timing lock in this process, under the gate (for `run`, whose command
# inherits it; for `acquire`, a keeper bound to <pid> then inherits it: no
# keeper ever publishes, so an acquire killed before its keeper started leaves
# no timing to appear later; review r10, sol), so the guard refuses new builds
# from then on, then waits for the builds already running. 0: timed (a
# keeper's go given); 4: <pid> already owns the slot's timing (nothing taken);
# 5: the gate, the timing lock or the keeper failed; 6: refused at the gate, a
# build still ran at CDO_SLOT_TIMED_WAIT_S, or hold <hid> ended meanwhile (the
# timing taken back).
timed_start() {
    local gate_fd="" trc=0
    timing_gate "$3" || trc=$?
    ((trc)) || timed_start_now "$@" || trc=$?
    # On a refusal before the take, the gate is still open.
    [[ -z "$gate_fd" ]] || exec {gate_fd}>&-
    return "$trc"
}
timed_start_now() {
    local tkpid="" rc=0
    take_timed "$1" "$2" "$3" "$5" || rc=$?
    # The gate ends with the publication: its timing is now seen by any later
    # check, and the drain below sleeps on builds (THE RULE above timing_gate).
    if [[ -n "${gate_fd:-}" ]]; then
        exec {gate_fd}>&-
        gate_fd=""
    fi
    if ((rc)); then
        echo "cdo-slot: --timed: ${why:-the timing lock was not taken}" >&2
        return 5
    fi
    if [[ "$5" == keeper ]]; then
        # The keeper inherits the timing, then this process lets go of its
        # copies: from here the timing lives exactly as long as its keeper.
        if ! spawn_keeper timed "$1" "$2" ""; then
            drop_timed
            echo "cdo-slot: --timed: ${why:-its keeper did not start}" >&2
            return 5
        fi
        tkpid=$kpid
        close_timed
    fi
    # refuse <message>: take the timing back (only this call's), say why.
    refuse() {
        [[ -z "${CDO_SLOT_TEST_PAUSE_REFUSE_S:-}" ]] \
            || test_pause "$CDO_SLOT_TEST_PAUSE_REFUSE_S"
        # Test hook: a child of this process keeps the timing's descriptors
        # (a lock that outlives the refusal).
        if [[ -n "${CDO_SLOT_TEST_REFUSE_HOLDER:-}" ]]; then
            sleep "$CDO_SLOT_TEST_REFUSE_HOLDER" >/dev/null 2>&1 &
            echo "$!" >"$dir/holder.pid"
        fi
        # The record stays while the lock is held (forget_timed).
        if [[ -n "$tkpid" ]]; then
            end_keeper "$ids/timed.$tid" || kept_warn "$ids/timed.$tid"
            forget_timed
        else
            drop_timed
        fi
        echo "cdo-slot: --timed refused: $*" >&2
        return 6
    }
    # Microseconds: the deadline holds below a second too.
    # ⟨TLS-104⟩ The wall clock keeps counting through a host suspend: a laptop
    # that slept 33 min would "wait" its 1800 s in a few real seconds and refuse
    # falsely (review, Fable), and its grace would end with no build given the
    # chance to start (review r2, sol). So the wait and the grace run on AWAKE
    # time (scripts/awake-clock, shared since TLS-105). Each new sleep is said
    # once. With the clocks unreadable, the wall clock (as before).
    local now last=-60 b list left_us nap_us quiet=""
    awake_start
    local wait_us=$((timed_wait * 1000000)) grace_us=$((timed_grace * 1000000))
    while :; do
        # Every round: the process it times still lives (review r11, Fable: a
        # timing sat through its whole drain for a dead one).
        alive "$3" "$bind_start" || { refuse "the process it was to time (PID $3) ended or was replaced while it waited for builds"; return; }
        b=$(foreign_builds "$3")
        awake_read
        [[ -z "$awake_msg" ]] || echo "cdo-slot: timed: $awake_msg"
        now=$awake_us
        if [[ -n "$b" ]]; then
            quiet=""
            list=$(awk '{ printf "%sPID %s (%s)", (NR > 1 ? ", " : ""), $1, $2 }' <<<"$b")
            left_us=$((wait_us - now))
            # A build seen at (or past) the deadline refuses; the sleeps below
            # never pass the deadline, so a scan always lands on it.
            ((left_us > 0)) || { refuse "build processes still running after ${timed_wait} s: $list"; return; }
            if ((SECONDS - last >= 60)); then
                echo "cdo-slot: timed: waiting for build processes to end: $list"
                last=$SECONDS
            fi
            nap_us=$((left_us < poll * 1000000 ? left_us : poll * 1000000))
        else
            # None seen: start (or go on) counting the grace (a command the
            # guard allowed just before the timing lock was taken may start now).
            if [[ -z "$quiet" ]]; then
                quiet=$now
                # Test hook: the grace's first moment, after the first empty
                # scan (a build the guard allowed may start now).
                [[ -z "${CDO_SLOT_TEST_PAUSE_GRACE_S:-}" ]] || test_pause "$CDO_SLOT_TEST_PAUSE_GRACE_S"
            fi
            ((now - quiet < grace_us)) || break
            nap_us=$((grace_us - (now - quiet)))
            ((nap_us < 500000)) || nap_us=500000
        fi
        awake_nap "$nap_us"
    done
    # The hold it was to run in must still be there (released, or ended, while
    # it waited: review r1, sol): one probe of its id lock.
    if ! probe s "$ids/hold.$4"; then
        refuse "the hold ended while it waited for builds"
        return
    fi
    # Test hook: the window in which a timing keeper may be killed before its go.
    [[ -z "${CDO_SLOT_TEST_PAUSE_GO_S:-}" ]] || test_pause "$CDO_SLOT_TEST_PAUSE_GO_S"
    if [[ -n "$tkpid" ]] && ! go "$tid" "$ids/timed.$tid"; then
        refuse "its timing keeper ended before the timing began"
        return
    fi
    echo "cdo-slot: timed by $1 ($2)"
}

# ⟨TLS-88⟩ The waiters' queue: a waiting acquire holds a ticket, and a free slot
# goes to the oldest live ticket, so a holder that releases and acquires again
# goes behind an earlier waiter (before: whoever polled first won). A ticket is
# `$queue/<ns since epoch>.<pid>`, holding "<pid> <start time>"; one of a dead
# process (or a reused PID) is dropped by whoever reads the queue. A waiter that
# cannot run now (MemAvailable below its floor) marks its ticket `mem` and steps
# aside, so it does not hold up a waiter that can run (land acquires with no
# floor); it clears the mark when memory is back and keeps its place. The queue
# decides only the order, never whether the slot is held: a wrong order costs
# fairness, never a second holder.
queue="$dir/queue"
ticket="" ticket_mark=""
# write_ticket <mark>: (re)write our ticket whole (write, then rename: a reader
# never sees it half written).
write_ticket() {
    local tmp="$dir/ticket.$$"
    printf '%s %s %s\n' "$$" "$(proc_start $$)" "$1" >"$tmp" && mv -f "$tmp" "$ticket"
    ticket_mark=$1
}
enqueue() {
    mkdir -p "$queue"
    ticket="$queue/$(printf '%020d' "$(date +%s%N)").$$"
    write_ticket ""
}
# mark <"" | mem>: set our ticket's mark, writing it only when it changes.
mark() {
    [[ -n "$ticket" ]] || return 0
    [[ -e "$ticket" && "$1" == "$ticket_mark" ]] && return 0
    write_ticket "$1"
}
dequeue() {
    [[ -n "$ticket" ]] && rm -f "$ticket"
    ticket=""
}
# ahead: the live, unmarked tickets older than ours (every one when we hold
# none), as "<count> <oldest pid>"; drops dead tickets on the way.
ahead() {
    local t n=0 first="" pid start flag
    for t in "$queue"/*; do
        [[ -e "$t" ]] || continue
        [[ "$t" == "$ticket" ]] && break
        read -r pid start flag <"$t" 2>/dev/null || continue
        if [[ -z "$pid" ]]; then
            continue
        elif ! alive "$pid" "$start"; then
            rm -f "$t"
        elif [[ "$flag" != mem ]]; then
            ((n += 1))
            [[ -z "$first" ]] && first=$pid
        fi
    done
    echo "$n $first"
}
mem_ok() {
    ((mem_min == 0)) && return 0
    local kb
    kb=$(awk '/^MemAvailable:/ { print $2 }' /proc/meminfo)
    ((kb >= mem_min * 1048576))
}

# acquire <owner> <reason> <wait 0|1> <timeout or ""> <here 0|1>: 0 taken (in
# this process with here=1, else by a keeper: taken_holder its pid), 4 shared;
# taken_hid: the hold taken or shared.
taken_holder="" taken_hid=""
acquire() {
    local owner=$1 reason=$2 wait=$3 timeout=$4 here=$5 last=-60 why
    [[ "$owner" =~ ^[A-Za-z0-9._-]{1,40}$ ]] || die "owner '$owner': a short name (letters, digits, . _ -)"
    # No CR either: a reader that turns CR into a line break (Python's text mode)
    # would see a second status line, which a timing uses (TLS-89 review r1, sol).
    [[ -n "$reason" && "$reason" != *$'\n'* && "$reason" != *$'\r'* && ${#reason} -le 200 ]] \
        || die "give a one-line reason (at most 200 characters)"
    [[ -n "$me_session" || -n "$me_token" || -n "$bind" ]] \
        || die "outside a Claude session, bind the hold (--bind PID) or use 'run'; nobody could release it otherwise"
    mkdir -p "$dir"
    local token=${me_token:-$(new_id)} line vrc
    # ⟨TLS-135 review r11, r12⟩ A timed start's verdict (request_verdict)
    # before it queues, and again at every poll below: a request related to a
    # running timing never waits for a hold that may end only with it (40:
    # already timed; 6 or 5: refused, said).
    if ((${timed:-0})); then
        vrc=0
        request_verdict "$bind" || vrc=$?
        ((vrc == 0)) || return $((vrc == 4 ? 40 : vrc))
    fi
    if ((wait)); then
        enqueue
        trap dequeue EXIT
    fi
    # ⟨TLS-105⟩ --timeout counts AWAKE time (scripts/awake-clock): a laptop that
    # slept through it gave up at once on resume. Started before the first
    # `waiting:` line (a test that sees the line knows it runs).
    [[ -z "$timeout" ]] || awake_start
    while :; do
        why=""
        if ((${timed:-0})); then
            vrc=0
            request_verdict "$bind" || vrc=$?
            if ((vrc)); then
                dequeue
                trap - EXIT
                return $((vrc == 4 ? 40 : vrc))
            fi
        fi
        if [[ -n "$ticket" ]]; then
            # A ticket removed under us (by hand) is made again, at the back.
            [[ -e "$ticket" ]] || enqueue
            if mem_ok; then mark ""; else mark mem; fi
        fi
        state
        case "$st" in
            mine)
                dequeue
                taken_hid=$hid
                echo "cdo-slot: already yours ($(describe)); nothing to do"
                return 4
                ;;
            free)
                # ⟨TLS-127 review, sol⟩ A take's publish wait stays inside
                # --timeout (the deadline is checked again only after it): the
                # awake time left, as a deadline the take measures against at
                # its lock attempt: on CLOCK_MONOTONIC when this wait reads it
                # (awake_now is then that clock), and on the wall clock as the
                # take's fall back (review r3, sol).
                if [[ -n "$timeout" ]]; then
                    awake_read
                    [[ -z "$awake_msg" ]] || echo "cdo-slot: --timeout: $awake_msg"
                    pub_deadline=""
                    [[ "$awake_base" != mono ]] || pub_deadline=$((awake_now + timeout * 1000000 - awake_us))
                    pub_deadline_wall=$((${EPOCHREALTIME//[!0-9]/} + timeout * 1000000 - awake_us))
                fi
                read -r -a line <<<"$(ahead)"
                if timed_now; then
                    # A timing whose hold has ended still keeps every new hold out.
                    why="free, but a timing runs: $(timed_describe)"
                elif ((line[0] > 0)); then
                    why="free, but ${line[0]} waiter(s) came first (the oldest is PID ${line[1]})"
                elif ! mem_ok; then
                    why="MemAvailable below $mem_min GB"
                elif ((here)) && take_hold "$owner" "$reason" "$token" run; then
                    dequeue
                    trap - EXIT
                    taken_holder=$$ taken_hid=$hid
                    echo "cdo-slot: taken by $owner ($reason)"
                    return 0
                elif ((!here)) && spawn_keeper hold "$owner" "$reason" "$token"; then
                    dequeue
                    trap - EXIT
                    taken_holder=$kpid taken_hid=$kid
                    echo "cdo-slot: taken by $owner ($reason)"
                    return 0
                else
                    # A keeper that ended on its own (a folder it cannot make)
                    # will not do better on the next try: say why, stop.
                    [[ "$why" != "its keeper ended"* ]] || die "not taken: $why"
                    state
                    if [[ "$st" != free ]]; then
                        why=$(describe)
                    elif timed_now; then
                        why="free, but a timing runs: $(timed_describe)"
                    else
                        why="taken by another acquirer just now"
                    fi
                fi
                ;;
            held) why=$(describe) ;;
        esac
        ((wait)) || die "not taken: $why (use --wait to wait for it)"
        # Say what it waits for first (every ~60 s), then check the limits.
        if ((SECONDS - last >= 60)); then
            echo "cdo-slot: waiting: $why"
            last=$SECONDS
        fi
        if [[ -n "$bind" ]] && ! alive "$bind" "$bind_start"; then
            die "the process to bind ($bind) ended while waiting: $why"
        fi
        if [[ -n "$timeout" ]]; then
            awake_read
            [[ -z "$awake_msg" ]] || echo "cdo-slot: --timeout: $awake_msg"
            ((awake_us < timeout * 1000000)) || die "not taken after ${timeout} s: $why"
        fi
        sleep "$poll"
    done
}

release() {
    state
    case "$st" in
        free)
            echo "cdo-slot: free already"
            return
            ;;
    esac
    [[ -n "$hid" ]] || die "$(describe); it names no hold this can release"
    # Ours: our token, or our session's hold (a script of ours bound to a PID too).
    if ! { [[ -n "$me_token" && "$(field token)" == "$me_token" ]] || ((own)); }; then
        die "not yours: $(describe)"
    fi
    if [[ "$(field holder_kind)" != keeper ]]; then
        die "$(describe): taken by a run (PID $holder_pid); it ends when that run ends"
    fi
    if ! end_keeper "$ids/hold.$hid"; then
        kept_warn "$ids/hold.$hid"
        exit 1
    fi
    echo "cdo-slot: released"
}

cmd=${1:-}
[[ $# -gt 0 ]] && shift
case "$cmd" in
    _keep)
        keeper "${1:-}"
        ;;
    acquire | run)
        (($# >= 2)) || { usage >&2; exit 2; }
        owner=$1 reason=$2
        shift 2
        wait=0 timeout="" timed=0
        [[ "$cmd" == run ]] && wait=1
        while (($#)); do
            case "$1" in
                --wait) wait=1 ;;
                --timed) timed=1 ;;
                --bind)
                    # Its state and start time from one read (review r11, sol).
                    bind_start=$(live_start "${2:-}") || { echo "cdo-slot: --bind needs a live PID" >&2; exit 2; }
                    bind=$2
                    shift
                    ;;
                --timeout)
                    [[ "${2:-}" =~ ^(0|[1-9][0-9]{0,6})$ ]] || { echo "cdo-slot: --timeout needs whole seconds" >&2; exit 2; }
                    timeout=$2
                    shift
                    ;;
                --)
                    shift
                    break
                    ;;
                *)
                    echo "cdo-slot: unknown argument: $1" >&2
                    usage >&2
                    exit 2
                    ;;
            esac
            shift
        done
        # Every acquire may give a keeper its go; a run waits with a deadline
        # only with --timed or --timeout.
        if [[ "$cmd" == acquire ]] || ((timed)) || [[ -n "$timeout" ]]; then
            load_awake
        fi
        if [[ "$cmd" == acquire ]]; then
            (($# == 0)) || { echo "cdo-slot: acquire takes no command" >&2; exit 2; }
            ((!timed)) || [[ -n "$bind" ]] || { echo "cdo-slot: --timed needs --bind PID (the timing process)" >&2; exit 2; }
            # A timed start related to a running timing is answered before it
            # waits for any hold, and at every poll (acquire: request_verdict);
            # the gate checks again, under its lock. One commit point for the
            # hold and the timing (commit_final).
            ((!timed)) || commit_id=$(new_id)
            rc=0
            acquire "$owner" "$reason" "$wait" "$timeout" 0 || rc=$?
            case "$rc" in
                40) exit 4 ;;
                0 | 4) ;;
                *) exit "$rc" ;;
            esac
            # Test hook: the window between taking the slot and the timing.
            [[ -z "${CDO_SLOT_TEST_PAUSE_ACQUIRED_S:-}" ]] \
                || test_pause "$CDO_SLOT_TEST_PAUSE_ACQUIRED_S"
            if ((timed)) && [[ "$rc" == 0 || "$rc" == 4 ]]; then
                trc=0
                timed_start "$owner" "$reason" "$bind" "$taken_hid" keeper || trc=$?
                if ((trc == 4)); then
                    # It owns the timing already: nothing was taken.
                    timed=0
                elif ((trc)); then
                    # The keeper this acquire started, exactly (none when shared).
                    [[ "$rc" != 0 ]] || end_keeper "$ids/hold.$taken_hid" \
                        || kept_warn "$ids/hold.$taken_hid"
                    exit "$trc"
                fi
            fi
            # Test hook: the window between the timing's go and the hold's.
            [[ -z "${CDO_SLOT_TEST_PAUSE_HOLDGO_S:-}" ]] \
                || test_pause "$CDO_SLOT_TEST_PAUSE_HOLDGO_S"
            if [[ "$rc" == 0 ]] && ! go "$taken_hid" "$ids/hold.$taken_hid"; then
                # Its keeper is gone or stopped: no hold, so no timing either.
                ((!timed)) || end_keeper "$ids/timed.$tid" || kept_warn "$ids/timed.$tid"
                if ! end_keeper "$ids/hold.$taken_hid"; then
                    kept_warn "$ids/hold.$taken_hid"
                    die "the hold's keeper did not take its go (ended or stopped), and it could not be ended"
                fi
                die "the hold's keeper did not take its go (ended or stopped); nothing is held"
            fi
            # After both go's, the timing must still run (its keeper may have
            # ended while the hold's go was waited for: review r8, sol).
            if ((timed)) && [[ "$rc" == 0 || "$rc" == 4 ]] && ! probe s "$ids/timed.$tid"; then
                [[ "$rc" != 0 ]] || end_keeper "$ids/hold.$taken_hid" \
                    || kept_warn "$ids/hold.$taken_hid"
                echo "cdo-slot: --timed refused: its timing ended before the timing began" >&2
                exit 6
            fi
            # The one commit point: its keepers keep the hold and the timing
            # only once this is written (a failure ends both).
            if [[ -n "$commit_id" ]] && { ((timed)) || [[ "$rc" == 0 ]]; }; then
                crc=0
                commit_write "$taken_hid" "$( ((timed)) && echo "$tid")" || crc=$?
                if ((crc)); then
                    ((!timed)) || end_keeper "$ids/timed.$tid" || kept_warn "$ids/timed.$tid"
                    [[ "$rc" != 0 ]] || end_keeper "$ids/hold.$taken_hid" || kept_warn "$ids/hold.$taken_hid"
                    ((!timed)) || forget_timed
                    if ((crc == 2)); then
                        echo "cdo-slot: --timed refused: $commit_why before its commit; nothing is held or timed by this start" >&2
                        exit 6
                    fi
                    echo "cdo-slot: --timed: could not write its commit mark in $commit_dir; nothing is held or timed" >&2
                    exit 5
                fi
                # Test hook: the window right after the commit.
                [[ -z "${CDO_SLOT_TEST_PAUSE_COMMITTED_S:-}" ]] \
                    || test_pause "$CDO_SLOT_TEST_PAUSE_COMMITTED_S"
            fi
            exit "$rc"
        fi
        (($#)) || { echo "cdo-slot: run needs -- <command>" >&2; exit 2; }
        export CDO_SLOT_TOKEN=${me_token:-$(new_id)}
        me_token=$CDO_SLOT_TOKEN
        bind=$$
        bind_start=$(live_start "$$")
        ((!timed)) || commit_id=$(new_id)
        rc=0
        acquire "$owner" "$reason" 1 "$timeout" 1 || rc=$?
        if [[ "$rc" == 40 ]]; then
            # It holds the slot's final timing (a timed `run` nested in a
            # timed `run`): its command runs under that timing, no second one
            # (request_verdict said so).
            rc=0
            "$@" || rc=$?
            exit "$rc"
        fi
        [[ "$rc" == 0 || "$rc" == 4 ]] || exit "$rc"
        if ((timed)); then
            rc=0
            timed_start "$owner" "$reason" "$$" "$taken_hid" here || rc=$?
            ((rc == 0 || rc == 4)) || exit "$rc"
            # Its commit point, before its command starts (exiting without it
            # drops the timing: this process holds it).
            if ((rc == 0)); then
                crc=0
                commit_write "$taken_hid" "$tid" || crc=$?
                if ((crc == 2)); then
                    echo "cdo-slot: --timed refused: $commit_why before its commit; nothing timed" >&2
                    exit 6
                elif ((crc)); then
                    echo "cdo-slot: --timed: could not write its commit mark in $commit_dir; nothing timed" >&2
                    exit 5
                fi
            fi
        fi
        # The command inherits this process's locks: the hold (when taken here)
        # and the timing end when the last process holding them ends. Holding
        # the timing's id lock file, it and all it starts own the timing, also
        # after this run is killed (THE MODEL above timing_scan).
        rc=0
        "$@" || rc=$?
        exit "$rc"
        ;;
    release)
        (($# == 0)) || { usage >&2; exit 2; }
        release
        ;;
    quiet)
        (($# == 1)) || { usage >&2; exit 2; }
        quiet "$1"
        ;;
    enter)
        if [[ "${1:-}" == --wait ]]; then
            (($# == 2)) || { usage >&2; exit 2; }
            load_awake
            enter_wait "$2"
            exit 0
        fi
        (($# == 1)) || { usage >&2; exit 2; }
        rc=0
        enter_check "$1" || rc=$?
        exit "$rc"
        ;;
    status)
        (($# == 0)) || { usage >&2; exit 2; }
        state
        t=0
        timed_now && t=1
        case "$st" in
            free) echo free ;;
            mine) echo "$(describe) (yours)" ;;
            held) describe ;;
        esac
        ((t)) && timed_describe
        [[ "$st" == free ]] && ((!t)) && exit 0
        exit 1
        ;;
    probe)
        (($# == 0)) || { usage >&2; exit 2; }
        state
        t=0
        timed_now && t=1
        echo "held=$([[ "$st" == free ]] && echo 0 || echo 1) own=$own timed=$t"
        [[ "$st" == free ]] || describe
        ((t)) && timed_describe
        exit 0
        ;;
    -h | --help) usage ;;
    *)
        usage >&2
        exit 2
        ;;
esac
