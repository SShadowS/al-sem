#!/usr/bin/env bash
# scripts/cdo-slot — the one CDO slot of this tentacle: who may run CDO-heavy or
# timed work (a landing, cdo-gate, a CDO measurement) right now.
#
# ⟨TLS-60⟩ Replaces hold messages: 147 of the orchestrator's 316 messages were
# about holds, and at least 9 times a lane's run had already started when the
# hold arrived. A session (or script) acquires the slot; the PreToolUse hook
# `scripts/claude-hooks/cdo-slot-guard` then refuses gates and CDO runs from
# every OTHER session until it is released, and builds and tests from EVERY
# session while a timing runs (--timed, TLS-89).
#
#   acquire <owner> <reason> [--wait] [--timeout S] [--bind PID] [--timed]
#       Take the slot. It is taken when nobody holds it, no timing runs,
#       MemAvailable >= 35 GB (CDO_SLOT_MEM_MIN_GB), and no earlier waiter that
#       can run now is waiting (see the queue below). Without --wait it refuses at
#       once (exit 1, naming the holder); with --wait it polls every 15 s, prints
#       the holder about every 60 s, and gives up after --timeout seconds
#       (default: never) or when the bound process ends. Waiters are served in
#       arrival order (TLS-88): a free slot goes to the oldest waiter still alive,
#       and an acquire without --wait refuses while anyone waits. A waiter short
#       of memory steps aside until it has it, keeping its place.
#       The hold is kept by a detached keeper process. It ends when the --bind
#       PID ends (even killed outright), else when the acquiring Claude process
#       (CLAUDE_PID) ends, else at `release`. Outside a Claude session an acquire
#       must be bound (or come from `run`).
#       Exit 0: taken. Exit 4: already yours, nothing to release: the holder's
#       CDO_SLOT_TOKEN is in the environment (a script's hold, shared with what
#       it starts), or this Claude session holds it unbound (by hand).
#       --timed (needs --bind; TLS-89): a timing runs in the hold, taken or
#       shared, while the bound process lives, so no build may. It takes the
#       timing lock first (the guard then refuses new builds and tests), then
#       waits for the build processes already running (cargo, cargo-nextest,
#       rustc, rustdoc: CDO_SLOT_BUILD_NAMES; and scripts/ci-steps, check-goldens
#       between their cargo steps: CDO_SLOT_BUILD_SCRIPTS) outside the bound
#       process's own line, printing their PIDs every ~60 s, until none is seen
#       for CDO_SLOT_TIMED_GRACE_S (3) s in a row (a command the guard allowed a
#       moment before starts a moment later). A build still seen at
#       CDO_SLOT_TIMED_WAIT_S (1800) s, or the hold gone by then: exit 6, no
#       timing (and the hold released, when this acquire took it); never a
#       silent start beside a build.
#   release
#       Give the slot back: end its keeper. Only its holder may (its session or
#       token). A hold taken by `run` ends with that run, never by `release`.
#   status
#       `free` (exit 0), or `held by ...` (exit 1). While a timing runs it adds a
#       line `timed by <owner> since <time> (<reason>)` (exit 1, even when free).
#       ⟨TLS-104⟩ Either line names the seconds the host spent suspended since
#       (`scripts/host-suspended`; server1 is a laptop that sleeps when moved),
#       2 s or more: an old hold can be a laptop that slept, not a hung holder.
#   probe
#       For the guard: `held=<0|1> own=<0|1> timed=<0|1>` (own: this Claude
#       session's hold, bound or not), then the hold's and the timing's lines.
#   run <owner> <reason> [--timed] -- <command...>
#       acquire --wait, in this process, run the command. The hold (and the
#       timing) is this process's and its command's: it ends when the last of
#       them ends, killed or not. Inside a holder's run (its token) it shares the
#       hold and just runs.
#
# ⟨TLS-89, the invariant⟩ Only kernel locks decide; files describe. The hold is
# an exclusive flock on `$CDO_SLOT_DIR/lock` (default /work/.al-sem/cdo-slot)
# plus one on `id/hold.<hid>`, a fresh random id per hold. A timing is a SHARED
# flock on `timed.lock` (each timing takes its own) plus one on
# `id/timed.<tid>`. A process that dies drops its locks, so no hold or timing
# outlives every process that has it, and none is ever ended by guessing that a
# process is gone. Every decision is one lock probe (a flock with a 0.1 s wait,
# `probe`), never a read of a file. The status file (owner, reason, start,
# session, bound PID, holder PID, token, hid) is written once, whole, by the
# hold's own holder; a reader trusts it only for the hold whose id lock it then
# probes as held (a file of an older hold names a dead id). A timing's own file
# (`timed/<tid>`) is read the same way. Five review rounds found race windows
# in the earlier file-and-liveness design (TLS-89 CHANGELOG); a lock probe has
# no window: the kernel answers for that instant.
set -euo pipefail

usage() {
    sed -n '/^#   acquire/,/^#       hold and just runs/p' "$0" | sed 's/^# \{0,1\}//'
    echo "Environment: CDO_SLOT_DIR, CDO_SLOT_MEM_MIN_GB (35), CDO_SLOT_POLL_S (15),"
    echo "CDO_SLOT_TIMED_WAIT_S (1800), CDO_SLOT_TIMED_GRACE_S (3), CDO_SLOT_LOCK_WAIT_S (30),"
    echo "CDO_SLOT_BUILD_NAMES (cargo cargo-nextest rustc rustdoc), CDO_SLOT_BUILD_SCRIPTS (ci-steps check-goldens)."
}
die() {
    echo "cdo-slot: $*" >&2
    exit 1
}

self=$(realpath "$0")
# One spelling of the folder (a trailing slash or a symlink must not make two
# names for one lock, or a holder search by path miss it).
dir=$(realpath -m "${CDO_SLOT_DIR:-/work/.al-sem/cdo-slot}")
lock="$dir/lock"
ids="$dir/id"
# Not `timed`: TLS-89's first design kept a timing mark in a FILE of that name,
# and one left in the real slot folder stopped every timing (its manual landing).
tdir="$dir/timings"
timed_lock="$dir/timed.lock"
status_file="$dir/status"
mem_min="${CDO_SLOT_MEM_MIN_GB:-35}"
poll="${CDO_SLOT_POLL_S:-15}"
timed_wait="${CDO_SLOT_TIMED_WAIT_S:-1800}"
timed_grace="${CDO_SLOT_TIMED_GRACE_S:-3}"
lock_wait="${CDO_SLOT_LOCK_WAIT_S:-30}"
build_names="${CDO_SLOT_BUILD_NAMES:-cargo cargo-nextest rustc rustdoc}"
build_scripts="${CDO_SLOT_BUILD_SCRIPTS:-ci-steps check-goldens}"
[[ "$mem_min" =~ ^(0|[1-9][0-9]{0,5})$ ]] || die "CDO_SLOT_MEM_MIN_GB '$mem_min': whole GB, no leading zero"
[[ "$poll" =~ ^[1-9][0-9]{0,3}$ ]] || die "CDO_SLOT_POLL_S '$poll': whole seconds"
[[ "$timed_wait" =~ ^(0|[1-9][0-9]{0,6})$ ]] || die "CDO_SLOT_TIMED_WAIT_S '$timed_wait': whole seconds"
[[ "$timed_grace" =~ ^(0|[1-9][0-9]?)$ ]] || die "CDO_SLOT_TIMED_GRACE_S '$timed_grace': whole seconds, at most 99"
[[ "$lock_wait" =~ ^[1-9][0-9]{0,3}$ ]] || die "CDO_SLOT_LOCK_WAIT_S '$lock_wait': whole seconds"
[[ "$build_names" =~ ^[A-Za-z0-9._\ -]+$ ]] || die "CDO_SLOT_BUILD_NAMES '$build_names': process names, space-separated"
# A process name (comm) holds at most 15 characters: a longer one never matches.
for n in $build_names; do
    ((${#n} <= 15)) || die "CDO_SLOT_BUILD_NAMES: '$n' is longer than a process name (15 characters)"
done
[[ "$build_scripts" =~ ^[A-Za-z0-9._\ -]+$ ]] || die "CDO_SLOT_BUILD_SCRIPTS '$build_scripts': script names, space-separated"
me_session="${CLAUDE_CODE_SESSION_ID:-}"
me_pid="${CLAUDE_PID:-}"
me_token="${CDO_SLOT_TOKEN:-}"
bind="" bind_start=""
command -v flock >/dev/null || die "flock is needed"

# proc_fields <pid>: its /proc stat fields from the state on (state = $1,
# start time = $20); nothing when it is gone.
proc_fields() { sed 's/.*) //' "/proc/$1/stat" 2>/dev/null || true; }
# alive <pid> [start]: running (a zombie is not) and, with a start time, still
# the same process (not a reused PID). Used only to END things (a keeper's
# watch, a waiter's ticket), never to decide who holds what.
alive() {
    [[ "${1:-}" =~ ^[1-9][0-9]*$ ]] || return 1
    local f
    read -r -a f <<<"$(proc_fields "$1")"
    [[ ${#f[@]} -gt 19 && "${f[0]}" != Z ]] || return 1
    [[ -z "${2:-}" || "${f[19]}" == "$2" ]]
}
proc_start() { local f; read -r -a f <<<"$(proc_fields "$1")"; echo "${f[19]:-}"; }
new_id() { od -An -N8 -tx8 /dev/urandom | tr -d ' '; }
# test_pause <seconds>: the test hooks' window. It writes `paused.<pid>` (the
# test waits for it), then waits until the test makes `$dir/resume`, at most
# <seconds>. A fixed sleep could end before the test's steps in the window did
# under load (TLS-89's gates).
test_pause() {
    : >"$dir/paused.$$"
    local w
    for ((w = 0; w < ${1%.*} * 20 + 20; w++)); do
        [[ -e "$dir/resume" ]] && break
        sleep 0.05
    done
    rm -f "$dir/resume"
}

# probe <s|x> <lock file>: 0 when some process holds the lock against a probe of
# that kind, 1 when not (or the file does not exist). `s` finds an exclusive
# holder (probes never block each other); `x` finds shared holders too (the
# timing lock). An `s` probe answers at once (-n): only a holder takes these locks
# exclusive, and one taking it as the probe runs is taking it. An `x` probe that
# finds the lock busy looks again with a 0.1 s wait: another `x` probe has it
# for an instant, a timing keeps it. (TLS-89's second landing: a 0.1 s wait on
# every busy probe made the guard test pass its 300 s watchdog under load.)
# Any other flock failure stops with exit 5 (the hook then allows: a broken probe
# is no holder).
probe() {
    [[ -e "$2" ]] || return 1
    local rc=0
    flock -"$1" -n -E 75 "$2" true 2>/dev/null || rc=$?
    if [[ "$1" == x && "$rc" == 75 ]]; then
        rc=0
        flock -x -E 75 -w 0.1 "$2" true 2>/dev/null || rc=$?
    fi
    case "$rc" in
        0) return 1 ;;
        75) return 0 ;;
        *)
            echo "cdo-slot: cannot probe the lock $2 (flock exit $rc)" >&2
            exit 5
            ;;
    esac
}
# holders_of <file>: "PID n (cmdline, state s)" for each process with the file
# open (/proc/locks cannot say: it hides a lock whose flock(1) has exited).
holders_of() {
    local p
    for p in $(find /proc/[0-9]*/fd -lname "$1" 2>/dev/null | cut -d/ -f3 | sort -un); do
        printf 'PID %s (%s, state %s) ' "$p" "$(tr '\0' ' ' <"/proc/$p/cmdline" 2>/dev/null | cut -c1-80)" \
            "$(awk '{ print $3 }' "/proc/$p/stat" 2>/dev/null)"
    done
}
# keepers_of <file>: the PIDs of the keepers (`cdo-slot _keep`) that have the
# lock file open: found by the lock itself, never by a PID a file names.
keepers_of() {
    local p
    # Test hook: only this call's first scan finds anything, as when a later
    # scan misses a keeper that is still there (TLS-102's stress run).
    if [[ -n "${CDO_SLOT_TEST_SCAN_ONCE:-}" ]]; then
        [[ ! -e "$dir/scanned.$$" ]] || return 0
        : >"$dir/scanned.$$"
    fi
    for p in $(find /proc/[0-9]*/fd -lname "$1" 2>/dev/null | cut -d/ -f3 | sort -un); do
        # An `if`, not `grep && echo`: a non-keeper listed last (a probe that
        # has the file open for an instant) left the loop's status 1, and
        # `ps=$(keepers_of ...)` under `set -e` then ended `release` with exit
        # 1 (TLS-89's landing, the queue test under load).
        is_keeper_cmd "$p" || continue
        # Only the keeper itself: each `$(...)` it runs forks a subshell with
        # its command line and descriptors for a moment (TLS-102's landing).
        is_keeper_cmd "$(ppid_of "$p")" && continue
        echo "$p"
    done
}
# is_keeper_cmd <pid>: that process runs `cdo-slot _keep`.
is_keeper_cmd() {
    [[ "${1:-}" =~ ^[1-9][0-9]*$ ]] || return 1
    tr '\0' ' ' <"/proc/$1/cmdline" 2>/dev/null | grep -q " _keep "
}

# write_atomic <file> <content>: the whole file at once (write, then rename): a
# reader sees the old file or the new one, never part of it.
write_atomic() {
    local tmp
    tmp="$1.w$$.$(new_id)"
    if [[ -n "${CDO_SLOT_TEST_WRITE_PAUSE_S:-}" ]]; then
        # Test hook: the first third, a pause, then the rest; a reader polling
        # meanwhile must never see the part.
        local n third
        n=$(wc -l <<<"$2")
        third=$((n / 3))
        head -n "$third" <<<"$2" >"$tmp"
        : >"$dir/paused.$$"
        sleep "$CDO_SLOT_TEST_WRITE_PAUSE_S"
        tail -n +"$((third + 1))" <<<"$2" >>"$tmp" && mv -f "$tmp" "$1"
        return
    fi
    printf '%s\n' "$2" >"$tmp" && mv -f "$tmp" "$1"
}
# load <file>: read it ONCE into snap; `field` reads from that copy.
snap=""
load() { snap=$(cat "$1" 2>/dev/null || true); }
field() { { sed -n "s/^$1=//p" <<<"$snap" || true; } | head -n 1; }

# The locks this process holds, so the sleeps of a keeper do not inherit them
# (a keeper killed outright must not leave a `sleep` child holding its hold).
held_fds=()
nap() {
    local r="" f
    for f in "${held_fds[@]}"; do r+=" $f>&-"; done
    eval "sleep $1$r"
}

# state: from one probe of the hold lock, one read of the status, one probe of
# the id lock it names. st = free | mine | held; own = this Claude session's
# hold (bound or not, the guard's question); hid, holder_pid, bound: the hold's,
# only when its id lock is held (the status describes it).
#   mine: our token, or our Claude session holding unbound (shareable); a hold of
#   our own session bound to a process (a land, a run) is not shareable: it ends
#   with that process, and a second land of the same session waits for it.
state() {
    holder_pid="" bound="" hid="" own=0
    if ! probe s "$lock"; then
        st=free
        return
    fi
    st=held
    load "$status_file"
    local h session token
    h=$(field hid)
    # A status of an older hold names a dead id: say "held", trust nothing in it.
    [[ "$h" =~ ^[0-9a-f]{16}$ ]] && probe s "$ids/hold.$h" || return 0
    hid=$h
    holder_pid=$(field holder_pid)
    session=$(field session)
    token=$(field token)
    # Test hook: a pause between `session` and `bound`, in which a test removes
    # the status file (the read-once rule: read field by field from the file,
    # `bound` would come back "" and a bound hold read as an unbound one).
    [[ -z "${CDO_SLOT_TEST_PAUSE_S:-}" ]] || test_pause "$CDO_SLOT_TEST_PAUSE_S"
    bound=$(field bound)
    [[ -n "$me_session" && "$session" == "$me_session" ]] && own=1
    if [[ -n "$me_token" && "$token" == "$me_token" ]] || { ((own)) && [[ -z "$bound" ]]; }; then
        st=mine
    fi
}
describe() {
    if [[ -z "$hid" ]]; then
        # The holder truncates the lock file as it takes it: its mtime is when.
        local taken
        taken=$(stat -c %Y "$lock" 2>/dev/null || date +%s)
        if (($(date +%s) - taken < 5)); then
            echo "held (its holder is still writing its status)"
        else
            echo "held by an unknown holder (no status names it) since $(date -u -d "@$taken" +%FT%TZ): $(holders_of "$lock")"
        fi
        return
    fi
    local since age who
    since=$(field since)
    age=$(($(date +%s) - $(date -d "$since" +%s 2>/dev/null || date +%s)))
    who="session $(field session)"
    [[ -n "$bound" ]] && who+=", for PID $bound"
    echo "held by $(field owner) ($(field reason)) since $since ($((age / 60)) min$(suspended_since), $who"
}

# ⟨TLS-104⟩ `, N s of it with the host suspended)` when the host was suspended
# since the record was written (its `suspended=` reading), else `)`: an old hold
# can be a laptop that slept, not a hung holder (server1 suspends when moved).
host_suspended() { "$(dirname "$0")/host-suspended" 2>/dev/null; }
host_clocks() { "$(dirname "$0")/host-suspended" --clocks 2>/dev/null; }
# At least 2 s: the readings are whole seconds (one that crossed a second
# boundary moves by 1; review, sol), and a real suspend lasts far longer.
# `$1`: the words after the seconds (default `of it with the host suspended`).
suspended_since() {
    local s0 s1
    s0=$(field suspended)
    s1=$(host_suspended)
    if [[ "$s0" =~ ^[0-9]+$ && "$s1" =~ ^[0-9]+$ ]] && ((s1 - s0 >= 2)); then
        echo ", $((s1 - s0)) s ${1:-of it with the host suspended})"
    else
        echo ")"
    fi
}

# timed_now: a timing runs (some process holds the timing lock).
timed_now() { probe x "$timed_lock"; }
# timed_describe: the line of a running timing: the first timing file whose id
# lock is held (one read of each file).
timed_describe() {
    local f
    for f in "$tdir"/*; do
        [[ -f "$f" ]] || continue
        probe s "$ids/timed.${f##*/}" || continue
        load "$f"
        echo "timed by $(field owner) since $(field since) ($(field reason)$(suspended_since "with the host suspended since")"
        return
    done
    echo "timed (its timing is starting)"
}

# take_hold <owner> <reason> <token> <kind>: take the hold in THIS process: the
# hold lock, then a fresh id lock, then the status. 0: taken (hid set); 1: held.
take_hold() {
    mkdir -p "$ids" || die "cannot make the folder $ids (something else has the name?)"
    local lfd hfd
    # Test hook: the window between the acquire's checks and the hold lock.
    [[ -z "${CDO_SLOT_TEST_PAUSE_TAKE_S:-}" ]] || test_pause "$CDO_SLOT_TEST_PAUSE_TAKE_S"
    exec {lfd}>"$lock"
    # Up to 1 s: a probe has the lock for an instant.
    if ! flock -x -w 1 "$lfd"; then
        exec {lfd}>&-
        return 1
    fi
    # A timing that began after this acquire's check (its own hold released
    # meanwhile) still keeps every new hold out: checked again under the hold
    # lock (TLS-89 review r7, sol). A timing that starts after this needs a hold
    # it can probe at its end, and the only one is this one.
    if timed_now; then
        exec {lfd}>&-
        return 1
    fi
    held_fds+=("$lfd")
    # No other hold lives under the hold lock: every id lock file left is dead.
    find "$ids" -maxdepth 1 -name 'hold.*' -delete 2>/dev/null || true
    hid=$(new_id)
    exec {hfd}>"$ids/hold.$hid"
    flock -x -n "$hfd" || die "cannot lock the new hold id $ids/hold.$hid"
    held_fds+=("$hfd")
    # Test hook: the window in which the hold is taken (`held=1`) but its status
    # is not written yet; a `release` then cannot name it and refuses.
    [[ -z "${CDO_SLOT_TEST_PAUSE_PUBLISH_S:-}" ]] || test_pause "$CDO_SLOT_TEST_PAUSE_PUBLISH_S"
    write_atomic "$status_file" "owner=$1
reason=$2
since=$(date -u +%FT%TZ)
suspended=$(host_suspended)
session=$me_session
claude_pid=$me_pid
bound=$bind
bound_start=$bind_start
holder_pid=$$
holder_kind=$4
token=$3
hid=$hid" || die "cannot write the status $status_file (exiting drops the hold)"
}
# take_timed <owner> <reason> <pid>: take a timing in THIS process: the timing
# lock (shared), a fresh id lock, then its file. 0: taken (tid set); 5: the
# timing lock stayed taken for CDO_SLOT_LOCK_WAIT_S (only a probe takes it
# exclusive, for an instant: a stopped or hung one; why says who).
take_timed() {
    if ! mkdir -p "$ids" "$tdir" 2>/dev/null; then
        why="cannot make the folders $ids and $tdir (something else has one of the names?)"
        return 5
    fi
    local tfd xfd
    exec {tfd}>"$timed_lock"
    if ! flock -s -w "$lock_wait" "$tfd"; then
        exec {tfd}>&-
        why="the timing lock $timed_lock was held for ${lock_wait} s by $(holders_of "$timed_lock"); refusing (a stopped or hung cdo-slot probe: end it)"
        return 5
    fi
    tid=$(new_id)
    exec {xfd}>"$ids/timed.$tid"
    flock -x -n "$xfd" || die "cannot lock the new timing id $ids/timed.$tid"
    held_fds+=("$tfd" "$xfd")
    timed_fds=("$tfd" "$xfd")
    write_atomic "$tdir/$tid" "owner=$1
reason=$2
since=$(date -u +%FT%TZ)
suspended=$(host_suspended)
pid=$3" || die "cannot write the timing file $tdir/$tid (exiting drops the timing)"
    # Files of timings that ended long ago (their id lock free) go.
    for f in $(find "$tdir" -maxdepth 1 -type f -mmin +5 2>/dev/null); do
        probe s "$ids/timed.${f##*/}" || rm -f "$f" "$ids/timed.${f##*/}"
    done
}
# drop_timed: end the timing this process holds (a refusal); its hold stays.
timed_fds=()
drop_timed() {
    local f
    for f in "${timed_fds[@]}"; do exec {f}>&-; done
    timed_fds=()
    rm -f "$tdir/$tid"
}

# A keeper (`cdo-slot _keep hold|timed`, started detached by an acquire): takes
# its locks, says so in its ready file ("<pid> <id>", or "fail <why>"), waits
# for `go.<pid>` while its acquire lives (an acquire killed before it says go,
# in a timed wait, leaves nothing behind), then keeps the locks while what it
# watches lives.
keeper() {
    local fd
    # Keep no descriptor of the caller (a pipe it waits on, a lock of a run).
    # No `2>/dev/null` on the loop: bash keeps the real stderr on a spare fd
    # above 2 for the loop's length, the loop closed that fd too, and stderr was
    # lost for good (TLS-89's manual landing: a keeper's death said nothing).
    # Closing an fd that is not open is silent anyway. An `if`, not `&&`: under
    # `set -e` a false last test would end the keeper.
    for fd in /proc/$$/fd/*; do
        fd=${fd##*/}
        if [[ "$fd" =~ ^[0-9]+$ ]] && ((fd > 2)); then
            eval "exec $fd>&-"
        fi
    done
    me_session=$CS_SESSION me_pid=$CS_PID bind=$CS_BIND bind_start=$CS_BIND_START
    local id rc=0
    case "$1" in
        hold)
            take_hold "$CS_OWNER" "$CS_REASON" "$CS_TOKEN" keeper || exit 75
            id=$hid
            ;;
        timed)
            take_timed "$CS_OWNER" "$CS_REASON" "$CS_BIND" || rc=$?
            if ((rc)); then
                write_atomic "$CS_READY" "fail $why"
                exit "$rc"
            fi
            id=$tid
            ;;
    esac
    # Test hook: a subshell of this keeper (its command line and environment,
    # none of its locks) held until the test makes `fork-done`, as each `$(...)`
    # it runs is for a moment (TLS-102: a count by command line saw two).
    if [[ -n "${CDO_SLOT_TEST_KEEPER_FORK:-}" ]]; then
        (
            for fd in "${held_fds[@]}"; do eval "exec $fd>&-"; done
            while [[ ! -e "$dir/fork-done" ]]; do sleep 0.05; done
        ) &
    fi
    write_atomic "$CS_READY" "$$ $id"
    # The go file is named by this keeper's own id (never a reusable PID), and
    # removing it is the acknowledgement its acquire waits for.
    while [[ ! -e "$dir/go.$id" ]]; do
        alive "$CS_WRITER" "$CS_WRITER_START" || exit 0
        nap 0.2
    done
    rm -f "$dir/go.$id"
    if [[ -n "$CS_BIND" ]]; then
        while alive "$CS_BIND" "$CS_BIND_START"; do nap 2; done
    elif [[ -n "$CS_PID" ]]; then
        # A Claude PID counts only while it is still the same claude process.
        while alive "$CS_PID" "$CS_PID_START" && grep -q claude "/proc/$CS_PID/comm" "/proc/$CS_PID/cmdline" 2>/dev/null; do
            nap 2
        done
    else
        while :; do nap 3600; done
    fi
    exit 0
}
# spawn_keeper <hold|timed> <owner> <reason> <token>: start one; 0 with kpid and
# kid (its id) set; 1 when it did not take its locks (why set for a timing).
spawn_keeper() {
    local ready="$dir/ready.$$.$(new_id)" n line
    kpid="" kid=""
    CS_OWNER="$2" CS_REASON="$3" CS_TOKEN="$4" CS_BIND="$bind" CS_BIND_START="$bind_start" \
        CS_SESSION="$me_session" CS_PID="$me_pid" CS_PID_START="$(proc_start "${me_pid:-0}")" \
        CS_WRITER="$$" CS_WRITER_START="$(proc_start $$)" CS_READY="$ready" \
        setsid bash "$self" _keep "$1" </dev/null >/dev/null 2>"$ready.err" &
    local child=$!
    for n in $(seq 1200); do
        if [[ -s "$ready" ]]; then
            read -r line <"$ready"
            rm -f "$ready" "$ready.err"
            if [[ "$line" == fail* ]]; then
                why=${line#fail }
                return 1
            fi
            kpid=${line%% *} kid=${line#* }
            return 0
        fi
        # Test hook: the window between the ready check and the liveness check.
        [[ -z "${CDO_SLOT_TEST_PAUSE_SPAWN_S:-}" ]] || sleep "$CDO_SLOT_TEST_PAUSE_SPAWN_S"
        if ! alive "$child"; then
            # It may have written its ready file (a "fail <why>" too) and
            # ended just after the check above: read it then (TLS-89's
            # 3x-under-load check lost a refusal's why this way).
            [[ -s "$ready" ]] && continue
            local krc=0
            wait "$child" 2>/dev/null || krc=$?
            # 75: another acquirer took the hold lock first (plain contention).
            # Any other end without a word: say what it printed (a keeper's
            # stderr goes to this file; TLS-89's manual landing got only "not
            # taken").
            ((krc == 75)) \
                || why="its keeper ended (exit $krc) before it took its locks: $(tail -n 3 "$ready.err" 2>/dev/null | tr '\n' ' ')"
            rm -f "$ready" "$ready.err"
            return 1
        fi
        sleep 0.05
    done
    rm -f "$ready" "$ready.err"
    kill "$child" 2>/dev/null || true
    why="its keeper did not start"
    return 1
}
# go <id> <its lock file>: tell the keeper of <id> to go on, and wait until it
# acknowledges (removes the file; only a live keeper does) while it still holds
# that lock. 0: it went on (what it watches decides its life from then on); 1:
# it was gone before it took the go (killed: TLS-89 review r7, sol).
# A keeper that does not take it within CDO_SLOT_LOCK_WAIT_S (stopped): 1 too,
# and a go file that cannot be made is no go (review r8, sol).
go() {
    : >"$dir/go.$1" || return 1
    local until_s=$((SECONDS + lock_wait))
    while [[ -e "$dir/go.$1" ]]; do
        if ! probe s "$2"; then
            # It may have taken the go and ended just after the check above.
            [[ -e "$dir/go.$1" ]] || return 0
            rm -f "$dir/go.$1"
            return 1
        fi
        if ((SECONDS >= until_s)); then
            rm -f "$dir/go.$1"
            return 1
        fi
        sleep 0.05
    done
}
# end_keeper <lock file>: end the keeper of exactly that hold or timing (the one
# with its id lock open). 0 when nothing holds that lock any more (none did, or
# its keeper is gone); 1 when something still holds it after 5 rounds.
# TLS-102's stress run left a STOPPED keeper alive: every step trusted a fresh
# /proc scan. Now the keepers found are recorded once (PID and start time),
# waited for and killed by that record, and the lock itself says when it is done.
end_keeper() {
    local round
    for round in 1 2 3 4 5; do
        probe s "$1" || return 0
        end_keepers_once "$1"
    done
    ! probe s "$1"
}
# kept_warn <lock file>: say that a keeper could not be ended, and who holds it.
kept_warn() { echo "cdo-slot: could not end the keeper of $1; still holding it: $(holders_of "$1")" >&2; }
# end_keepers_once <lock file>: TERM the keepers holding it, then KILL any of
# exactly those still alive after 5 s (a stopped one is alive: only KILL ends it).
end_keepers_once() {
    local ps p n live
    local -a found=()
    ps=$(keepers_of "$1")
    for p in $ps; do found+=("$p:$(proc_start "$p")"); done
    ((${#found[@]})) || { sleep 0.2; return 0; }
    # shellcheck disable=SC2086 # one word per PID
    kill $ps 2>/dev/null || true
    for n in $(seq 50); do
        live=0
        for p in "${found[@]}"; do alive "${p%%:*}" "${p#*:}" && live=1; done
        ((live)) || return 0
        sleep 0.1
    done
    for p in "${found[@]}"; do
        if alive "${p%%:*}" "${p#*:}"; then kill -9 "${p%%:*}" 2>/dev/null || true; fi
    done
    return 0
}

ppid_of() { local f; read -r -a f <<<"$(proc_fields "$1")"; echo "${f[1]:-}"; }
# script_builds: "PID name" of each process running a build script
# (CDO_SLOT_BUILD_SCRIPTS: ci-steps, check-goldens), read from its argv: the
# script is argv[0], or the first non-option argument of a shell or python
# argv[0]. Between their cargo steps (ci-steps' agentflow pytest, ~2 min) no
# process has a build name, so the build names alone would let a timing start
# there (review r1, Fable). Exact argv words, never a `-f` pattern.
# script_operand: in `a` (an interpreter's argv), set i to the script operand's
# index after the options, or -1 when there is none (`-c` command string, `python
# -m`). Option operands are skipped (review r1, sol): a shell's `-o`/`-O` (each
# one in a cluster: `-euo pipefail`), --rcfile/--init-file; python's -W/-X.
script_operand() {
    local w py=0 k
    [[ "${a[0]##*/}" == python* ]] && py=1
    i=1
    while ((i < ${#a[@]})); do
        w=${a[i]}
        if [[ "$w" == -- ]]; then
            i=$((i + 1))
            break
        fi
        [[ "$w" == [-+]?* ]] || break
        i=$((i + 1))
        case "$w" in
            --rcfile | --init-file) i=$((i + 1)); continue ;;
            --*) continue ;;
        esac
        if ((py)); then
            # Letter by letter: -W/-X take the rest as their value (`-Xtracemalloc`)
            # or, last in the cluster, the next word (review r2, sol).
            for ((k = 1; k < ${#w}; k++)); do
                case "${w:k:1}" in
                    c | m) i=-1; return ;;
                    W | X)
                        ((k == ${#w} - 1)) && i=$((i + 1))
                        break
                        ;;
                esac
            done
        else
            [[ "${w:1}" == *c* ]] && { i=-1; return; }
            for ((k = 1; k < ${#w}; k++)); do
                [[ "${w:k:1}" == [oO] ]] && i=$((i + 1))
            done
        fi
    done
}
script_builds() {
    local d a i
    for d in /proc/[0-9]*; do
        mapfile -d '' -t a 2>/dev/null <"$d/cmdline" || continue
        ((${#a[@]})) || continue
        i=0
        case "${a[0]##*/}" in
            bash | sh | dash | zsh | python | python3)
                script_operand
                ((i >= 0)) || continue
                ;;
        esac
        ((i < ${#a[@]})) || continue
        case " $build_scripts " in
            *" ${a[i]##*/} "*) echo "${d#/proc/} ${a[i]##*/}" ;;
        esac
    done
}
# foreign_builds <pid>: the running build processes (CDO_SLOT_BUILD_NAMES, matched
# by exact name with `pgrep -x`: a `-f` pattern would match this script's own
# command line; and script_builds) that are alive (not zombies) and are neither
# <pid>, its ancestors nor its descendants (a timed script's own build, or the
# cargo test that runs it), nor an ancestor of a waiter in the queue: a
# `ci-steps` parked in `acquire --wait` builds nothing while it waits, and
# counting it made two timings wait on each other until CDO_SLOT_TIMED_WAIT_S
# (TLS-108, review Fable and sol); "PID name" lines.
foreign_builds() {
    local root=$1 line=" " parked=" " q p name t
    q=$root
    while [[ "$q" =~ ^[1-9][0-9]*$ ]]; do
        line+="$q "
        q=$(ppid_of "$q")
    done
    for t in "$queue"/*; do
        [[ -f "$t" ]] || continue
        read -r q _ <"$t" 2>/dev/null || continue
        alive "$q" || continue
        while [[ "$q" =~ ^[1-9][0-9]*$ && "$q" != 1 ]]; do
            parked+="$q "
            q=$(ppid_of "$q")
        done
    done
    while read -r p name; do
        [[ -n "$p" ]] || continue
        alive "$p" || continue
        [[ "$line" == *" $p "* ]] && continue
        [[ "$parked" == *" $p "* ]] && continue
        q=$p
        while [[ "$q" =~ ^[1-9][0-9]*$ && "$q" != 1 ]]; do
            [[ "$q" == "$root" ]] && continue 2
            q=$(ppid_of "$q")
        done
        echo "$p $name"
    done < <(
        for name in $build_names; do
            for p in $(pgrep -x -- "$name" || true); do echo "$p $name"; done
        done
        script_builds
    )
}
# timed_start <owner> <reason> <pid> <hid> <here|keeper>: a timing in hold <hid>
# while <pid> lives. It takes the timing lock (in this process for `run`, whose
# command inherits it; in a keeper bound to <pid> for `acquire`), so the guard
# refuses new builds from then on, then waits for the builds already running.
# 0: timed (a keeper's go given); 5: the timing lock could not be taken; 6: a
# build still ran at CDO_SLOT_TIMED_WAIT_S, or hold <hid> ended meanwhile (the
# timing taken back).
timed_start() {
    local tkpid="" rc=0
    if [[ "$5" == here ]]; then
        take_timed "$1" "$2" "$3" || rc=$?
    else
        spawn_keeper timed "$1" "$2" "" || rc=5
        tkpid=$kpid tid=$kid
    fi
    if ((rc)); then
        echo "cdo-slot: --timed: ${why:-the timing lock was not taken}" >&2
        return 5
    fi
    # refuse <message>: take the timing back (only this call's), say why.
    refuse() {
        [[ -z "${CDO_SLOT_TEST_PAUSE_REFUSE_S:-}" ]] \
            || test_pause "$CDO_SLOT_TEST_PAUSE_REFUSE_S"
        if [[ -n "$tkpid" ]]; then
            end_keeper "$ids/timed.$tid" || kept_warn "$ids/timed.$tid"
        else
            drop_timed
        fi
        echo "cdo-slot: --timed refused: $*" >&2
        return 6
    }
    # Microseconds: the deadline holds below a second too.
    # ⟨TLS-104⟩ The wall clock keeps counting through a host suspend: a laptop
    # that slept 33 min would "wait" its 1800 s in a few real seconds and refuse
    # falsely (review, Fable), and its grace would end with no build given the
    # chance to start (review r2, sol). So the wait and the grace run on AWAKE
    # time, CLOCK_MONOTONIC (`host-suspended --clocks`: the reading and the clock
    # from one process, so no suspend falls between them; review r3, sol). Each
    # new sleep is said once. With the clocks unreadable, the wall clock (as before).
    local now start last=-60 b list left_us nap_us quiet="" susp0="" susp mono="" slept=0 awake=""
    # The time base is chosen once: awake time if the first read works. A later
    # failed read keeps the last awake time (the wait only grows: the safe side).
    # The awake clock is judged on its own (review r4, sol): a bad suspended
    # field costs only the log line, never the time base.
    slot_clocks() {
        local s="" _b m=""
        read -r s _b m < <(host_clocks) || true
        [[ "$s" =~ ^[0-9]+$ ]] && susp=$s || susp=""
        if [[ "$m" =~ ^[0-9]+$ && "$awake" != 0 ]]; then
            mono=$m awake=1
        elif [[ "$awake" != 1 ]]; then
            mono=${EPOCHREALTIME//[!0-9]/} awake=0
        fi
    }
    slot_clocks
    susp0=$susp
    start=$mono
    local wait_us=$((timed_wait * 1000000)) grace_us=$((timed_grace * 1000000))
    while :; do
        b=$(foreign_builds "$3")
        slot_clocks
        if [[ "$susp0" =~ ^[0-9]+$ && "$susp" =~ ^[0-9]+$ ]] && ((susp - susp0 - slept >= 2)); then
            echo "cdo-slot: timed: the host slept $((susp - susp0 - slept)) s during this wait: it goes on that much longer"
            slept=$((susp - susp0))
        fi
        now=$mono
        if [[ -n "$b" ]]; then
            quiet=""
            list=$(awk '{ printf "%sPID %s (%s)", (NR > 1 ? ", " : ""), $1, $2 }' <<<"$b")
            left_us=$((wait_us - (now - start)))
            # A build seen at (or past) the deadline refuses; the sleeps below
            # never pass the deadline, so a scan always lands on it.
            ((left_us > 0)) || { refuse "build processes still running after ${timed_wait} s: $list"; return; }
            if ((SECONDS - last >= 60)); then
                echo "cdo-slot: timed: waiting for build processes to end: $list"
                last=$SECONDS
            fi
            nap_us=$((left_us < poll * 1000000 ? left_us : poll * 1000000))
        else
            # None seen: start (or go on) counting the grace (a command the
            # guard allowed just before the timing lock was taken may start now).
            if [[ -z "$quiet" ]]; then
                quiet=$now
                # Test hook: the grace's first moment, after the first empty
                # scan (a build the guard allowed may start now).
                [[ -z "${CDO_SLOT_TEST_PAUSE_GRACE_S:-}" ]] || test_pause "$CDO_SLOT_TEST_PAUSE_GRACE_S"
            fi
            ((now - quiet < grace_us)) || break
            nap_us=$((grace_us - (now - quiet)))
            ((nap_us < 500000)) || nap_us=500000
        fi
        sleep "$((nap_us / 1000000)).$(printf '%06d' $((nap_us % 1000000)))"
    done
    # The hold it was to run in must still be there (released, or ended, while
    # it waited: review r1, sol): one probe of its id lock.
    if ! probe s "$ids/hold.$4"; then
        refuse "the hold ended while it waited for builds"
        return
    fi
    # Test hook: the window in which a timing keeper may be killed before its go.
    [[ -z "${CDO_SLOT_TEST_PAUSE_GO_S:-}" ]] || test_pause "$CDO_SLOT_TEST_PAUSE_GO_S"
    if [[ -n "$tkpid" ]] && ! go "$tid" "$ids/timed.$tid"; then
        refuse "its timing keeper ended before the timing began"
        return
    fi
    echo "cdo-slot: timed by $1 ($2)"
}

# ⟨TLS-88⟩ The waiters' queue: a waiting acquire holds a ticket, and a free slot
# goes to the oldest live ticket, so a holder that releases and acquires again
# goes behind an earlier waiter (before: whoever polled first won). A ticket is
# `$queue/<ns since epoch>.<pid>`, holding "<pid> <start time>"; one of a dead
# process (or a reused PID) is dropped by whoever reads the queue. A waiter that
# cannot run now (MemAvailable below its floor) marks its ticket `mem` and steps
# aside, so it does not hold up a waiter that can run (land acquires with no
# floor); it clears the mark when memory is back and keeps its place. The queue
# decides only the order, never whether the slot is held: a wrong order costs
# fairness, never a second holder.
queue="$dir/queue"
ticket="" ticket_mark=""
# write_ticket <mark>: (re)write our ticket whole (write, then rename: a reader
# never sees it half written).
write_ticket() {
    local tmp="$dir/ticket.$$"
    printf '%s %s %s\n' "$$" "$(proc_start $$)" "$1" >"$tmp" && mv -f "$tmp" "$ticket"
    ticket_mark=$1
}
enqueue() {
    mkdir -p "$queue"
    ticket="$queue/$(printf '%020d' "$(date +%s%N)").$$"
    write_ticket ""
}
# mark <"" | mem>: set our ticket's mark, writing it only when it changes.
mark() {
    [[ -n "$ticket" ]] || return 0
    [[ -e "$ticket" && "$1" == "$ticket_mark" ]] && return 0
    write_ticket "$1"
}
dequeue() {
    [[ -n "$ticket" ]] && rm -f "$ticket"
    ticket=""
}
# ahead: the live, unmarked tickets older than ours (every one when we hold
# none), as "<count> <oldest pid>"; drops dead tickets on the way.
ahead() {
    local t n=0 first="" pid start flag
    for t in "$queue"/*; do
        [[ -e "$t" ]] || continue
        [[ "$t" == "$ticket" ]] && break
        read -r pid start flag <"$t" 2>/dev/null || continue
        if [[ -z "$pid" ]]; then
            continue
        elif ! alive "$pid" "$start"; then
            rm -f "$t"
        elif [[ "$flag" != mem ]]; then
            ((n += 1))
            [[ -z "$first" ]] && first=$pid
        fi
    done
    echo "$n $first"
}
mem_ok() {
    ((mem_min == 0)) && return 0
    local kb
    kb=$(awk '/^MemAvailable:/ { print $2 }' /proc/meminfo)
    ((kb >= mem_min * 1048576))
}

# acquire <owner> <reason> <wait 0|1> <timeout or ""> <here 0|1>: 0 taken (in
# this process with here=1, else by a keeper: taken_holder its pid), 4 shared;
# taken_hid: the hold taken or shared.
taken_holder="" taken_hid=""
acquire() {
    local owner=$1 reason=$2 wait=$3 timeout=$4 here=$5 start=$SECONDS last=-60 why
    [[ "$owner" =~ ^[A-Za-z0-9._-]{1,40}$ ]] || die "owner '$owner': a short name (letters, digits, . _ -)"
    # No CR either: a reader that turns CR into a line break (Python's text mode)
    # would see a second status line, which a timing uses (TLS-89 review r1, sol).
    [[ -n "$reason" && "$reason" != *$'\n'* && "$reason" != *$'\r'* && ${#reason} -le 200 ]] \
        || die "give a one-line reason (at most 200 characters)"
    [[ -n "$me_session" || -n "$me_token" || -n "$bind" ]] \
        || die "outside a Claude session, bind the hold (--bind PID) or use 'run'; nobody could release it otherwise"
    mkdir -p "$dir"
    local token=${me_token:-$(new_id)} line
    if ((wait)); then
        enqueue
        trap dequeue EXIT
    fi
    while :; do
        why=""
        if [[ -n "$ticket" ]]; then
            # A ticket removed under us (by hand) is made again, at the back.
            [[ -e "$ticket" ]] || enqueue
            if mem_ok; then mark ""; else mark mem; fi
        fi
        state
        case "$st" in
            mine)
                dequeue
                taken_hid=$hid
                echo "cdo-slot: already yours ($(describe)); nothing to do"
                return 4
                ;;
            free)
                read -r -a line <<<"$(ahead)"
                if timed_now; then
                    # A timing whose hold has ended still keeps every new hold out.
                    why="free, but a timing runs: $(timed_describe)"
                elif ((line[0] > 0)); then
                    why="free, but ${line[0]} waiter(s) came first (the oldest is PID ${line[1]})"
                elif ! mem_ok; then
                    why="MemAvailable below $mem_min GB"
                elif ((here)) && take_hold "$owner" "$reason" "$token" run; then
                    dequeue
                    trap - EXIT
                    taken_holder=$$ taken_hid=$hid
                    echo "cdo-slot: taken by $owner ($reason)"
                    return 0
                elif ((!here)) && spawn_keeper hold "$owner" "$reason" "$token"; then
                    dequeue
                    trap - EXIT
                    taken_holder=$kpid taken_hid=$kid
                    echo "cdo-slot: taken by $owner ($reason)"
                    return 0
                else
                    # A keeper that ended on its own (a folder it cannot make)
                    # will not do better on the next try: say why, stop.
                    [[ "$why" != "its keeper ended"* ]] || die "not taken: $why"
                    state
                    if [[ "$st" != free ]]; then
                        why=$(describe)
                    elif timed_now; then
                        why="free, but a timing runs: $(timed_describe)"
                    else
                        why="taken by another acquirer just now"
                    fi
                fi
                ;;
            held) why=$(describe) ;;
        esac
        ((wait)) || die "not taken: $why (use --wait to wait for it)"
        # Say what it waits for first (every ~60 s), then check the limits.
        if ((SECONDS - last >= 60)); then
            echo "cdo-slot: waiting: $why"
            last=$SECONDS
        fi
        if [[ -n "$bind" ]] && ! alive "$bind" "$bind_start"; then
            die "the process to bind ($bind) ended while waiting: $why"
        fi
        if [[ -n "$timeout" ]] && ((SECONDS - start >= timeout)); then
            die "not taken after ${timeout} s: $why"
        fi
        sleep "$poll"
    done
}

release() {
    state
    case "$st" in
        free)
            echo "cdo-slot: free already"
            return
            ;;
    esac
    [[ -n "$hid" ]] || die "$(describe); it names no hold this can release"
    # Ours: our token, or our session's hold (a script of ours bound to a PID too).
    if ! { [[ -n "$me_token" && "$(field token)" == "$me_token" ]] || ((own)); }; then
        die "not yours: $(describe)"
    fi
    if [[ "$(field holder_kind)" != keeper ]]; then
        die "$(describe): taken by a run (PID $holder_pid); it ends when that run ends"
    fi
    if ! end_keeper "$ids/hold.$hid"; then
        kept_warn "$ids/hold.$hid"
        exit 1
    fi
    echo "cdo-slot: released"
}

cmd=${1:-}
[[ $# -gt 0 ]] && shift
case "$cmd" in
    _keep)
        keeper "${1:-}"
        ;;
    acquire | run)
        (($# >= 2)) || { usage >&2; exit 2; }
        owner=$1 reason=$2
        shift 2
        wait=0 timeout="" timed=0
        [[ "$cmd" == run ]] && wait=1
        while (($#)); do
            case "$1" in
                --wait) wait=1 ;;
                --timed) timed=1 ;;
                --bind)
                    [[ "${2:-}" =~ ^[1-9][0-9]*$ ]] && alive "$2" || { echo "cdo-slot: --bind needs a live PID" >&2; exit 2; }
                    bind=$2
                    bind_start=$(proc_start "$2")
                    shift
                    ;;
                --timeout)
                    [[ "${2:-}" =~ ^(0|[1-9][0-9]{0,6})$ ]] || { echo "cdo-slot: --timeout needs whole seconds" >&2; exit 2; }
                    timeout=$2
                    shift
                    ;;
                --)
                    shift
                    break
                    ;;
                *)
                    echo "cdo-slot: unknown argument: $1" >&2
                    usage >&2
                    exit 2
                    ;;
            esac
            shift
        done
        if [[ "$cmd" == acquire ]]; then
            (($# == 0)) || { echo "cdo-slot: acquire takes no command" >&2; exit 2; }
            ((!timed)) || [[ -n "$bind" ]] || { echo "cdo-slot: --timed needs --bind PID (the timing process)" >&2; exit 2; }
            rc=0
            acquire "$owner" "$reason" "$wait" "$timeout" 0 || rc=$?
            # Test hook: the window between taking the slot and the timing.
            [[ -z "${CDO_SLOT_TEST_PAUSE_ACQUIRED_S:-}" ]] \
                || test_pause "$CDO_SLOT_TEST_PAUSE_ACQUIRED_S"
            if ((timed)) && [[ "$rc" == 0 || "$rc" == 4 ]]; then
                trc=0
                timed_start "$owner" "$reason" "$bind" "$taken_hid" keeper || trc=$?
                if ((trc)); then
                    # The keeper this acquire started, exactly (none when shared).
                    [[ "$rc" != 0 ]] || end_keeper "$ids/hold.$taken_hid" \
                        || kept_warn "$ids/hold.$taken_hid"
                    exit "$trc"
                fi
            fi
            # Test hook: the window between the timing's go and the hold's.
            [[ -z "${CDO_SLOT_TEST_PAUSE_HOLDGO_S:-}" ]] \
                || test_pause "$CDO_SLOT_TEST_PAUSE_HOLDGO_S"
            if [[ "$rc" == 0 ]] && ! go "$taken_hid" "$ids/hold.$taken_hid"; then
                # Its keeper is gone or stopped: no hold, so no timing either.
                ((!timed)) || end_keeper "$ids/timed.$tid" || kept_warn "$ids/timed.$tid"
                if ! end_keeper "$ids/hold.$taken_hid"; then
                    kept_warn "$ids/hold.$taken_hid"
                    die "the hold's keeper did not take its go (ended or stopped), and it could not be ended"
                fi
                die "the hold's keeper did not take its go (ended or stopped); nothing is held"
            fi
            # After both go's, the timing must still run (its keeper may have
            # ended while the hold's go was waited for: review r8, sol).
            if ((timed)) && [[ "$rc" == 0 || "$rc" == 4 ]] && ! probe s "$ids/timed.$tid"; then
                [[ "$rc" != 0 ]] || end_keeper "$ids/hold.$taken_hid" \
                    || kept_warn "$ids/hold.$taken_hid"
                echo "cdo-slot: --timed refused: its timing ended before the timing began" >&2
                exit 6
            fi
            exit "$rc"
        fi
        (($#)) || { echo "cdo-slot: run needs -- <command>" >&2; exit 2; }
        export CDO_SLOT_TOKEN=${me_token:-$(new_id)}
        me_token=$CDO_SLOT_TOKEN
        bind=$$
        bind_start=$(proc_start "$$")
        rc=0
        acquire "$owner" "$reason" 1 "$timeout" 1 || rc=$?
        [[ "$rc" == 0 || "$rc" == 4 ]] || exit "$rc"
        if ((timed)); then
            rc=0
            timed_start "$owner" "$reason" "$$" "$taken_hid" here || rc=$?
            ((rc == 0)) || exit "$rc"
        fi
        # The command inherits this process's locks: the hold (when taken here)
        # and the timing end when the last process holding them ends.
        rc=0
        "$@" || rc=$?
        exit "$rc"
        ;;
    release)
        (($# == 0)) || { usage >&2; exit 2; }
        release
        ;;
    status)
        (($# == 0)) || { usage >&2; exit 2; }
        state
        t=0
        timed_now && t=1
        case "$st" in
            free) echo free ;;
            mine) echo "$(describe) (yours)" ;;
            held) describe ;;
        esac
        ((t)) && timed_describe
        [[ "$st" == free ]] && ((!t)) && exit 0
        exit 1
        ;;
    probe)
        (($# == 0)) || { usage >&2; exit 2; }
        state
        t=0
        timed_now && t=1
        echo "held=$([[ "$st" == free ]] && echo 0 || echo 1) own=$own timed=$t"
        [[ "$st" == free ]] || describe
        ((t)) && timed_describe
        exit 0
        ;;
    -h | --help) usage ;;
    *)
        usage >&2
        exit 2
        ;;
esac
