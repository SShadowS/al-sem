#!/usr/bin/env bash
# scripts/cdo-slot — the one CDO slot of this tentacle: who may run CDO-heavy or
# timed work (a landing, cdo-gate, a CDO measurement) right now.
#
# ⟨TLS-60⟩ Replaces hold messages: 147 of the orchestrator's 316 messages were
# about holds, and at least 9 times a lane's run had already started when the
# hold arrived. A session (or script) acquires the slot; the PreToolUse hook
# `scripts/claude-hooks/cdo-slot-guard` then refuses gates and CDO runs from
# every OTHER session until it is released, and builds and tests from EVERY
# session while the hold is timed (--timed, TLS-89).
#
#   acquire <owner> <reason> [--wait] [--timeout S] [--bind PID] [--timed]
#       Take the slot. It is taken when nobody holds the lock, MemAvailable >=
#       35 GB (CDO_SLOT_MEM_MIN_GB), and no earlier waiter that can run now is
#       waiting (see the queue below). Without --wait it refuses at once (exit 1,
#       naming the holder); with --wait it polls every 15 s, prints the holder
#       about every 60 s, and gives up after --timeout seconds (default: never)
#       or when the bound process ends. Waiters are served in arrival order
#       (TLS-88): a free slot goes to the oldest waiter still alive, and an
#       acquire without --wait refuses while anyone waits. A waiter short of
#       memory steps aside until it has it, keeping its place.
#       --bind PID: the hold ends with that process, even when it is killed
#       outright (scripts bind their own PID; `run` binds itself). Outside a
#       Claude session an acquire must be bound (or come from `run`).
#       Exit 0: taken. Exit 4: already yours, nothing to release: the holder's
#       CDO_SLOT_TOKEN is in the environment (a script's hold, shared with what
#       it starts), or this Claude session holds it unbound (by hand).
#       --timed (needs --bind; TLS-89): the hold, taken or shared, is timed
#       while the bound process lives: a timing runs in it, so no build may.
#       It marks the hold first (the guard then refuses new builds and tests),
#       then waits for the build processes already running (cargo, cargo-nextest,
#       rustc, rustdoc: CDO_SLOT_BUILD_NAMES; and scripts/ci-steps, check-goldens
#       between their cargo steps: CDO_SLOT_BUILD_SCRIPTS) outside the bound
#       process's own line, printing their PIDs every ~60 s. Still running after
#       CDO_SLOT_TIMED_WAIT_S (1800) s: exit 6, unmarked (and released, when this
#       acquire took it); never a silent start beside a build.
#   release
#       Give the slot back. Only its holder may (its session or token); a STALE
#       holder may be released by anyone.
#   status
#       `free` (exit 0), `held by ...` (exit 1) or `held by ... STALE` (exit 3).
#       A timed hold adds a second line: `timed by <owner> since <time> (<reason>)`.
#   run <owner> <reason> [--timed] -- <command...>
#       acquire --wait (bound to itself), run the command, release on any exit
#       (only when this run took the slot: inside a holder's run it just runs).
#
# Whether the slot is held is the flock on `$CDO_SLOT_DIR/lock` alone (default
# /work/.al-sem/cdo-slot); a detached holder process keeps it. The `status` file
# only describes the holder (owner, reason, start, Claude session and PID, bound
# PID, holder PID, token); it is written and removed under a second lock (`meta`)
# and only for a PID that is provably this slot's holder (its environment names
# this lock), so no race or reused PID makes it lie or kills a stranger. A hold
# is STALE when its Claude process is gone and it is bound to no live process:
# the next acquire ends it and takes over.
set -euo pipefail

usage() {
    sed -n '/^#   acquire/,/^#       (only when this run/p' "$0" | sed 's/^# \{0,1\}//'
    echo "Environment: CDO_SLOT_DIR, CDO_SLOT_MEM_MIN_GB (35), CDO_SLOT_POLL_S (15),"
    echo "CDO_SLOT_TIMED_WAIT_S (1800), CDO_SLOT_BUILD_NAMES (cargo cargo-nextest rustc rustdoc),"
    echo "CDO_SLOT_BUILD_SCRIPTS (ci-steps check-goldens)."
}
die() {
    echo "cdo-slot: $*" >&2
    exit 1
}

# One spelling of the folder (a trailing slash or a symlink must not make the
# holder check, which compares the lock's path, fail).
dir=$(realpath -m "${CDO_SLOT_DIR:-/work/.al-sem/cdo-slot}")
lock="$dir/lock"
meta="$dir/meta"
status_file="$dir/status"
mem_min="${CDO_SLOT_MEM_MIN_GB:-35}"
poll="${CDO_SLOT_POLL_S:-15}"
timed_wait="${CDO_SLOT_TIMED_WAIT_S:-1800}"
build_names="${CDO_SLOT_BUILD_NAMES:-cargo cargo-nextest rustc rustdoc}"
build_scripts="${CDO_SLOT_BUILD_SCRIPTS:-ci-steps check-goldens}"
[[ "$mem_min" =~ ^(0|[1-9][0-9]{0,5})$ ]] || die "CDO_SLOT_MEM_MIN_GB '$mem_min': whole GB, no leading zero"
[[ "$poll" =~ ^[1-9][0-9]{0,3}$ ]] || die "CDO_SLOT_POLL_S '$poll': whole seconds"
[[ "$timed_wait" =~ ^(0|[1-9][0-9]{0,6})$ ]] || die "CDO_SLOT_TIMED_WAIT_S '$timed_wait': whole seconds"
[[ "$build_names" =~ ^[A-Za-z0-9._\ -]+$ ]] || die "CDO_SLOT_BUILD_NAMES '$build_names': process names, space-separated"
# A process name (comm) holds at most 15 characters: a longer one never matches.
for n in $build_names; do
    ((${#n} <= 15)) || die "CDO_SLOT_BUILD_NAMES: '$n' is longer than a process name (15 characters)"
done
[[ "$build_scripts" =~ ^[A-Za-z0-9._\ -]+$ ]] || die "CDO_SLOT_BUILD_SCRIPTS '$build_scripts': script names, space-separated"
me_session="${CLAUDE_CODE_SESSION_ID:-}"
me_pid="${CLAUDE_PID:-}"
me_token="${CDO_SLOT_TOKEN:-}"
bind="" bind_start=""
command -v flock >/dev/null || die "flock is needed"

# field <name>: one field of the status file ("" when absent).
field() { { sed -n "s/^$1=//p" "$status_file" 2>/dev/null || true; } | head -n 1; }
# proc_fields <pid>: its /proc stat fields from the state on (state = $1,
# start time = $20); nothing when it is gone.
proc_fields() { sed 's/.*) //' "/proc/$1/stat" 2>/dev/null || true; }
# alive <pid> [start]: running (a zombie is not) and, with a start time, still
# the same process (not a reused PID).
alive() {
    [[ "${1:-}" =~ ^[1-9][0-9]*$ ]] || return 1
    local f
    read -r -a f <<<"$(proc_fields "$1")"
    [[ ${#f[@]} -gt 19 && "${f[0]}" != Z ]] || return 1
    [[ -z "${2:-}" || "${f[19]}" == "$2" ]]
}
proc_start() { local f; read -r -a f <<<"$(proc_fields "$1")"; echo "${f[19]:-}"; }
# A Claude PID counts only while it is still a claude process (PID reuse).
claude_alive() { alive "$1" && grep -q claude "/proc/$1/comm" "/proc/$1/cmdline" 2>/dev/null; }
# lock_held: somebody holds the lock (not this process: it never keeps it).
# A short wait, not -n: another prober or a starting holder has it for an
# instant. Only a timeout (exit 75) means held; any other failure of the probe
# stops with exit 5 (the hook then allows: a broken probe is no holder).
lock_held() {
    [[ -e "$lock" ]] || return 1
    local rc=0
    flock -E 75 -w 0.1 "$lock" true 2>/dev/null || rc=$?
    case "$rc" in
        0) return 1 ;;
        75) return 0 ;;
        *)
            echo "cdo-slot: cannot probe the lock $lock (flock exit $rc)" >&2
            exit 5
            ;;
    esac
}
# is_holder <pid>: that process is a holder of THIS slot (its environment says so).
is_holder() {
    alive "$1" && tr '\0' '\n' <"/proc/$1/environ" 2>/dev/null | grep -qxF "CS_LOCK=$lock"
}
# with_meta <command...>: run it under the meta lock (status changes only).
with_meta() {
    local fd
    exec {fd}>"$meta"
    flock -x "$fd"
    local rc=0
    "$@" || rc=$?
    exec {fd}>&-
    return "$rc"
}

# state: sets st to free | mine | held | stale, and holder_pid / bound.
#   mine: our token, or our Claude session holding unbound (shareable);
#   a hold of our own session that is bound to a process is NOT shareable (it
#   ends with that process): a second land of the same session waits for it.
state() {
    holder_pid="" bound=""
    if ! lock_held; then
        st=free
        return
    fi
    holder_pid=$(field holder_pid)
    if ! is_holder "$holder_pid"; then
        # Held, but its status is not written yet (or was lost): somebody's.
        holder_pid=""
        st=held
        return
    fi
    local pid session token
    pid=$(field claude_pid)
    session=$(field session)
    token=$(field token)
    bound=$(field bound)
    if [[ -n "$me_token" && "$token" == "$me_token" ]] \
        || [[ -n "$me_session" && "$session" == "$me_session" && -z "$bound" ]]; then
        st=mine
    elif [[ -n "$pid" ]] && ! claude_alive "$pid" && ! alive "$bound" "$(field bound_start)"; then
        st=stale
    else
        st=held
    fi
}
describe() {
    if [[ -z "$holder_pid" ]]; then
        # The holder truncates the lock file as it takes it: its mtime is when.
        local taken
        taken=$(stat -c %Y "$lock" 2>/dev/null || date +%s)
        if (($(date +%s) - taken < 5)); then
            echo "held (its holder is still writing its status)"
        else
            echo "held by an unknown holder (its status is gone) since $(date -u -d "@$taken" +%FT%TZ); find it with: fuser -v $lock"
        fi
        return
    fi
    local since age who
    since=$(field since)
    age=$(($(date +%s) - $(date -d "$since" +%s 2>/dev/null || date +%s)))
    who="session $(field session)"
    [[ -n "$bound" ]] && who+=", for PID $bound"
    echo "held by $(field owner) ($(field reason)) since $since ($((age / 60)) min), $who"
}

# ⟨TLS-89⟩ The timed marks: one `$dir/timed.<pid>` per timing process, key=value
# lines like the status (owner, reason, since, pid, start, holder_pid). A mark
# counts only while its process lives (pid + start time) and the hold it was set
# in is the current one (holder_pid), so a mark left by a killed run or an old
# hold says nothing. One mark per process (review r1, Fable): a second timing in
# a shared hold keeps its own cover when the first one ends.
tmark=""
tfield() { { sed -n "s/^$1=//p" "$tmark" 2>/dev/null || true; } | head -n 1; }
# timed_valid: some mark counts; sets tmark to the oldest such.
timed_valid() {
    local m
    [[ -n "$holder_pid" ]] || return 1
    for m in "$dir"/timed.*; do
        [[ -e "$m" && "$m" != *.tmp ]] || continue
        tmark=$m
        [[ "$(tfield holder_pid)" == "$holder_pid" ]] && alive "$(tfield pid)" "$(tfield start)" && return 0
    done
    tmark=""
    return 1
}
timed_describe() { echo "timed by $(tfield owner) since $(tfield since) ($(tfield reason))"; }
write_timed_locked() { # <owner> <reason> <pid>
    local tmp="$dir/timed.$3.tmp"
    {
        printf 'owner=%s\n' "$1"
        printf 'reason=%s\n' "$2"
        printf 'since=%s\n' "$(date -u +%FT%TZ)"
        printf 'pid=%s\n' "$3"
        printf 'start=%s\n' "$(proc_start "$3")"
        printf 'holder_pid=%s\n' "$holder_pid"
    } >"$tmp" && mv -f "$tmp" "$dir/timed.$3"
}
clear_timed_locked() { rm -f "$dir/timed.$1"; } # <pid>: only that process's mark
ppid_of() { local f; read -r -a f <<<"$(proc_fields "$1")"; echo "${f[1]:-}"; }
# script_builds: "PID name" of each process running a build script
# (CDO_SLOT_BUILD_SCRIPTS: ci-steps, check-goldens), read from its argv: the
# script is argv[0], or the first non-option argument of a shell or python
# argv[0]. Between their cargo steps (ci-steps' agentflow pytest, ~2 min) no
# process has a build name, so the build names alone would let a timing start
# there (review r1, Fable). Exact argv words, never a `-f` pattern.
script_builds() {
    local d a i
    for d in /proc/[0-9]*; do
        mapfile -d '' -t a 2>/dev/null <"$d/cmdline" || continue
        ((${#a[@]})) || continue
        i=0
        case "${a[0]##*/}" in
            bash | sh | dash | zsh | python | python3)
                i=1
                while ((i < ${#a[@]})) && [[ "${a[i]}" == -* ]]; do i=$((i + 1)); done
                ;;
        esac
        ((i < ${#a[@]})) || continue
        case " $build_scripts " in
            *" ${a[i]##*/} "*) echo "${d#/proc/} ${a[i]##*/}" ;;
        esac
    done
}
# foreign_builds <pid>: the running build processes (CDO_SLOT_BUILD_NAMES, matched
# by exact name with `pgrep -x`: a `-f` pattern would match this script's own
# command line; and script_builds) that are alive (not zombies) and are neither
# <pid>, its ancestors nor its descendants (a timed script's own build, or the
# cargo test that runs it); "PID name" lines.
foreign_builds() {
    local root=$1 line=" " q p name
    q=$root
    while [[ "$q" =~ ^[1-9][0-9]*$ ]]; do
        line+="$q "
        q=$(ppid_of "$q")
    done
    while read -r p name; do
        [[ -n "$p" ]] || continue
        alive "$p" || continue
        [[ "$line" == *" $p "* ]] && continue
        q=$p
        while [[ "$q" =~ ^[1-9][0-9]*$ && "$q" != 1 ]]; do
            [[ "$q" == "$root" ]] && continue 2
            q=$(ppid_of "$q")
        done
        echo "$p $name"
    done < <(
        for name in $build_names; do
            for p in $(pgrep -x -- "$name" || true); do echo "$p $name"; done
        done
        script_builds
    )
}
# timed_start <owner> <reason> <pid>: mark the current hold timed while <pid>
# lives, then wait for the build processes already running (also when another
# timing in the hold marked it first). 0: timed; 6: they still ran after
# CDO_SLOT_TIMED_WAIT_S (this mark is taken back).
timed_start() {
    state
    [[ -n "$holder_pid" && ("$st" == mine || "$st" == held) ]] || die "--timed: no hold to mark"
    with_meta write_timed_locked "$1" "$2" "$3" || die "--timed: cannot write the mark in $dir"
    local start=$SECONDS last=-60 b list
    while b=$(foreign_builds "$3") && [[ -n "$b" ]]; do
        list=$(awk '{ printf "%sPID %s (%s)", (NR > 1 ? ", " : ""), $1, $2 }' <<<"$b")
        if ((SECONDS - start >= timed_wait)); then
            with_meta clear_timed_locked "$3"
            echo "cdo-slot: --timed refused: build processes still running after ${timed_wait} s: $list" >&2
            return 6
        fi
        if ((SECONDS - last >= 60)); then
            echo "cdo-slot: timed: waiting for build processes to end: $list"
            last=$SECONDS
        fi
        sleep "$poll"
    done
    echo "cdo-slot: timed by $1 ($2)"
}
# ⟨TLS-88⟩ The waiters' queue: a waiting acquire holds a ticket, and a free slot
# goes to the oldest live ticket, so a holder that releases and acquires again
# goes behind an earlier waiter (before: whoever polled first won). A ticket is
# `$queue/<ns since epoch>.<pid>`, holding "<pid> <start time>"; one of a dead
# process (or a reused PID) is dropped by whoever reads the queue. A waiter that
# cannot run now (MemAvailable below its floor) marks its ticket `mem` and steps
# aside, so it does not hold up a waiter that can run (land acquires with no
# floor); it clears the mark when memory is back and keeps its place.
queue="$dir/queue"
ticket="" ticket_mark=""
# write_ticket <mark>: (re)write our ticket whole (write, then rename: a reader
# never sees it half written).
write_ticket() {
    local tmp="$dir/ticket.$$"
    printf '%s %s %s\n' "$$" "$(proc_start $$)" "$1" >"$tmp" && mv -f "$tmp" "$ticket"
    ticket_mark=$1
}
enqueue() {
    mkdir -p "$queue"
    ticket="$queue/$(printf '%020d' "$(date +%s%N)").$$"
    write_ticket ""
}
# mark <"" | mem>: set our ticket's mark, writing it only when it changes.
mark() {
    [[ -n "$ticket" ]] || return 0
    [[ -e "$ticket" && "$1" == "$ticket_mark" ]] && return 0
    write_ticket "$1"
}
dequeue() {
    [[ -n "$ticket" ]] && rm -f "$ticket"
    ticket=""
}
# ahead: the live, unmarked tickets older than ours (every one when we hold
# none), as "<count> <oldest pid>"; drops dead tickets on the way.
ahead() {
    local t n=0 first="" pid start flag
    for t in "$queue"/*; do
        [[ -e "$t" ]] || continue
        [[ "$t" == "$ticket" ]] && break
        read -r pid start flag <"$t" 2>/dev/null || continue
        if [[ -z "$pid" ]]; then
            continue
        elif ! alive "$pid" "$start"; then
            rm -f "$t"
        elif [[ "$flag" != mem ]]; then
            ((n += 1))
            [[ -z "$first" ]] && first=$pid
        fi
    done
    echo "$n $first"
}
mem_ok() {
    ((mem_min == 0)) && return 0
    local kb
    kb=$(awk '/^MemAvailable:/ { print $2 }' /proc/meminfo)
    ((kb >= mem_min * 1048576))
}
# end_holder <pid>: under the meta lock, and only while <pid> is still this
# slot's holder named by the status: remove the status, then end the process.
end_holder_locked() {
    is_holder "$1" || return 0
    [[ "$(field holder_pid)" == "$1" ]] && rm -f "$status_file" "$dir"/timed.*
    kill "$1" 2>/dev/null || true
}
end_holder() {
    with_meta end_holder_locked "$1"
    local n
    for n in $(seq 50); do alive "$1" || return 0; sleep 0.1; done
    is_holder "$1" && kill -9 "$1" 2>/dev/null || true
}

# try_take <owner> <reason> <token>: start a holder; 0 when it holds the lock.
try_take() {
    local ready="$dir/ready.$$" n
    rm -f "$ready"
    CS_OWNER="$1" CS_REASON="$2" CS_TOKEN="$3" CS_BIND="$bind" CS_BIND_START="$bind_start" \
        CS_SESSION="$me_session" CS_PID="$me_pid" \
        CS_LOCK="$lock" CS_META="$meta" CS_STATUS="$status_file" CS_READY="$ready" \
        setsid bash -c '
            # Keep no descriptor of the caller (a pipe it waits on, a lock).
            for fd in /proc/$$/fd/*; do
                fd=${fd##*/}
                [ "$fd" -gt 2 ] && eval "exec $fd>&-"
            done 2>/dev/null
            exec 9>"$CS_LOCK" || exit 70
            # Up to 1 s: a status probe holds the lock for an instant.
            flock -w 1 9 || exit 75
            exec 8>"$CS_META" && flock -x 8 || exit 72
            tmp="$CS_STATUS.$$"
            {
                printf "owner=%s\n" "$CS_OWNER"
                printf "reason=%s\n" "$CS_REASON"
                printf "since=%s\n" "$(date -u +%FT%TZ)"
                printf "session=%s\n" "$CS_SESSION"
                printf "claude_pid=%s\n" "$CS_PID"
                printf "bound=%s\n" "$CS_BIND"
                printf "bound_start=%s\n" "$CS_BIND_START"
                printf "holder_pid=%s\n" "$$"
                printf "token=%s\n" "$CS_TOKEN"
            } >"$tmp" && mv "$tmp" "$CS_STATUS" || exit 71
            exec 8>&-
            printf "ok\n" >"$CS_READY"
            if [ -n "$CS_BIND" ]; then
                # Bound: the hold ends with the process it was taken for, even
                # when that process is killed outright (no trap runs).
                # Running, not a zombie, and the same process (its start time).
                while f=$(sed "s/.*) //" "/proc/$CS_BIND/stat" 2>/dev/null) \
                    && set -- $f && [ "$1" != Z ] && [ "${20}" = "$CS_BIND_START" ]; do
                    sleep 2 9>&-
                done
                exec 8>"$CS_META" && flock -x 8
                grep -qx "holder_pid=$$" "$CS_STATUS" 2>/dev/null && rm -f "$CS_STATUS"
                exit 0
            fi
            exec sleep 2147483647
        ' </dev/null >/dev/null 2>&1 &
    local holder=$!
    for n in $(seq 100); do
        if [[ -s "$ready" ]]; then
            rm -f "$ready"
            return 0
        fi
        alive "$holder" || { rm -f "$ready"; return 1; }
        sleep 0.05
    done
    rm -f "$ready"
    kill "$holder" 2>/dev/null || true
    return 1
}

acquire() { # acquire <owner> <reason> <wait 0|1> <timeout or "">
    local owner=$1 reason=$2 wait=$3 timeout=$4 start=$SECONDS last=-60 why
    [[ "$owner" =~ ^[A-Za-z0-9._-]{1,40}$ ]] || die "owner '$owner': a short name (letters, digits, . _ -)"
    [[ -n "$reason" && "$reason" != *$'\n'* && ${#reason} -le 200 ]] || die "give a one-line reason (at most 200 characters)"
    [[ -n "$me_session" || -n "$me_token" || -n "$bind" ]] \
        || die "outside a Claude session, bind the hold (--bind PID) or use 'run'; nobody could release it otherwise"
    mkdir -p "$dir"
    local token=${me_token:-$(od -An -N8 -tx8 /dev/urandom | tr -d ' ')} line
    if ((wait)); then
        enqueue
        trap dequeue EXIT
    fi
    while :; do
        if [[ -n "$ticket" ]]; then
            # A ticket removed under us (by hand) is made again, at the back.
            [[ -e "$ticket" ]] || enqueue
            if mem_ok; then mark ""; else mark mem; fi
        fi
        state
        case "$st" in
            mine)
                dequeue
                echo "cdo-slot: already yours ($(describe)); nothing to do"
                return 4
                ;;
            stale)
                echo "cdo-slot: $(describe) is STALE (its Claude process is gone): ending it"
                end_holder "$holder_pid"
                continue
                ;;
            free)
                read -r -a line <<<"$(ahead)"
                if ((line[0] > 0)); then
                    why="free, but ${line[0]} waiter(s) came first (the oldest is PID ${line[1]})"
                elif ! mem_ok; then
                    why="MemAvailable below $mem_min GB"
                elif try_take "$owner" "$reason" "$token"; then
                    dequeue
                    trap - EXIT
                    echo "cdo-slot: taken by $owner ($reason)"
                    return 0
                else
                    state
                    why=$( ((${#holder_pid})) && describe || echo "taken by another acquirer just now")
                fi
                ;;
            held) why=$(describe) ;;
        esac
        ((wait)) || die "not taken: $why (use --wait to wait for it)"
        # Say what it waits for first (every ~60 s), then check the limits.
        if ((SECONDS - last >= 60)); then
            echo "cdo-slot: waiting: $why"
            last=$SECONDS
        fi
        if [[ -n "$bind" ]] && ! alive "$bind" "$bind_start"; then
            die "the process to bind ($bind) ended while waiting: $why"
        fi
        if [[ -n "$timeout" ]] && ((SECONDS - start >= timeout)); then
            die "not taken after ${timeout} s: $why"
        fi
        sleep "$poll"
    done
}

release() {
    state
    case "$st" in
        free) echo "cdo-slot: free already" ;;
        mine | stale)
            end_holder "$holder_pid"
            echo "cdo-slot: released"
            ;;
        held)
            # Our own session's bound hold (a script of ours) is ours to end too.
            if [[ -n "$holder_pid" && -n "$me_session" && "$(field session)" == "$me_session" ]]; then
                end_holder "$holder_pid"
                echo "cdo-slot: released (it was bound to PID $bound)"
            else
                die "not yours: $(describe)"
            fi
            ;;
    esac
}

cmd=${1:-}
[[ $# -gt 0 ]] && shift
case "$cmd" in
    acquire | run)
        (($# >= 2)) || { usage >&2; exit 2; }
        owner=$1 reason=$2
        shift 2
        wait=0 timeout="" timed=0
        [[ "$cmd" == run ]] && wait=1
        while (($#)); do
            case "$1" in
                --wait) wait=1 ;;
                --timed) timed=1 ;;
                --bind)
                    [[ "${2:-}" =~ ^[1-9][0-9]*$ ]] && alive "$2" || { echo "cdo-slot: --bind needs a live PID" >&2; exit 2; }
                    bind=$2
                    bind_start=$(proc_start "$2")
                    shift
                    ;;
                --timeout)
                    [[ "${2:-}" =~ ^(0|[1-9][0-9]{0,6})$ ]] || { echo "cdo-slot: --timeout needs whole seconds" >&2; exit 2; }
                    timeout=$2
                    shift
                    ;;
                --)
                    shift
                    break
                    ;;
                *)
                    echo "cdo-slot: unknown argument: $1" >&2
                    usage >&2
                    exit 2
                    ;;
            esac
            shift
        done
        if [[ "$cmd" == acquire ]]; then
            (($# == 0)) || { echo "cdo-slot: acquire takes no command" >&2; exit 2; }
            ((!timed)) || [[ -n "$bind" ]] || { echo "cdo-slot: --timed needs --bind PID (the timing process)" >&2; exit 2; }
            rc=0
            acquire "$owner" "$reason" "$wait" "$timeout" || rc=$?
            if ((timed)) && [[ "$rc" == 0 || "$rc" == 4 ]]; then
                trc=0
                timed_start "$owner" "$reason" "$bind" || trc=$?
                if ((trc)); then
                    # This acquire took it: end it here (`release` would refuse a
                    # hold that has only --bind, no session or token: review r1).
                    if [[ "$rc" == 0 ]]; then
                        state
                        [[ -z "$holder_pid" ]] || end_holder "$holder_pid"
                    fi
                    exit "$trc"
                fi
            fi
            exit "$rc"
        fi
        (($#)) || { echo "cdo-slot: run needs -- <command>" >&2; exit 2; }
        export CDO_SLOT_TOKEN=${me_token:-$(od -An -N8 -tx8 /dev/urandom | tr -d ' ')}
        me_token=$CDO_SLOT_TOKEN
        bind=$$
        bind_start=$(proc_start "$$")
        rc=0
        acquire "$owner" "$reason" 1 "$timeout" || rc=$?
        case "$rc" in
            0) trap 'release >/dev/null' EXIT && trap 'exit 130' INT TERM ;;
            # A shared hold outlives this run: take back only our timed mark.
            4) ((!timed)) || { trap 'with_meta clear_timed_locked $$' EXIT && trap 'exit 130' INT TERM; } ;;
            *) exit "$rc" ;;
        esac
        if ((timed)); then
            rc=0
            timed_start "$owner" "$reason" "$$" || rc=$?
            ((rc == 0)) || exit "$rc"
        fi
        rc=0
        "$@" || rc=$?
        exit "$rc"
        ;;
    release)
        (($# == 0)) || { usage >&2; exit 2; }
        release
        ;;
    status)
        (($# == 0)) || { usage >&2; exit 2; }
        state
        case "$st" in
            free) echo free ;;
            mine)
                echo "$(describe) (yours)"
                ! timed_valid || timed_describe
                exit 1
                ;;
            held)
                describe
                ! timed_valid || timed_describe
                exit 1
                ;;
            stale)
                echo "$(describe) STALE"
                exit 3
                ;;
        esac
        ;;
    -h | --help) usage ;;
    *)
        usage >&2
        exit 2
        ;;
esac
